<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <record id="module_category_realestate_sales" model="ir.module.category">
        <field name="name">Real Estate Sales</field>
        <field name="sequence">21</field>
    </record>

    <record id="group_realestate_sales_readonly" model="res.groups">
        <field name="name">Read-only</field>
        <field name="category_id" ref="module_category_realestate_sales"/>
    </record>

    <record id="group_realestate_sales_agent" model="res.groups">
        <field name="name">Agent</field>
        <field name="category_id" ref="module_category_realestate_sales"/>
        <field name="implied_ids" eval="[(4, ref('group_realestate_sales_readonly'))]"/>
    </record>

    <record id="group_realestate_sales_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_realestate_sales"/>
        <field name="implied_ids" eval="[(4, ref('group_realestate_sales_agent'))]"/>
    </record>

</odoo>
