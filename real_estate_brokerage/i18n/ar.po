msgstr "%s في حالة %s ولا يمكن فوترتها."

#. module: real_estate_brokerage
#. odoo-python
#: code:addons/real_estate_brokerage/models/commission_v2.py:0
msgid "%s is a fixed commission of nothing."
msgstr "%s عمولة ثابتة بقيمة صفر."

#. module: real_estate_brokerage
#. odoo-python
#: code:addons/real_estate_brokerage/models/commission_v2.py:0
