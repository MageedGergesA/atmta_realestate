#: code:addons/real_estate_brokerage/models/commission_migration.py:0
msgid "%(old)s%% of sale ÷ %(rate)s%% gross × 100 = %(new)s%% of gross."
msgstr "%(old)s%% من البيع ÷ %(rate)s%% إجمالي × 100 = %(new)s%% من الإجمالي."

#. module: real_estate_brokerage
#. odoo-python
#: code:addons/real_estate_brokerage/models/commission_migration.py:0
msgid ""
"%(old)s%% of the sale against a %(rate)s%% agency fee converts to %(new)s%% "
"of the gross — more than the whole fee. The legacy pair cannot both be "
"right."
msgstr ""
"نسبة %(old)s%% من البيع مقابل أتعاب وكالة بنسبة %(rate)s%% تعادل %(new)s%% "
"من الإجمالي — أي أكثر من كامل الأتعاب. لا يمكن أن تكون القيمتان القديمتان "
"صحيحتين معًا."

#. module: real_estate_brokerage
#. odoo-python
