msgstr "إنهاء هذه الاتفاقية؟"

#. module: real_estate_brokerage
#: model:ir.model.fields.selection,name:real_estate_brokerage.selection__realestate_broker_agreement__state__terminated
#: model:ir.model.fields.selection,name:real_estate_brokerage.selection__realestate_listing_mandate__state__terminated
