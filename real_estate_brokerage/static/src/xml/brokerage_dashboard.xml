<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Brokerage Overview. Same layout, same components and the same
         reading order as the Rental Overview: KPIs, then why, then what is
         wrong, then what I do about it, then the detail. -->
    <t t-name="real_estate_brokerage.BrokerageDashboard">
        <div class="o_ad_dashboard o_re_dashboard o_action">
            <div class="o_ad_scroll">

                <header class="o_ad_header">
                    <div>
                        <h1 class="o_ad_title">Brokerage</h1>
                        <p class="o_ad_subtitle" t-if="isReady">
                            <span t-esc="data.company_name"/>
                            <span class="o_ad_sep" aria-hidden="true">·</span>
                            <span class="o_ad_asof">
                                <i class="fa fa-calendar-o" aria-hidden="true"/>
                                <span>As of <t t-esc="data.as_of"/></span>
                            </span>
                            <t t-if="lastUpdatedLabel">
                                <span class="o_ad_sep" aria-hidden="true">·</span>
                                <span t-esc="lastUpdatedLabel"/>
                            </t>
                        </p>
                    </div>
                    <div class="o_ad_header_actions">
                        <t t-foreach="data.quick_actions or []" t-as="quick" t-key="quick.key">
                            <button class="btn btn-sm"
                                    t-att-class="quick_first ? 'btn-primary' : 'btn-secondary'"
                                    t-on-click="() => this.runQuickAction(quick.key)">
                                <i t-attf-class="fa {{ quick.icon }} me-1" aria-hidden="true"/>
                                <span t-esc="quick.label"/>
                            </button>
                        </t>
                        <button class="btn btn-sm btn-secondary" t-on-click="onRefresh"
                                t-att-disabled="state.refreshing" aria-label="Refresh the dashboard">
                            <i class="fa fa-refresh" t-att-class="{ 'fa-spin': state.refreshing }"
                               aria-hidden="true"/>
                            <span class="d-none d-md-inline ms-1">Refresh</span>
                        </button>
                    </div>
                </header>

                <AtmtaFilterBar t-if="isReady and (data.filters or []).length"
                                filters="data.filters" values="state.filters"
                                onChange="(key, value) => this.setFilter(key, value)"
                                onReset="() => this.resetFilters()"/>

                <AtmtaSkeleton t-if="isLoading" kpis="6" panels="3"/>

                <div t-elif="isError" class="o_ad_state" role="alert">
                    <i class="fa fa-exclamation-circle o_ad_state_icon" aria-hidden="true"/>
                    <h2 class="o_ad_state_title">The dashboard could not be loaded</h2>
                    <p class="o_ad_state_text" t-esc="state.errorMessage"/>
                    <button class="btn btn-primary" t-on-click="onRefresh">Retry</button>
                </div>

                <t t-else="">
                    <div class="o_ad_kpi_grid o_ad_section">
                        <AtmtaKpiCard t-foreach="data.kpis or []" t-as="tile" t-key="tile.key"
                                      tile="tile" currencyId="currencyId"
                                      onDrill="(key) => this.drill(key)"/>
                    </div>

                    <div class="o_ad_grid o_ad_section">
                        <AtmtaCard className="'o_ad_col_3'" title="'Listing Status'"
                                   icon="'fa-building-o'">
                            <AtmtaDonut segments="listingStatus.segments"
                                        total="listingStatus.total"
                                        totalLabel="listingStatus.total_label"
                                        onSegment="(key) => this.drill(key)"/>
                        </AtmtaCard>

                        <!-- The funnel is absent, not empty, for a reader who
                             may not see crm.lead. "Not yours to see" and
                             "there is nothing here" are different answers. -->
                        <AtmtaCard t-if="funnel" className="'o_ad_col_3'"
                                   title="'Opportunity Funnel'" icon="'fa-filter'">
                            <AtmtaDonut segments="funnel.segments"
                                        total="funnel.total"
                                        totalLabel="funnel.total_label"
                                        onSegment="(key) => this.drill(key)"/>
                        </AtmtaCard>

                        <AtmtaDashboardChart t-if="velocityChart" chart="velocityChart"
                                             currencyId="currencyId"/>
                        <AtmtaCard t-else="" className="'o_ad_col_6'"
                                   title="'Sales Velocity'" icon="'fa-line-chart'">
                            <AtmtaRowList rows="[]"
                                          emptyText="'No deal has closed in the last six months.'"/>
                        </AtmtaCard>
                    </div>

                    <div class="o_ad_grid o_ad_section">
                        <AtmtaCard className="'o_ad_col_6'" title="'Attention Required'"
                                   icon="'fa-exclamation-triangle'">
                            <AtmtaRowList rows="data.alerts or []"
                                          onRow="(key) => this.drill(key)"
                                          emptyText="'Nothing needs your attention.'"/>
                        </AtmtaCard>
                        <AtmtaCard className="'o_ad_col_6'" title="'My Work'"
                                   icon="'fa-check-square-o'">
                            <AtmtaRowList rows="data.work_queue or []"
                                          onRow="(key) => this.drill(key)"
                                          emptyText="'Your queue is clear.'"/>
                        </AtmtaCard>
                    </div>

                    <div class="o_ad_grid o_ad_section">
                        <AtmtaCard className="'o_ad_col_5'" title="'Top Agents'"
                                   icon="'fa-trophy'"
                                   subtitle="'By commission actually paid, last twelve months'">
                            <AtmtaDataTable columns="agentColumns" rows="data.top_agents or []"
                                            currencyId="currencyId"
                                            emptyText="'No commission has been paid yet.'"/>
                        </AtmtaCard>
                        <AtmtaCard className="'o_ad_col_7'" title="'On the Market'"
                                   icon="'fa-clock-o'"
                                   subtitle="'Oldest first. Over ninety days is where a price review belongs'">
                            <AtmtaDataTable columns="listingColumns"
                                            rows="data.listings_table or []"
                                            currencyId="currencyId"
                                            onRow="(row) => this.openListing(row)"
                                            emptyText="'Nothing is on the market.'"/>
                        </AtmtaCard>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
