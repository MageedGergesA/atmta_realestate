<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_lead_search" model="ir.ui.view">
        <field name="name">realestate.lead.search</field>
        <field name="model">realestate.lead</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="agent_id"/>
                <filter name="my_leads" string="My Leads" domain="[('agent_id', '=', uid)]"/>
                <separator/>
                <filter name="open" string="Open"
                        domain="[('state', 'not in', ('converted','lost'))]"/>
                <filter name="lost" string="Lost" domain="[('state', '=', 'lost')]"/>
                <filter name="converted" string="Converted" domain="[('state', '=', 'converted')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_agent" string="Agent" context="{'group_by': 'agent_id'}"/>
                    <filter name="group_source" string="Source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_lead_kanban" model="ir.ui.view">
        <field name="name">realestate.lead.kanban</field>
        <field name="model">realestate.lead</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="agent_id"/>
                <field name="budget_min"/>
                <field name="budget_max"/>
                <field name="priority"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card" class="oe_kanban_card p-2">
                        <div class="d-flex justify-content-between align-items-start">
                            <strong><field name="partner_id"/></strong>
                            <field name="priority" widget="priority"/>
                        </div>
                        <div class="small text-muted"><field name="name"/></div>
                        <div class="mt-1 small">
                            <t t-if="record.budget_max.raw_value">
                                <i class="fa fa-tag me-1"/>
                                <field name="budget_max" widget="monetary"/>
                            </t>
                        </div>
                        <div class="mt-2">
                            <field name="agent_id" widget="many2one_avatar_user"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_lead_list" model="ir.ui.view">
        <field name="name">realestate.lead.list</field>
        <field name="model">realestate.lead</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="phone" optional="show"/>
                <field name="source"/>
                <field name="agent_id"/>
                <field name="budget_max" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="priority" widget="priority"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_lead_form" model="ir.ui.view">
        <field name="name">realestate.lead.form</field>
        <field name="model">realestate.lead</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_qualify" type="object" string="Qualify" class="oe_highlight"
                            invisible="state != 'new'"/>
                    <button name="action_match" type="object" string="Find Matches"
                            invisible="state in ('lost','converted')"/>
                    <button name="action_schedule_viewing" type="object" string="Schedule Viewing"
                            invisible="state in ('lost','converted','new')"/>
                    <button name="action_mark_lost" type="object" string="Mark Lost"
                            invisible="state in ('lost','converted')"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state != 'lost'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,qualified,matched,viewing_scheduled,offer,converted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Contact">
                            <field name="partner_id" options="{'no_create_edit': False}"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="source"/>
                            <field name="agent_id" options="{'no_create': True}"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group string="Budget &amp; Size">
                            <label for="budget_min" string="Budget"/>
                            <div class="o_row">
                                <field name="budget_min"/>
                                <span>—</span>
                                <field name="budget_max"/>
                                <field name="currency_id" groups="base.group_multi_currency"/>
                            </div>
                            <label for="area_min" string="Area (sqm)"/>
                            <div class="o_row">
                                <field name="area_min"/>
                                <span>—</span>
                                <field name="area_max"/>
                            </div>
                            <field name="bedroom_count_min"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Preferences" name="prefs">
                            <group>
                                <group>
                                    <field name="property_type_ids" widget="many2many_tags"/>
                                    <field name="preferred_country_id" options="{'no_create': True}"/>
                                    <field name="preferred_state_id" options="{'no_create': True}"/>
                                </group>
                                <group>
                                    <field name="preferred_city"/>
                                    <field name="preferred_district"/>
                                </group>
                            </group>
                        </page>
                        <page string="Matched Listings" name="matches">
                            <field name="matched_listing_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="property_id"/>
                                    <field name="list_price"/>
                                    <field name="state" widget="badge"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Viewings" name="viewings">
                            <field name="viewing_ids" readonly="1">
                                <list>
                                    <field name="scheduled_at"/>
                                    <field name="listing_id"/>
                                    <field name="agent_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Offers" name="offers">
                            <field name="offer_ids" readonly="1">
                                <list>
                                    <field name="offer_date"/>
                                    <field name="listing_id"/>
                                    <field name="amount"/>
                                    <field name="state" widget="badge"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Loss Detail" name="loss" invisible="state != 'lost'">
                            <group>
                                <field name="loss_reason_id"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_realestate_lead" model="ir.actions.act_window">
        <field name="name">Leads</field>
        <field name="res_model">realestate.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_lead_search"/>
        <field name="context">{'search_default_open': 1}</field>
    </record>

</odoo>
