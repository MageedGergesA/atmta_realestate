<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_offer_list" model="ir.ui.view">
        <field name="name">realestate.offer.list</field>
        <field name="model">realestate.offer</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'accepted'"
                  decoration-muted="state in ('rejected','withdrawn','expired')">
                <field name="name"/>
                <field name="listing_id"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="offer_date"/>
                <field name="expiry_date" optional="show"/>
                <field name="agent_id" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_offer_form" model="ir.ui.view">
        <field name="name">realestate.offer.form</field>
        <field name="model">realestate.offer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_accept" type="object" string="Accept" class="oe_highlight"
                            invisible="state not in ('submitted','countered')"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('submitted','countered')"/>
                    <button name="action_withdraw" type="object" string="Withdraw"
                            invisible="state not in ('submitted','countered')"/>
                    <button name="action_create_transaction" type="object" string="Create Transaction"
                            class="oe_highlight" invisible="state != 'accepted'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="listing_id" options="{'no_create': True}"/>
                            <field name="property_id" readonly="1"/>
                            <field name="lead_id" options="{'no_create': True}"/>
                            <field name="partner_id"/>
                            <field name="agent_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <label for="amount"/>
                            <div class="o_row">
                                <field name="amount"/>
                                <field name="currency_id" groups="base.group_multi_currency"/>
                            </div>
                            <field name="listing_list_price" widget="monetary"/>
                            <field name="offer_vs_list" widget="percentage"
                                   decoration-success="offer_vs_list &gt;= 1.0"
                                   decoration-warning="offer_vs_list &gt;= 0.9 and offer_vs_list &lt; 1.0"
                                   decoration-danger="offer_vs_list &lt; 0.9 and offer_vs_list &gt; 0"/>
                            <field name="listing_base_price" widget="monetary"/>
                            <field name="offer_vs_base" widget="percentage"
                                   decoration-success="offer_vs_base &gt;= 0"
                                   decoration-warning="offer_vs_base &gt;= -0.1 and offer_vs_base &lt; 0"
                                   decoration-danger="offer_vs_base &lt; -0.1"/>
                            <field name="offer_date"/>
                            <field name="expiry_date"/>
                            <field name="deposit_amount"/>
                            <field name="proposed_closing_date"/>
                        </group>
                    </group>
                    <group string="Conditions">
                        <field name="conditions" nolabel="1"/>
                    </group>
                    <group string="Rejection" invisible="state != 'rejected'">
                        <field name="rejection_reason"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_realestate_offer" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">realestate.offer</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
