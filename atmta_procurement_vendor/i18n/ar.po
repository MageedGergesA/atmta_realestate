#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_eligibility.py:0
msgid ""
"%(body)s\n"
"(Recorded on behalf of %(user)s.)"
msgstr ""
"%(body)s\n"
"(سُجل نيابة عن %(user)s.)"

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_qualification.py:0
msgid ""
"%(name)s belongs to a decided assessment. Reassess %(qual)s to record new "
"evidence."
msgstr ""
"%(name)s يتبع تقييمًا تم البت فيه. أعد تقييم %(qual)s لتسجيل أدلة جديدة."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/qualification_template.py:0
msgid ""
"%(name)s has been used for %(count)s assessment(s), so changing what it asks"
" would change what those assessments meant. Use New Version — the existing "
"ones keep pointing at this one."
msgstr ""
"تم استخدام %(name)s في %(count)s تقييم، لذا فإن تغيير ما يسأل عنه سيغير معنى"
" تلك التقييمات. استخدم نسخة جديدة — تبقى التقييمات الحالية مرتبطة بهذه "
"النسخة."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_qualification.py:0
msgid "%(name)s is %(state)s, so it cannot be %(action)s."
msgstr "%(name)s في حالة %(state)s، لذا لا يمكن %(action)s."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_qualification.py:0
msgid ""
"%(name)s was decided on %(date)s. %(fields)s cannot be changed now — "
"reassess it instead, and both records stay readable."
msgstr ""
"تم البت في %(name)s بتاريخ %(date)s. لا يمكن تغيير %(fields)s الآن — أعد "
"التقييم بدلًا من ذلك، ويبقى السجلان قابلين للاطلاع."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_eligibility.py:0
msgid "%(name)s: %(type)s in force since %(date)s — %(reason)s"
msgstr "%(name)s: %(type)s ساري منذ %(date)s — %(reason)s"

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_qualification.py:0
msgid ""
"%(project)s belongs to %(other)s, so %(company)s cannot endorse a vendor on "
"it."
msgstr ""
"%(project)s يتبع %(other)s، لذا لا يمكن لـ %(company)s اعتماد مورد عليه."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_qualification.py:0
msgid "%(template)s belongs to %(other)s."
msgstr "%(template)s يتبع %(other)s."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_restriction.py:0
msgid "%(type)s in force from %(date)s. Reason: %(reason)s"
msgstr "%(type)s ساري من %(date)s. السبب: %(reason)s"

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_eligibility.py:0
msgid "%(type)s recorded: %(reason)s"
msgstr "تم تسجيل %(type)s: %(reason)s"

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_qualification.py:0
msgid ""
"%(user)s assessed %(name)s, so somebody else has to approve it. Turn that "
"off on the company if this organisation genuinely wants one person to do "
"both."
msgstr ""
"قام %(user)s بتقييم %(name)s، لذا يجب أن يعتمده شخص آخر. عطّل هذا الخيار في "
"الشركة إذا كانت المنظمة تريد فعلًا أن يقوم شخص واحد بالأمرين."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_eligibility.py:0
msgid "%(vendor)s has no qualification for %(trade)s."
msgstr "لا يوجد لدى %(vendor)s تأهيل في %(trade)s."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_eligibility.py:0
msgid "%(vendor)s was assessed for %(trade)s and not qualified."
msgstr "تم تقييم %(vendor)s في %(trade)s ولم يتأهل."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_eligibility.py:0
msgid "%(vendor)s's assessment for %(trade)s is waiting on information."
msgstr "تقييم %(vendor)s في %(trade)s بانتظار معلومات."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_eligibility.py:0
msgid "%(vendor)s's qualification for %(trade)s expired on %(date)s."
msgstr "انتهى تأهيل %(vendor)s في %(trade)s بتاريخ %(date)s."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/qualification_template.py:0
msgid "%s already has a later version (%s)."
msgstr "يوجد لـ %s نسخة أحدث (%s)."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/qualification_template.py:0
msgid ""
"%s asks nothing. Activate it once it has at least one requirement, or leave "
"it in draft."
msgstr ""
"%s لا يتضمن أي سؤال. فعّله عندما يحتوي على متطلب واحد على الأقل، أو اتركه "
"مسودة."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/qualification_template.py:0
msgid ""
"%s has assessments behind it. Archive it instead — deleting it would leave "
"them describing a questionnaire that no longer exists."
msgstr ""
"توجد تقييمات مرتبطة بـ %s. أرشفه بدلًا من ذلك — حذفه سيجعلها تصف استبيانًا "
"لم يعد موجودًا."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_restriction.py:0
msgid ""
"%s has been in force. Lift it rather than deleting it — an audit that cannot"
" see a past suspension cannot explain the sourcing that happened around it."
msgstr ""
"كان %s ساريًا. ارفعه بدلًا من حذفه — التدقيق الذي لا يرى إيقافًا سابقًا لا "
"يمكنه تفسير عمليات الطرح التي جرت حوله."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_profile.py:0
msgid ""
"%s is %s. Lift the restriction that put it there rather than overwriting the"
" status — otherwise the reason disappears."
msgstr ""
"%s في حالة %s. ارفع القيد الذي أدى إلى ذلك بدلًا من استبدال الحالة — وإلا "
"سيختفي السبب."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_qualification.py:0
msgid ""
"%s is a governance decision with a date on it. Cancel or supersede it — "
"deleting it would make the sourcing it authorised unexplainable."
msgstr ""
"%s قرار حوكمة مؤرخ. ألغه أو استبدله — حذفه سيجعل عمليات الطرح التي أجازها "
"غير قابلة للتفسير."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_restriction.py:0
msgid "%s is already %s."
msgstr "%s في حالة %s بالفعل."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_eligibility.py:0
msgid "%s is marked inactive with %s."
msgstr "%s مصنف كغير نشط بسبب %s."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_eligibility.py:0
msgid "%s is not eligible."
msgstr "%s غير مؤهل."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_profile.py:0
msgid "%s is not in draft."
msgstr "%s ليس في حالة مسودة."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_restriction.py:0
msgid "%s is not in force."
msgstr "%s غير ساري."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_eligibility.py:0
msgid "%s needs this project's own endorsement, which it does not have."
msgstr "%s يحتاج إلى اعتماد خاص بهذا المشروع، وهو غير متوفر."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_restriction.py:0
msgid "%s would end before it started."
msgstr "%s سينتهي قبل أن يبدأ."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/qualification_template.py:0
msgid ""
"'%(name)s' belongs to %(template)s, which has been used for assessments. It "
"cannot be %(verb)s — take a new version of the template instead."
msgstr ""
"'%(name)s' يتبع %(template)s الذي استُخدم في تقييمات. لا يمكن %(verb)s — "
"أنشئ نسخة جديدة من القالب بدلًا من ذلك."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/qualification_template.py:0
msgid "'%s' is a selection with nothing to select."
msgstr "'%s' حقل اختيار بلا خيارات."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/qualification_template.py:0
msgid ""
"'%s' is informational, so it has no pass or fail to block on. Make it "
"mandatory or scored first."
msgstr ""
"'%s' معلوماتي، لذا لا يوجد نجاح أو رسوب يمكن الإيقاف بناءً عليه. اجعله "
"إلزاميًا أو بدرجات أولًا."

#. module: atmta_procurement_vendor
#: model_terms:ir.ui.view,arch_db:atmta_procurement_vendor.view_partner_procurement_governance
msgid "<span class=\"o_stat_text\">Qualifications</span>"
msgstr "<span class=\"o_stat_text\">التأهيلات</span>"

#. module: atmta_procurement_vendor
#: model_terms:ir.ui.view,arch_db:atmta_procurement_vendor.view_qualification_template_form
msgid "<span class=\"oe_inline\"> — version </span>"
msgstr "<span class=\"oe_inline\"> — النسخة </span>"

#. module: atmta_procurement_vendor
#: model_terms:ir.ui.view,arch_db:atmta_procurement_vendor.view_qualification_template_form
msgid ""
"<strong>Mandatory</strong> must be answered and passed.\n"
"                                <strong>Blocking</strong> ends the assessment as Not Qualified\n"
"                                whatever the score says — insurance and manufacturer authorisation\n"
"                                are the usual cases."
msgstr ""
"<strong>الإلزامي</strong> يجب الإجابة عليه واجتيازه. <strong>المانع</strong>"
" ينهي التقييم بنتيجة غير مؤهل أيًا كانت الدرجة — التأمين وتفويض الشركة "
"المصنعة هما الحالتان المعتادتان."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_qualification.py:0
msgid "A decided assessment keeps its evidence."
msgstr "التقييم الذي تم البت فيه يحتفظ بأدلته."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_eligibility.py:0
msgid "A mandatory document behind %s's qualification has expired."
msgstr "انتهت صلاحية مستند إلزامي يستند إليه تأهيل %s."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_qualification.py:0
msgid ""
"A maximum award value of zero would mean the vendor is qualified for "
"nothing. Say Not Qualified instead."
msgstr ""
"الحد الأقصى لقيمة الترسية بصفر يعني أن المورد غير مؤهل لأي شيء. اختر غير "
"مؤهل بدلًا من ذلك."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/qualification_template.py:0
msgid "A minimum score is a percentage between 0 and 100."
msgstr "الحد الأدنى للدرجة نسبة مئوية بين 0 و100."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_restriction.py:0
msgid "A project restriction has to name the project."
msgstr "قيد المشروع يجب أن يحدد المشروع."

#. module: atmta_procurement_vendor
#: model:ir.model.fields,help:atmta_procurement_vendor.field_realestate_procurement_vendor_qualification__is_endorsement
msgid ""
"A project-scoped qualification. It narrows; it never replaces the general "
"one."
msgstr "تأهيل خاص بمشروع. يضيّق النطاق؛ ولا يحل محل التأهيل العام أبدًا."

#. module: atmta_procurement_vendor
#: model:ir.model.constraint,message:atmta_procurement_vendor.constraint_realestate_procurement_vendor_qualification_effective_before_expiry
msgid "A qualification cannot expire before it becomes effective."
msgstr "لا يمكن أن ينتهي التأهيل قبل أن يصبح ساريًا."

#. module: atmta_procurement_vendor
#: model_terms:ir.ui.view,arch_db:atmta_procurement_vendor.view_vendor_category_form
msgid ""
"A requisition line for a product in these categories proposes this trade.\n"
"                            The buyer may change it — the product tree says what the item is, not\n"
"                            what a supplier is capable of."
msgstr ""
"بند طلب الشراء لمنتج ضمن هذه الفئات يقترح هذا التخصص. يمكن لمسؤول الشراء "
"تغييره — شجرة المنتجات تصف ماهية الصنف، لا ما يقدر عليه المورد."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/wizard/vendor_governance_wizards.py:0
msgid ""
"A second current assessment for the same vendor, trade and project as %s."
msgstr "تقييم ساري ثانٍ لنفس المورد والتخصص والمشروع مثل %s."

#. module: atmta_procurement_vendor
#: model:ir.model.constraint,message:atmta_procurement_vendor.constraint_realestate_procurement_qualification_template_code_version_uniq
msgid "A template code and version must be unique within the company."
msgstr "يجب أن يكون رمز القالب ونسخته فريدين داخل الشركة."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_category.py:0
msgid "A trade cannot contain itself."
msgstr "لا يمكن أن يحتوي التخصص على نفسه."

#. module: atmta_procurement_vendor
#: model:ir.model.constraint,message:atmta_procurement_vendor.constraint_realestate_procurement_vendor_category_code_company_uniq
msgid "A trade code must be unique within its company."
msgstr "يجب أن يكون رمز التخصص فريدًا داخل شركته."

#. module: atmta_procurement_vendor
#. odoo-python
#: code:addons/atmta_procurement_vendor/models/vendor_restriction.py:0
msgid ""
"A trade restriction has to name the trade. Leave it empty and it silently "
"restricts everything."
msgstr "قيد التخصص يجب أن يحدد التخصص. تركه فارغًا يقيّد كل شيء دون تنبيه."

#. module: atmta_procurement_vendor
#: model:ir.model.constraint,message:atmta_procurement_vendor.constraint_realestate_procurement_vendor_profile_partner_company_uniq
msgid "A vendor has one governance profile per company."
msgstr "للمورد ملف حوكمة واحد لكل شركة."

#. module: atmta_procurement_vendor
#: model:ir.model.fields,field_description:atmta_procurement_vendor.field_realestate_procurement_vendor_profile__message_needaction
#: model:ir.model.fields,field_description:atmta_procurement_vendor.field_realestate_procurement_vendor_qualification__message_needaction
#: model:ir.model.fields,field_description:atmta_procurement_vendor.field_realestate_procurement_vendor_restriction__message_needaction
msgid "Action Needed"
msgstr "إجراء مطلوب"

#. module: atmta_procurement_vendor
#: model:ir.model.fields,field_description:atmta_procurement_vendor.field_realestate_procurement_qualification_condition__action_required
msgid "Action Required"
msgstr "إجراء مطلوب"

#. module: atmta_procurement_vendor
#: model:ir.model.fields.selection,name:atmta_procurement_vendor.selection__realestate_procurement_qualification_condition__condition_type__pre_award_action
msgid "Action Required Before Award"
msgstr "إجراء مطلوب قبل الترسية"

#. module: atmta_procurement_vendor
#: model_terms:ir.ui.view,arch_db:atmta_procurement_vendor.view_qualification_template_form
#: model_terms:ir.ui.view,arch_db:atmta_procurement_vendor.view_vendor_profile_form
msgid "Activate"
msgstr "تفعيل"

#. module: atmta_procurement_vendor
#: model:ir.model.fields,field_description:atmta_procurement_vendor.field_realestate_procurement_qualification_area__active
#: model:ir.model.fields,field_description:atmta_procurement_vendor.field_realestate_procurement_qualification_template__active
#: model:ir.model.fields,field_description:atmta_procurement_vendor.field_realestate_procurement_vendor_category__active
#: model:ir.model.fields,field_description:atmta_procurement_vendor.field_realestate_procurement_vendor_profile__active
#: model:ir.model.fields.selection,name:atmta_procurement_vendor.selection__realestate_procurement_qualification_template__state__active
#: model:ir.model.fields.selection,name:atmta_procurement_vendor.selection__realestate_procurement_vendor_profile__governance_status__active
#: model:ir.model.fields.selection,name:atmta_procurement_vendor.selection__realestate_procurement_vendor_restriction__state__active
#: model_terms:ir.ui.view,arch_db:atmta_procurement_vendor.view_vendor_profile_search
msgid "Active"
msgstr "نشط"

#. module: atmta_procurement_vendor
#: model:ir.model.fields,field_description:atmta_procurement_vendor.field_realestate_procurement_vendor_profile__active_restriction_ids
msgid "Active Restrictions"
msgstr "القيود السارية"

#. module: atmta_procurement_vendor
#: model:ir.model.fields,help:atmta_procurement_vendor.field_realestate_procurement_vendor_restriction__is_in_force
msgid "Active and inside its dates, as of today."
msgstr "نشط وضمن تواريخه، حتى اليوم."

#. module: atmta_procurement_vendor
#: model:ir.model.fields,field_description:atmta_procurement_vendor.field_realestate_procurement_vendor_qualification__activity_ids
msgid "Activities"
msgstr "الأنشطة"

#. module: atmta_procurement_vendor
#: model:ir.model.fields,field_description:atmta_procurement_vendor.field_realestate_procurement_vendor_qualification__activity_exception_decoration
msgid "Activity Exception Decoration"
msgstr "زخرفة استثناء النشاط"

#. module: atmta_procurement_vendor
#: model:ir.model.fields,field_description:atmta_procurement_vendor.field_realestate_procurement_vendor_qualification__activity_state
msgid "Activity State"
msgstr "حالة النشاط"

#. module: atmta_procurement_vendor
#: model:ir.model.fields,field_description:atmta_procurement_vendor.field_realestate_procurement_vendor_qualification__activity_type_icon
msgid "Activity Type Icon"
msgstr "أيقونة نوع النشاط"

#. module: atmta_procurement_vendor
#: model:ir.model.constraint,message:atmta_procurement_vendor.constraint_realestate_procurement_qualification_area_code_company_uniq
msgid "An area code must be unique within its company."
msgstr "يجب أن يكون رمز المنطقة فريدًا داخل شركته."

#. module: atmta_procurement_vendor
#: model:ir.model.fields,field_description:atmta_procurement_vendor.field_realestate_procurement_qualification_requirement__requirement_type
#: model:ir.model.fields,field_description:atmta_procurement_vendor.field_realestate_procurement_qualification_response__requirement_type
msgid "Answer Type"
msgstr "نوع الإجابة"

#. module: atmta_procurement_vendor
#: model:ir.model.fields,help:atmta_procurement_vendor.field_realestate_procurement_qualification_area__confidential
msgid ""
"Answers and documents under this heading are restricted to assessors, "
"approvers and managers. Financial statements and reference checks are the "
"usual reasons."
msgstr ""
"الإجابات والمستندات تحت هذا البند مقصورة على المقيّمين والمعتمدين والمديرين."
" القوائم المالية والتحقق من المراجع هي الأسباب المعتادة."

#. module: atmta_procurement_vendor
#: model:ir.model.fields,field_description:atmta_procurement_vendor.field_realestate_procurement_qualification_area__category_ids
msgid "Applies To Trades"
msgstr "ينطبق على التخصصات"

#. module: atmta_procurement_vendor
#: model_terms:ir.ui.view,arch_db:atmta_procurement_vendor.view_vendor_qualification_form
msgid "Approve"
msgstr "اعتماد"

#. module: atmta_procurement_vendor
#: model:ir.model.fields.selection,name:atmta_procurement_vendor.selection__realestate_procurement_vendor_qualification__state__approved
