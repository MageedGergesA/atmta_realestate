<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Wave 11 — moved from `real_estate_procurement` with the vendor
         governance surface. Both actions read vendor data this module owns. -->

    <!-- Filtered partner view — only RE vendors -->
    <record id="action_realestate_vendors" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_realestate_vendor', '=', True)]</field>
        <field name="context">{'res_partner_search_mode': 'supplier', 'default_is_company': True, 'default_supplier_rank': 1}</field>
    </record>

    <record id="action_realestate_vendor_tags" model="ir.actions.act_window">
        <field name="name">Vendor Tags</field>
        <field name="res_model">res.partner.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
