<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_labor_log_list" model="ir.ui.view">
        <field name="name">realestate.construction.labor.log.list</field>
        <field name="model">realestate.construction.labor.log</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="date"/>
                <field name="project_id"/>
                <field name="milestone_id"/>
                <field name="contractor_id"/>
                <field name="trade"/>
                <field name="workers"/>
                <field name="hours"/>
                <field name="total_hours" sum="Total Hours"/>
                <field name="hourly_rate"/>
                <field name="total_cost" sum="Total Cost"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_labor_log_form" model="ir.ui.view">
        <field name="name">realestate.construction.labor.log.form</field>
        <field name="model">realestate.construction.labor.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="project_id"/>
                            <field name="phase_id"/>
                            <field name="milestone_id"/>
                            <field name="task_id"/>
                            <field name="contractor_id"/>
                        </group>
                        <group>
                            <field name="trade"/>
                            <field name="workers"/>
                            <field name="hours"/>
                            <field name="hourly_rate"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="total_hours" readonly="1"/>
                            <field name="total_cost" readonly="1"/>
                            <field name="cost_line_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_labor_log" model="ir.actions.act_window">
        <field name="name">Daily Labor Logs</field>
        <field name="res_model">realestate.construction.labor.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_construction_labor" name="Daily Labor"
              parent="menu_construction_root"
              action="action_labor_log" sequence="22"/>
</odoo>
