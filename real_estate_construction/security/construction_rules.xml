<odoo noupdate="1">
    <!--
      M9T — record rules. Phase 0 found none at all.

      Two families, deliberately kept apart:

      * COMPANY rules are global (no group). Multi-company isolation is not a
        privilege anybody can be granted past; a manager of company A has no
        business reading company B's cost sheet either.

      * PROJECT rules are opt-in per project. A project with no members named
        behaves exactly as it did before this milestone — everyone in the
        company sees it. Name one member and the project becomes restricted to
        its team. That way enabling access control is a decision somebody makes
        per project, not a migration that locks an entire deployment out on
        upgrade day.

      Managers hold an unrestricted project rule, which ORs with the member
      rule for anybody in both groups.
    -->
    <record id="rule_realestate_boq_company" model="ir.rule">
        <field name="name">realestate.boq: company</field>
        <field name="model_id" ref="model_realestate_boq"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

