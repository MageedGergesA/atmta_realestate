<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_material_request_list" model="ir.ui.view">
        <field name="name">realestate.material.request.list</field>
        <field name="model">realestate.material.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'approved'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state in ('received','done')"
                  decoration-muted="state == 'cancelled'"
                  decoration-danger="priority == '1' and state in ('draft','submitted')">
                <field name="name"/>
                <field name="priority" widget="priority"/>
                <field name="project_id" optional="show"/>
                <field name="property_id" optional="hide"/>
                <field name="source_model" optional="hide"/>
                <field name="requested_by_id" widget="many2one_avatar_user"/>
                <field name="buyer_id" widget="many2one_avatar_user" optional="show"/>
                <field name="procurement_type" optional="show"/>
                <field name="needed_by"/>
                <field name="line_count" optional="hide"/>
                <field name="estimated_total" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="coding_status" widget="badge" optional="show"
                       decoration-success="coding_status == 'coded'"
                       decoration-warning="coding_status == 'partial'"
                       decoration-danger="coding_status == 'unassigned'"/>
                <field name="lines_missing_wbs" optional="hide"/>
                <field name="lines_missing_cost_code" optional="hide"/>
                <field name="reserved_amount" optional="show" sum="Reserved"/>
                <field name="reservation_status" widget="badge" optional="hide"
                       decoration-info="reservation_status == 'reserved'"
                       decoration-success="reservation_status == 'converted'"/>
                <field name="approval_control_status" widget="badge" optional="hide"
                       decoration-danger="approval_control_status == 'over_budget'"
                       decoration-warning="approval_control_status == 'insufficient_data'"/>
                <field name="days_waiting" optional="hide"/>
                <field name="rfq_count" optional="show"/>
                <field name="ordered_count" optional="show"/>
                <field name="po_count" optional="hide"/>
                <field name="revision" optional="hide"/>
                <field name="legacy_status" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'approved'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state in ('received','done')"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_material_request_form" model="ir.ui.view">
        <field name="name">realestate.material.request.form</field>
        <field name="model">realestate.material.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="oe_highlight" invisible="state != 'submitted'"
                            groups="atmta_roles.group_procurement_approver"/>
                    <button name="action_open_rfq_wizard" type="object"
                            string="Create RFQs" class="oe_highlight"
                            invisible="state not in ('approved','sourcing')"
                            groups="atmta_roles.group_procurement_buyer"/>
                    <button name="action_open_revision_wizard" type="object" string="Revise"
                            invisible="state not in ('submitted','approved','sourcing')"/>
                    <button name="action_request_budget_exception" type="object"
                            string="Request Budget Exception"
                            invisible="state in ('ordered','partially_ordered','received','done','cancelled')"/>
                    <button name="action_back_to_draft" type="object" string="Back to Draft"
                            invisible="state not in ('submitted','approved','rejected')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,sourcing,ordered,received,done"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="not has_data_quality_warning">
                        <field name="data_quality_warnings" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="state in ('draft','cancelled') or not control_note">
                        <field name="control_status" invisible="1"/>
                        <strong invisible="control_status != 'over_budget'">Over budget. </strong>
                        <strong invisible="control_status != 'insufficient_data'">Control position unknown. </strong>
                        <field name="control_note" readonly="1" nolabel="1"/>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_purchase_orders" icon="fa-shopping-cart"
                                invisible="po_count == 0">
                            <field name="po_count" widget="statinfo" string="POs"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_reservations" icon="fa-lock"
                                invisible="reservation_status == 'none'">
                            <field name="reserved_amount" widget="statinfo" string="Reserved"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="source_type"/>
                            <field name="source_ref"/>
                            <field name="plan_line_id" readonly="1"
                                   invisible="not plan_line_id"/>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="procurement_type"/>
                            <field name="property_id" options="{'no_create': True}"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="requested_by_id" widget="many2one_avatar_user" readonly="1"/>
                            <field name="buyer_id" widget="many2one_avatar_user"/>
                            <field name="request_date"/>
                            <field name="needed_by"/>
                            <field name="revision" readonly="1"/>
                            <field name="approved_by_id" widget="many2one_avatar_user" readonly="1"
                                   invisible="not approved_by_id"/>
                            <field name="approval_date" readonly="1" invisible="not approval_date"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="reservation_status"
                                   invisible="reservation_status == 'none'"/>
                            <field name="converted_amount"
                                   invisible="not converted_amount"/>
                            <field name="approval_control_status"
                                   invisible="not approval_control_status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"
                                           options="{'no_create': True}"/>
                                    <field name="description" optional="hide"/>
                                    <field name="qty"/>
                                    <field name="uom_id" groups="uom.group_uom"/>
                                    <field name="required_on_site_date" optional="show"/>
                                    <field name="estimated_unit_cost" optional="show"/>
                                    <field name="unit_price_hint" optional="hide"/>
                                    <field name="estimated_cost" optional="show"/>
                                    <field name="estimate_is_known" optional="hide"/>
                                    <field name="substitution_allowed" optional="hide"/>
                                    <field name="preferred_brand" optional="hide"/>
                                    <field name="specification_ref" optional="hide"/>
                                    <field name="ordered_qty" optional="show" readonly="1"/>
                                    <field name="remaining_qty" optional="hide" readonly="1"/>
                                    <field name="received_qty" optional="show" readonly="1"/>
                                    <field name="po_line_count" optional="hide" readonly="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="estimated_total" widget="monetary"/>
                            </group>
                        </page>
                        <page string="Approvals" name="approvals"
                              invisible="not approval_step_ids">
                            <field name="approval_step_ids">
                                <list decoration-success="decision == 'approved'"
                                      decoration-danger="decision == 'rejected'"
                                      decoration-muted="decision in ('skipped','cancelled')">
                                    <field name="sequence" widget="handle"/>
                                    <field name="rule_name"/>
                                    <field name="group_id"/>
                                    <field name="approver_user_id" optional="hide"/>
                                    <field name="amount_basis" optional="show"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="decision" widget="badge"
                                           decoration-success="decision == 'approved'"
                                           decoration-danger="decision == 'rejected'"
                                           decoration-warning="decision == 'pending'"/>
                                    <field name="approver_id" optional="show"/>
                                    <field name="approval_date" optional="show"/>
                                    <field name="waiting_days" optional="show"/>
                                    <field name="comment" optional="show"/>
                                    <button name="action_approve" type="object"
                                            string="Approve" class="btn-primary"
                                            invisible="decision != 'pending'"/>
                                    <button name="action_reject" type="object"
                                            string="Reject" class="btn-secondary"
                                            invisible="decision != 'pending'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Revisions" name="revisions"
                              invisible="not revision_ids">
                            <field name="revision_ids" readonly="1">
                                <list>
                                    <field name="revision"/>
                                    <field name="state_at_revision"/>
                                    <field name="estimated_total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="revised_by_id"/>
                                    <field name="revised_on"/>
                                    <field name="reason"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="revision"/>
                                        <field name="state_at_revision"/>
                                        <field name="estimated_total"/>
                                        <field name="currency_id" invisible="1"/>
                                        <field name="revised_by_id"/>
                                        <field name="revised_on"/>
                                    </group>
                                    <field name="reason"/>
                                    <field name="basis"/>
                                </form>
                            </field>
                        </page>
                        <page string="Reservations" name="reservations"
                              invisible="not reservation_ids">
                            <field name="reservation_ids" readonly="1">
                                <list decoration-info="state == 'reserved'"
                                      decoration-success="state == 'converted'"
                                      decoration-muted="state in ('released','cancelled','expired')">
                                    <field name="name"/>
                                    <field name="line_description"/>
                                    <field name="amount_reserved" sum="Reserved"/>
                                    <field name="amount_converted" sum="Converted"/>
                                    <field name="amount_active" sum="Active"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="control_status" widget="badge"
                                           decoration-danger="control_status == 'over_budget'"
                                           decoration-warning="control_status == 'insufficient_data'"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Justification" name="justification">
                            <field name="justification"
                                   placeholder="Why the project needs it."/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Justification, links, supporting docs..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_material_request_search" model="ir.ui.view">
        <field name="name">realestate.material.request.search</field>
        <field name="model">realestate.material.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="property_id"/>
                <field name="requested_by_id"/>
                <filter string="My Requests" name="my_requests"
                        domain="[('requested_by_id', '=', uid)]"/>
                <filter string="Urgent" name="urgent" domain="[('priority', '=', '1')]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Awaiting Approval" name="awaiting" domain="[('state', '=', 'submitted')]"/>
                <filter string="Sourcing" name="sourcing" domain="[('state', '=', 'sourcing')]"/>
                <filter string="Ordered" name="ordered" domain="[('state', 'in', ['ordered','partial'])]"/>
                <filter string="Done" name="done" domain="[('state', 'in', ['received','done'])]"/>
                <separator/>
                <filter string="Missing Cost Code" name="missing_cost_code"
                        domain="[('lines_missing_cost_code', '>', 0)]"/>
                <filter string="Missing WBS" name="missing_wbs"
                        domain="[('lines_missing_wbs', '>', 0)]"/>
                <filter string="Awaiting My Approval" name="my_approvals"
                        domain="[('state', '=', 'submitted'),
                                 ('approval_step_ids.decision', '=', 'pending'),
                                 '|', ('approval_step_ids.approver_user_id', '=', uid),
                                 ('approval_step_ids.approver_user_id', '=', False)]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Reserved" name="reserved" domain="[('reserved_amount', '&gt;', 0)]"/>
                <filter string="Reservation Missing" name="no_reservation"
                        domain="[('state', 'in', ['approved','sourcing']),
                                 ('reservation_status', '=', 'none')]"/>
                <filter string="Over Budget" name="over_budget"
                        domain="[('approval_control_status', '=', 'over_budget')]"/>
                <filter string="Position Unknown" name="position_unknown"
                        domain="[('approval_control_status', '=', 'insufficient_data')]"/>
                <separator/>
                <filter string="Data Quality Warnings" name="data_quality"
                        domain="[('has_data_quality_warning', '=', True)]"/>
                <filter string="Long Lead" name="long_lead"
                        domain="[('plan_line_id.is_long_lead', '=', True)]"/>
                <filter string="Overdue Required Date" name="overdue"
                        domain="[('needed_by', '&lt;', context_today().strftime('%Y-%m-%d')),
                                 ('state', 'not in', ['received','done','cancelled'])]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Requested By" name="group_user" context="{'group_by': 'requested_by_id'}"/>
                    <filter string="Buyer" name="group_buyer" context="{'group_by': 'buyer_id'}"/>
                    <filter string="Procurement Type" name="group_type" context="{'group_by': 'procurement_type'}"/>
                    <filter string="Coding" name="group_coding" context="{'group_by': 'coding_status'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source_type'}"/>
                    <filter string="Reservation" name="group_reservation"
                            context="{'group_by': 'reservation_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_material_request" model="ir.actions.act_window">
        <field name="name">Material Requests</field>
        <field name="res_model">realestate.material.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_material_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Raise a new material request</p>
            <p>Material requests are the entry point for procurement across the suite.
            They group items needed for a construction task, a handover snag, a rental
            ticket or any other source. Approving one authorises the demand; it does
            not commit anybody's budget. Sourcing it prepares requests for quotation
            to vendors a buyer names, and those stay quotations until somebody
            deliberately confirms an order.</p>
        </field>
    </record>
</odoo>
