<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_approval_rule_list" model="ir.ui.view">
        <field name="name">realestate.procurement.approval.rule.list</field>
        <field name="model">realestate.procurement.approval.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="min_amount"/>
                <field name="max_amount"/>
                <field name="project_id" optional="show"/>
                <field name="procurement_type" optional="show"/>
                <field name="priority" optional="show"/>
                <field name="budget_status" optional="show"/>
                <field name="group_id"/>
                <field name="approver_user_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_approval_rule" model="ir.actions.act_window">
        <field name="name">Approval Rules</field>
        <field name="res_model">realestate.procurement.approval.rule</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set who has to agree</p>
            <p>A requisition needs a decision from every rule that matches it.
            Every dimension is optional and an unset one matches everything, so
            one row is a working configuration. Changing a rule never rewrites
            an approval that has already been given — the steps keep their own
            copy of the authority they were raised under.</p>
        </field>
    </record>

    <!-- ================================================================
         M3S — the approval register. One row per required decision, which
         is what makes "who is this waiting on, and since when" a question
         somebody can answer without opening records one at a time.
         ================================================================ -->

    <record id="view_approval_step_list" model="ir.ui.view">
        <field name="name">realestate.procurement.approval.step.list</field>
        <field name="model">realestate.procurement.approval.step</field>
        <field name="arch" type="xml">
            <list decoration-warning="decision == 'pending'"
                  decoration-success="decision == 'approved'"
                  decoration-danger="decision == 'rejected'"
                  decoration-muted="decision in ('skipped','cancelled')">
                <field name="sequence" widget="handle"/>
                <field name="request_id" optional="show"/>
                <field name="project_id" optional="hide"/>
                <field name="rule_name"/>
                <field name="group_id" optional="show"/>
                <field name="approver_user_id" optional="hide"/>
                <field name="amount_basis" sum="Amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="requested_on" optional="hide"/>
                <field name="waiting_days" optional="show"/>
                <field name="approver_id" optional="show"/>
                <field name="approval_date" optional="show"/>
                <field name="comment" optional="show"/>
                <field name="decision" widget="badge"
                       decoration-success="decision == 'approved'"
                       decoration-danger="decision == 'rejected'"
                       decoration-warning="decision == 'pending'"/>
                <button name="action_approve" type="object" string="Approve"
                        invisible="decision != 'pending'" class="btn-primary"/>
            </list>
        </field>
    </record>

    <record id="view_approval_step_search" model="ir.ui.view">
        <field name="name">realestate.procurement.approval.step.search</field>
        <field name="model">realestate.procurement.approval.step</field>
        <field name="arch" type="xml">
            <search>
                <field name="request_id"/>
                <field name="project_id"/>
                <field name="rule_name"/>
                <filter string="Awaiting Approval" name="pending"
                        domain="[('decision', '=', 'pending')]"/>
                <filter string="My Approvals" name="mine"
                        domain="['|', ('approver_user_id', '=', uid),
                                 ('approver_id', '=', uid)]"/>
                <filter string="Approved" name="approved"
                        domain="[('decision', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected"
                        domain="[('decision', '=', 'rejected')]"/>
                <separator/>
                <filter string="Waiting Over A Week" name="stale"
                        domain="[('decision', '=', 'pending'), ('waiting_days', '&gt;', 7)]"/>
                <filter string="Urgent" name="urgent"
                        domain="[('request_id.priority', '=', '1')]"/>
                <filter string="Over Budget" name="over_budget"
                        domain="[('request_id.approval_control_status', '=', 'over_budget')]"/>
                <filter string="Reservation Missing" name="no_reservation"
                        domain="[('request_id.state', 'in', ['approved','sourcing']),
                                 ('request_id.reservation_status', '=', 'none')]"/>
                <group expand="0" string="Group By">
                    <filter string="Requisition" name="group_request"
                            context="{'group_by': 'request_id'}"/>
                    <filter string="Project" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="Decision" name="group_decision"
                            context="{'group_by': 'decision'}"/>
                    <filter string="Approver Group" name="group_group"
                            context="{'group_by': 'group_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_approval_step_pivot" model="ir.ui.view">
        <field name="name">realestate.procurement.approval.step.pivot</field>
        <field name="model">realestate.procurement.approval.step</field>
        <field name="arch" type="xml">
            <pivot string="Approvals">
                <field name="project_id" type="row"/>
                <field name="decision" type="col"/>
                <field name="amount_basis" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_approval_register" model="ir.actions.act_window">
        <field name="name">Approval Register</field>
        <field name="res_model">realestate.procurement.approval.step</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_approval_step_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
