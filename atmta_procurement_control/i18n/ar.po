#. module: atmta_procurement_control
#: model:ir.model.fields,field_description:atmta_procurement_control.field_realestate_procurement_control_exception__approved_by_id
msgid "Approved By"
msgstr "اعتمد بواسطة"

#. module: atmta_procurement_control
#: model:ir.model.fields,help:atmta_procurement_control.field_realestate_material_request__reservation_status
msgid ""
"Approved and reserved are different facts, and the lifecycle keeps them in "
"one field each rather than inventing a state that means both."
msgstr ""
"الاعتماد والحجز حقيقتان مختلفتان، ودورة الحياة تحفظ كلًا منهما في حقل مستقل "
"بدلًا من اختراع حالة تعني الاثنين معًا."

#. module: atmta_procurement_control
#: model:ir.model.fields,help:atmta_procurement_control.field_realestate_material_request__reserved_amount
msgid ""
"Approved demand still consuming this project's purchasing capacity. It is "
"not a commitment: nobody is owed it, no journal entry exists and "
"Construction's figures are untouched."
msgstr ""
"طلب معتمد لا يزال يستهلك من رصيد الشراء المتاح لهذا المشروع. وهو ليس "
"التزامًا: فلا يستحق لأحد، ولا يوجد قيد في اليومية، وأرقام المقاولات لم "
"تتأثر."

#. module: atmta_procurement_control
#. odoo-python
#: code:addons/atmta_procurement_control/models/material_request_control.py:0
msgid "Approved demand with no reservation, under a %s policy."
msgstr "طلب معتمد دون حجز ميزانية، وفق سياسة %s."

#. module: atmta_procurement_control
#. odoo-python
#: code:addons/atmta_procurement_control/models/material_request_control.py:0
msgid ""
"Approved under a Warn policy: the demand exceeded available capacity by %s "
"and the company's policy is to record rather than refuse."
msgstr ""
"اعتُمد وفق سياسة التحذير: تجاوز الطلب الرصيد المتاح بمقدار %s، وسياسة الشركة"
" هي التسجيل بدلًا من الرفض."

#. module: atmta_procurement_control
#. odoo-python
#: code:addons/atmta_procurement_control/models/material_request_control.py:0
msgid "Approved. %s"
msgstr "معتمد. %s"

