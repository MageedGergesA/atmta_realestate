<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_payment_schedule">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Payment Schedule for Contract
                            <span t-field="doc.name"/>
                        </h2>

                        <!-- Summary Section -->
                        <div class="row mb-4">
                            <div class="col-4">
                                <p>
                                    <strong>Tenant:</strong>
                                    <span t-field="doc.partner_id"/>
                                </p>
                            </div>
                            <div class="col-4">
                                <p>
                                    <strong>Period:</strong>
                                    <span t-field="doc.start_date"/>
                                    to
                                    <span t-field="doc.end_date"/>
                                </p>
                            </div>
                            <div class="col-4">
                                <p>
                                    <strong>Total Value:</strong>
                                    <span t-field="doc.total_scheduled"/>
                                </p>
                            </div>
                        </div>

                        <!-- Payment Timeline -->
                        <h4>Payment Timeline</h4>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Due Date</th>
                                    <th>Property</th>
                                    <th>Amount</th>
                                    <th>Payment Plan</th>
                                    <th>Increment Rules</th>
                                    <th>Discount Rules</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.contract_payment_ids.sorted('date_due')" t-as="payment">
                                    <tr>
                                        <td>
                                            <span t-field="payment.date_due"/>
                                        </td>
                                        <td>
                                            <span t-field="payment.contract_line_id.property_id"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="payment.amount"/>
                                            <t t-if="payment.increase_amount or payment.discount_amount">
                                                <br/>
                                                <small class="text-muted">
                                                    (
                                                    <span t-esc="'Base: ' + str(payment.amount - payment.increase_amount + payment.discount_amount)"/>
                                                    <t t-if="payment.increase_amount">
                                                        <span t-esc="', +' + str(payment.increase_amount)"/>
                                                    </t>
                                                    <t t-if="payment.discount_amount">
                                                        <span t-esc="', -' + str(payment.discount_amount)"/>
                                                    </t>
                                                    )
                                                </small>
                                            </t>
                                        </td>
                                        <td>
                                            <span t-field="payment.payment_plan_id"/>
                                        </td>
                                        <td>
                                            <span t-field="payment.increment_rule_ids"/>
                                        </td>
                                        <td>
                                            <span t-field="payment.discount_rule_ids"/>
                                        </td>
                                        <td>
                                            <span t-att-class="'badge rounded-pill ' +
                 ('bg-success' if payment.move_id and payment.move_id.state == 'posted' else 'bg-warning')"
                                                  t-att-style="'font-size: 0.85em; padding: 0.35em 0.65em;'">
                                                <span t-field="payment.move_state" style="text-transform: capitalize;"/>
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="2">
                                        <strong>Total</strong>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="doc.total_scheduled"/>
                                    </td>
                                    <td colspan="2"></td>
                                </tr>
                            </tfoot>
                        </table>
                        <div class="row mt-4">
                        <div class="col-6">
                            <p>Tenant Signature: ___________________</p>
                        </div>
                        <div class="col-6">
                            <p>Agent Signature: ___________________</p>
                        </div>
                    </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
    <record id="action_report_payment_schedule" model="ir.actions.report">
        <field name="name">Contract Payments Details</field>
        <field name="model">realestate.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">atmta_real_estate.report_payment_schedule</field>
        <field name="report_file">atmta_real_estate.report_payment_schedule</field>
        <field name="binding_model_id" ref="model_realestate_contract"/>
        <field name="binding_type">action</field>
        <field name="print_report_name">'Unit_Status_%s' % object.name</field>
    </record>

</odoo>