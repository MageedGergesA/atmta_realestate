<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ============================================================= -->
    <!-- KPI card                                                       -->
    <!-- ============================================================= -->
    <t t-name="atmta_real_estate.KpiCard">
        <div class="o_re_kpi"
             t-att-class="{
                'o_re_kpi_clickable': props.clickable,
                'o_re_kpi_warning': props.warning,
                'o_re_kpi_positive': props.tone === 'positive',
             }"
             t-att-role="props.clickable ? 'button' : null"
             t-att-tabindex="props.clickable ? 0 : null"
             t-att-aria-label="ariaLabel"
             t-on-click="onCardClick"
             t-on-keydown="onKeydown">

            <div class="o_re_kpi_label">
                <span t-esc="props.label"/>
                <sup t-if="props.hint" class="o_re_kpi_hint" t-att-title="props.hint">
                    <i class="fa fa-question-circle-o" role="img" t-att-aria-label="props.hint"/>
                </sup>
            </div>

            <div class="o_re_kpi_value" t-esc="props.formattedValue"/>

            <!-- Status is never colour-only: a warning also carries an icon
                 and a text label for screen readers and colour-blind users. -->
            <div t-if="props.warning" class="o_re_kpi_status">
                <i class="fa fa-exclamation-triangle" role="img" aria-hidden="true"/>
                <span t-esc="statusLabel"/>
            </div>

            <div t-if="props.progress !== undefined" class="o_re_kpi_progress"
                 role="progressbar"
                 t-att-aria-valuenow="props.progress"
                 aria-valuemin="0" aria-valuemax="100">
                <div class="o_re_kpi_progress_bar" t-attf-style="inline-size: {{ props.progress }}%;"/>
            </div>

            <div t-if="props.clickable" class="o_re_kpi_drill" aria-hidden="true">
                <i class="fa fa-arrow-right"/>
            </div>
        </div>
    </t>

    <!-- ============================================================= -->
    <!-- Chart panel                                                    -->
    <!-- ============================================================= -->
    <t t-name="atmta_real_estate.DashboardChart">
        <div class="o_re_panel o_re_chart_panel">
            <div class="o_re_panel_head">
                <div>
                    <h3 class="o_re_panel_title" t-esc="props.definition.title"/>
                    <p t-if="props.definition.subtitle" class="o_re_panel_subtitle"
                       t-esc="props.definition.subtitle"/>
                </div>
            </div>

            <div t-if="isEmpty" class="o_re_empty" role="status">
                <i class="fa fa-bar-chart o_re_empty_icon" aria-hidden="true"/>
                <p class="o_re_empty_text" t-esc="emptyText"/>
            </div>

            <div t-else="" class="o_re_chart_canvas_wrap">
                <canvas t-ref="canvas" t-att-aria-label="props.definition.title" role="img"/>
            </div>
        </div>
    </t>

    <!-- ============================================================= -->
    <!-- Map card                                                       -->
    <!-- ============================================================= -->
    <t t-name="atmta_real_estate.DashboardMap">
        <div class="o_re_panel o_re_map_card">
            <div class="o_re_panel_head">
                <div>
                    <h3 class="o_re_panel_title">Units on the map</h3>
                    <p t-if="state.status === 'ready'" class="o_re_panel_subtitle">
                        <span class="o_re_map_located"><t t-esc="state.units.length"/> located</span>
                        <t t-if="state.withoutCoordinates">
                            <span class="o_re_sep" aria-hidden="true">·</span>
                            <span class="o_re_map_missing"><t t-esc="state.withoutCoordinates"/> without coordinates</span>
                        </t>
                        <t t-if="state.truncated">
                            <span class="o_re_sep" aria-hidden="true">·</span>
                            <span>open the full map to see every unit</span>
                        </t>
                    </p>
                </div>
                <button class="btn btn-link o_re_panel_more o_re_map_open_full" t-on-click="openFullMap">
                    <span>Open full map</span>
                    <i class="fa fa-arrow-right ms-1" aria-hidden="true"/>
                </button>
            </div>

            <div t-if="state.status === 'loading'" class="o_re_map_loading" aria-busy="true">
                <span class="visually-hidden">Loading the map…</span>
            </div>
            <div t-elif="state.status === 'error'" class="o_re_empty" role="status">
                <i class="fa fa-exclamation-circle o_re_empty_icon" aria-hidden="true"/>
                <p class="o_re_empty_text">The map could not be loaded.</p>
            </div>
            <div t-elif="!state.units.length" class="o_re_empty o_re_map_empty" role="status">
                <i class="fa fa-map-marker o_re_empty_icon" aria-hidden="true"/>
                <p class="o_re_empty_text">No rental unit has coordinates yet. Add a latitude and longitude on a unit to place it on the map.</p>
            </div>
            <t t-else="">
                <p t-if="state.noLibrary" class="o_re_empty_text">The map library is not available.</p>
                <div t-else="" class="o_re_map_canvas" t-ref="map" role="region" aria-label="Map of rental units"/>
                <ul class="o_re_map_legend">
                    <li t-foreach="legend" t-as="item" t-key="item.key">
                        <span class="o_re_map_dot" t-attf-style="background: {{ item.color }};" aria-hidden="true"/>
                        <span t-esc="item.label"/>
                        <span class="o_re_map_count" t-esc="item.count"/>
                    </li>
                </ul>
            </t>
        </div>
    </t>

    <!-- ============================================================= -->
    <!-- Dashboard                                                      -->
    <!-- ============================================================= -->
    <!-- =================================================================
         Rental Overview.

         Reading order, top to bottom: what is happening (KPIs), why
         (trends), what is wrong (Attention Required), what I do about it
         (My Work). The first viewport carries the figures somebody acts on;
         detail goes below the fold.
         ================================================================= -->
    <t t-name="atmta_real_estate.RentalDashboard">
        <!-- Both root classes on purpose: `o_ad_dashboard` brings the shared
             design tokens and `o_re_dashboard` the Rental chart palette. The
             scroll lives on `.o_ad_scroll` because Odoo styles `.o_action`
             `overflow: hidden` at a higher specificity than anything here. -->
        <div class="o_ad_dashboard o_re_dashboard o_action">
            <div class="o_ad_scroll">

                <header class="o_ad_header">
                    <div>
                        <h1 class="o_ad_title">Rental</h1>
                        <p class="o_ad_subtitle" t-if="isReady">
                            <span t-esc="data.company_name"/>
                            <span class="o_ad_sep" aria-hidden="true">·</span>
                            <span class="o_ad_asof">
                                <i class="fa fa-calendar-o" aria-hidden="true"/>
                                <span>As of <t t-esc="data.as_of"/></span>
                            </span>
                            <t t-if="lastUpdatedLabel">
                                <span class="o_ad_sep" aria-hidden="true">·</span>
                                <span t-esc="lastUpdatedLabel"/>
                            </t>
                        </p>
                    </div>

                    <div class="o_ad_header_actions">
                        <t t-foreach="data.quick_actions or []" t-as="quick" t-key="quick.key">
                            <button class="btn btn-sm"
                                    t-att-class="quick_first ? 'btn-primary' : 'btn-secondary'"
                                    t-att-data-quick-action="quick.key"
                                    t-on-click="() => this.runQuickAction(quick.key)">
                                <i t-attf-class="fa {{ quick.icon }} me-1" aria-hidden="true"/>
                                <span t-esc="quick.label"/>
                            </button>
                        </t>
                        <div class="btn-group" role="group" aria-label="Whose work to show">
                            <button class="btn btn-sm" data-scope="mine"
                                    t-att-class="state.scope === 'mine' ? 'btn-primary' : 'btn-outline-secondary'"
                                    t-on-click="() => this.setScope('mine')">Mine</button>
                            <button class="btn btn-sm" data-scope="team"
                                    t-att-class="state.scope === 'team' ? 'btn-primary' : 'btn-outline-secondary'"
                                    t-on-click="() => this.setScope('team')">
                                <i class="fa fa-users me-1" aria-hidden="true"/>Team</button>
                        </div>
                        <button class="btn btn-sm btn-secondary" t-on-click="onRefresh"
                                t-att-disabled="state.refreshing" aria-label="Refresh the dashboard">
                            <i class="fa fa-refresh" t-att-class="{ 'fa-spin': state.refreshing }"
                               aria-hidden="true"/>
                            <span class="d-none d-md-inline ms-1">Refresh</span>
                        </button>
                    </div>
                </header>

                <AtmtaFilterBar t-if="isReady and (data.filters or []).length"
                                filters="data.filters" values="state.filters"
                                onChange="(key, value) => this.setFilter(key, value)"
                                onReset="() => this.resetFilters()"/>

                <AtmtaSkeleton t-if="isLoading" kpis="6" panels="4"/>

                <div t-elif="isError" class="o_ad_state" role="alert">
                    <i class="fa fa-exclamation-circle o_ad_state_icon" aria-hidden="true"/>
                    <h2 class="o_ad_state_title">The dashboard could not be loaded</h2>
                    <p class="o_ad_state_text" t-esc="state.errorMessage"/>
                    <button class="btn btn-primary" t-on-click="onRefresh">Retry</button>
                </div>

                <t t-else="">
                    <!-- ==== The six figures the page is read for ========== -->
                    <div class="o_ad_kpi_grid o_ad_section">
                        <AtmtaKpiCard t-foreach="data.kpis or []" t-as="tile" t-key="tile.key"
                                      tile="tile" currencyId="currencyId"
                                      onDrill="(key) => this.drill(key)"/>
                    </div>

                    <!-- ==== Why it is happening =========================== -->
                    <div class="o_ad_grid o_ad_section">
                        <div class="o_ad_col_4">
                            <DashboardChart t-if="occupancyPayload"
                                            definition="charts.occupancy" payload="occupancyPayload"
                                            currencyId="currencyId"/>
                        </div>

                        <AtmtaCard className="'o_ad_col_3'" title="'Lease Status'" icon="'fa-file-text-o'">
                            <AtmtaDonut segments="leaseStatus.segments"
                                        total="leaseStatus.total"
                                        totalLabel="leaseStatus.total_label"
                                        onSegment="(key) => this.drill(key)"/>
                        </AtmtaCard>

                        <div class="o_ad_col_3">
                            <DashboardChart t-if="collectionPayload"
                                            definition="charts.collection" payload="collectionPayload"
                                            currencyId="currencyId"/>
                        </div>

                        <AtmtaCard className="'o_ad_col_2'" title="'Expirations &amp; Renewals'"
                                   icon="'fa-calendar'">
                            <AtmtaRowList rows="data.expirations or []"
                                          onRow="(key) => this.drill(key)"
                                          emptyText="'Nothing expiring in the next 90 days.'"/>
                        </AtmtaCard>
                    </div>

                    <!-- ==== What is wrong, and what I do about it ========= -->
                    <div class="o_ad_grid o_ad_section">
                        <div class="o_ad_col_5">
                            <DashboardMap/>
                        </div>

                        <AtmtaCard className="'o_ad_col_4'" title="'Attention Required'"
                                   icon="'fa-exclamation-triangle'">
                            <AtmtaRowList rows="data.alerts or []"
                                          onRow="(key) => this.drill(key)"
                                          emptyText="'Nothing needs your attention.'"/>
                        </AtmtaCard>

                        <AtmtaCard className="'o_ad_col_3'" title="'My Work'"
                                   icon="'fa-check-square-o'">
                            <AtmtaRowList rows="data.work_queue or []"
                                          onRow="(key) => this.drill(key)"
                                          emptyText="'Your queue is clear.'"/>
                        </AtmtaCard>
                    </div>

                    <!-- ==== Where the vacancy and the money actually are ==== -->
                    <div class="o_ad_grid o_ad_section">
                        <AtmtaCard className="'o_ad_col_3'" title="'Unit Availability'"
                                   icon="'fa-th'">
                            <AtmtaDonut segments="unitMix.segments"
                                        total="unitMix.total"
                                        totalLabel="unitMix.total_label"
                                        onSegment="(key) => this.drill(key)"/>
                        </AtmtaCard>

                        <AtmtaCard className="'o_ad_col_4'" title="'Occupancy by Unit Type'"
                                   icon="'fa-home'"
                                   subtitle="'One portfolio figure hides which type is empty'">
                            <AtmtaDataTable columns="unitTypeColumns"
                                            rows="data.unit_types or []"
                                            currencyId="currencyId"
                                            emptyText="'No leasable units match these filters.'"/>
                        </AtmtaCard>

                        <div class="o_ad_col_5">
                            <DashboardChart t-if="arrearsPayload"
                                            definition="charts.arrears" payload="arrearsPayload"
                                            currencyId="currencyId"/>
                            <AtmtaCard t-else="" title="'Arrears Ageing'" icon="'fa-clock-o'">
                                <AtmtaRowList rows="[]"
                                              emptyText="'Nothing overdue. Every invoiced obligation is settled.'"/>
                            </AtmtaCard>
                        </div>
                    </div>

                    <div class="o_ad_grid o_ad_section">
                        <AtmtaCard className="'o_ad_col_12'" title="'Property Performance'"
                                   icon="'fa-building-o'"
                                   subtitle="'Ranked by monthly rent, because occupancy alone ranks a full studio block above a half-empty tower'">
                            <AtmtaDataTable columns="topPropertyColumns"
                                            rows="data.top_properties or []"
                                            currencyId="currencyId"
                                            onRow="(row) => this.openProperty(row)"
                                            emptyText="'No let property matches these filters.'"/>
                        </AtmtaCard>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
