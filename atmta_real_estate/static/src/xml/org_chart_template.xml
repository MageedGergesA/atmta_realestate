<?xml version="1.0" encoding="UTF-8"?>
<templates>

    <t t-name="atmta_real_estate.CustomerChartWidget">
        <t t-set="parent" t-value="OrgState.data['parent']"/>
        <t t-set="self" t-value="OrgState.data['self']"/>
        <t t-set="children" t-value="OrgState.data['child']"/>

        <style>
            .org-chart-container {
            font-family: "Inter", sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 40px 20px;
            }

            .org-node {
            display: flex;
            flex-direction: column;
            align-items: center;
            border: 1px solid #ccc;
            border-radius: 10px;
            background-color: #fff;
            padding: 10px;
            width: 160px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
            position: relative;
            z-index: 2;
            }

            .org-node-img {
            width: 140px;
            height: 120px;
            object-fit: cover;
            border-radius: 8px;
            background: #f0f0f0;
            margin-bottom: 6px;
            }

            .org-node-name {
            font-size: 13px;
            font-weight: 500;
            text-align: center;
            }

            .org-line-down {
            width: 2px;
            height: 30px;
            background-color: #ccc;
            margin: 0 auto;
            }

            .org-level {
            display: flex;
            justify-content: center;
            position: relative;
            }

            .org-children-connector {
            display: flex;
            flex-direction: column;
            align-items: center;
            }

            .org-children-box {
            border: 2px dashed #ccc;
            border-radius: 12px;
            padding: 20px;
            margin-top: 0;
            background: #fafafa;
            max-width: 1000px;
            width: 100%;
            }

            .org-children-wrapper {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            justify-items: center;
            }

            .org-node-wrapper {
            display: flex;
            justify-content: center;
            }

            .org-node-wrapper .org-node {
            margin: 0 auto;
            }

            @media (max-width: 768px) {
            .org-children-wrapper {
            grid-template-columns: repeat(2, 1fr);
            }
            }

            @media (max-width: 480px) {
            .org-children-wrapper {
            grid-template-columns: 1fr;
            }
            }
        </style>

        <div class="org-chart-container">
            <!-- Parent -->
            <t t-if="parent">
                <div class="org-level">
                    <div class="org-node" t-on-click="() => onChildClick(parent['id'], this)">
                        <img t-att-src="'/web/image/product.product/' + parent.id + '/image_128'" class="org-node-img"/>
                        <p class="org-node-name">
                            <t t-esc="parent['name']"/>
                        </p>
                    </div>
                </div>
                <div class="org-line-down"></div>
            </t>

            <!-- Self -->
            <t t-if="self">
                <div class="org-level">
                    <div class="org-node">
                        <img t-att-src="'/web/image/product.product/' + self.id + '/image_128'" class="org-node-img"/>
                        <p class="org-node-name">
                            <t t-esc="self['name']"/>
                        </p>
                    </div>
                </div>
            </t>

            <!-- Children -->
            <t t-if="children and children.length">
                <div class="org-children-connector">
                    <div class="org-line-down"></div>
                    <div class="org-children-box">
                        <div class="org-children-wrapper">
                            <t t-foreach="children" t-as="child" t-key="child['id']">
                                <div class="org-node-wrapper">
                                    <div class="org-node" t-on-click="() => onChildClick(child['id'], this)">
                                        <img t-att-src="'/web/image/product.product/' + child.id + '/image_128'"
                                             class="org-node-img"/>
                                        <p class="org-node-name">
                                            <t t-esc="child['name']"/>
                                        </p>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
