<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="atmta_real_estate.RentalDashboard">
        <div class="o_action o_rental_dashboard d-flex flex-column h-100">

            <!-- Toolbar -->
            <div class="o_rd_toolbar d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
                <div>
                    <h3 class="mb-0 d-inline-block me-3">
                        <i class="fa fa-key me-2"/>Rental Dashboard
                    </h3>
                    <span class="text-muted small">
                        Last update: <t t-esc="state.lastUpdate or '—'"/>
                    </span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-primary" t-on-click="() => this.refresh()">
                        <i class="fa fa-refresh me-1"/>Refresh
                    </button>
                    <button class="btn btn-sm btn-outline-secondary"
                            t-att-class="{ 'btn-success text-white': state.autoRefresh }"
                            t-on-click="() => this.toggleAutoRefresh()">
                        <i class="fa fa-clock-o me-1"/>
                        <t t-if="state.autoRefresh">Auto-refresh ON</t>
                        <t t-else="">Auto-refresh OFF</t>
                    </button>
                </div>
            </div>

            <div t-if="state.loading" class="o_rd_loading text-center p-5">
                <i class="fa fa-spinner fa-spin fa-3x text-muted"/>
                <div class="text-muted mt-2">Loading dashboard…</div>
            </div>

            <div t-if="state.data" class="o_rd_body p-3">

                <!-- KPI ROW -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <div class="o_rd_kpi o_rd_kpi_blue">
                            <div class="o_rd_kpi_label">Occupancy</div>
                            <div class="o_rd_kpi_value">
                                <t t-esc="state.data.kpis.occupancy_rate"/>%
                            </div>
                            <div class="o_rd_kpi_sub">
                                <t t-esc="state.data.kpis.rented_count"/> rented /
                                <t t-esc="state.data.kpis.total_properties"/> total
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="o_rd_kpi o_rd_kpi_green">
                            <div class="o_rd_kpi_label">Active Contracts</div>
                            <div class="o_rd_kpi_value"><t t-esc="state.data.kpis.active_contracts"/></div>
                            <div class="o_rd_kpi_sub">
                                <t t-esc="state.data.kpis.draft_contracts"/> in draft
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="o_rd_kpi o_rd_kpi_purple">
                            <div class="o_rd_kpi_label">Revenue MTD</div>
                            <div class="o_rd_kpi_value">
                                <t t-esc="state.data.currency"/> <t t-esc="formatMoney(state.data.kpis.revenue_collected_mtd)"/>
                            </div>
                            <div class="o_rd_kpi_sub">
                                <t t-esc="state.data.kpis.collection_rate"/>% of expected
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="o_rd_kpi o_rd_kpi_red">
                            <div class="o_rd_kpi_label">Overdue</div>
                            <div class="o_rd_kpi_value">
                                <t t-esc="state.data.currency"/> <t t-esc="formatMoney(state.data.kpis.overdue_amount)"/>
                            </div>
                            <div class="o_rd_kpi_sub">
                                <t t-esc="state.data.kpis.overdue_count"/> payment(s)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Donut charts (map hidden for now — see commented block below) -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="o_rd_card">
                            <div class="o_rd_card_title"><i class="fa fa-pie-chart me-2"/>Property Status</div>
                            <div class="o_rd_chart"><canvas t-ref="donutProp"/></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="o_rd_card">
                            <div class="o_rd_card_title"><i class="fa fa-file-text-o me-2"/>Contract Status</div>
                            <div class="o_rd_chart"><canvas t-ref="donutContract"/></div>
                        </div>
                    </div>
                </div>
                <!-- Map hidden via t-if="false" — keep the ref so JS doesn't choke.
                     Flip the condition to re-enable. -->
                <div class="row mb-3" t-if="false">
                    <div class="col-md-12">
                        <div class="o_rd_card">
                            <div class="o_rd_card_title">
                                <i class="fa fa-map-marker me-2"/>Properties Map
                                <span class="badge bg-secondary ms-2">
                                    <t t-esc="state.data.map_props.length"/> located
                                </span>
                            </div>
                            <div t-ref="map" class="o_rd_map"/>
                            <div class="o_rd_legend mt-2 small">
                                <span class="me-3"><span class="o_dot" style="background:#28a745"/>Available</span>
                                <span class="me-3"><span class="o_dot" style="background:#fd7e14"/>Reserved</span>
                                <span class="me-3"><span class="o_dot" style="background:#0d6efd"/>Rented</span>
                                <span class="me-3"><span class="o_dot" style="background:#ffc107"/>Maintenance</span>
                                <span class="me-3"><span class="o_dot" style="background:#6c757d"/>Inactive</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- HIERARCHY -->
                <div class="row mb-3">
                    <div class="col-12">
                        <div class="o_rd_card">
                            <div class="o_rd_card_title d-flex justify-content-between align-items-center">
                                <span><i class="fa fa-sitemap me-2"/>Property Hierarchy (top-level)</span>
                                <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.openHierarchy()">
                                    Open Full Tree
                                </button>
                            </div>
                            <div class="row">
                                <div class="col-md-3 mb-2" t-foreach="state.data.hierarchy" t-as="h" t-key="h.id">
                                    <div class="o_rd_hierarchy_card"
                                         t-on-click="() => this.openProperty(h.id)">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span class="badge bg-info"><t t-esc="h.hierarchy_level"/></span>
                                            <span class="small text-muted"><t t-esc="h.property_code"/></span>
                                        </div>
                                        <div class="fw-bold mt-1"><t t-esc="h.name"/></div>
                                        <div class="small text-muted"><t t-esc="h.city or ''"/></div>
                                        <div class="mt-2 small">
                                            <i class="fa fa-home me-1"/><t t-esc="h.child_count"/> children
                                        </div>
                                        <div class="mt-1 small">
                                            <span class="text-success me-2">●<t t-esc="h.available_count"/> avail</span>
                                            <span class="text-primary">●<t t-esc="h.occupied_count"/> rented</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- REVENUE TREND + CITIES + TENANTS -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="o_rd_card">
                            <div class="o_rd_card_title"><i class="fa fa-line-chart me-2"/>Revenue — Last 6 Months</div>
                            <div class="o_rd_chart_lg"><canvas t-ref="lineRevenue"/></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="o_rd_card">
                            <div class="o_rd_card_title"><i class="fa fa-bar-chart me-2"/>Top Tenants</div>
                            <div class="o_rd_chart_lg"><canvas t-ref="barTenants"/></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="o_rd_card">
                            <div class="o_rd_card_title"><i class="fa fa-building me-2"/>Properties by City</div>
                            <div class="o_rd_chart_lg"><canvas t-ref="barCities"/></div>
                        </div>
                    </div>
                </div>

                <!-- LISTS -->
                <div class="row">
                    <div class="col-md-4">
                        <div class="o_rd_card">
                            <div class="o_rd_card_title d-flex justify-content-between align-items-center">
                                <span><i class="fa fa-calendar me-2"/>Expiring Contracts (30 days)</span>
                                <span class="badge bg-warning text-dark">
                                    <t t-esc="state.data.expirations.count_30"/>
                                </span>
                            </div>
                            <div class="o_rd_list">
                                <div class="text-muted small text-center p-2"
                                     t-if="!state.data.expirations.list.length">
                                    No contracts expiring in 30 days
                                </div>
                                <div t-foreach="state.data.expirations.list" t-as="e" t-key="e.id"
                                     class="o_rd_list_item"
                                     t-on-click="() => this.openContract(e.id)">
                                    <div class="d-flex justify-content-between">
                                        <strong><t t-esc="e.name"/></strong>
                                        <span class="badge"
                                              t-att-class="e.days_left lt 7 ? 'bg-danger' : (e.days_left lt 14 ? 'bg-warning text-dark' : 'bg-info')">
                                            <t t-esc="e.days_left"/>d
                                        </span>
                                    </div>
                                    <div class="small text-muted"><t t-esc="e.partner_name"/></div>
                                    <div class="small"><t t-esc="e.end_date"/></div>
                                </div>
                            </div>
                            <div class="small text-muted text-center mt-2">
                                <t t-esc="state.data.expirations.count_60"/> in 60d ·
                                <t t-esc="state.data.expirations.count_90"/> in 90d
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="o_rd_card">
                            <div class="o_rd_card_title d-flex justify-content-between align-items-center">
                                <span><i class="fa fa-exclamation-triangle me-2 text-danger"/>Overdue Payments</span>
                                <span class="badge bg-danger">
                                    <t t-esc="state.data.kpis.overdue_count"/>
                                </span>
                            </div>
                            <div class="o_rd_list">
                                <div class="text-muted small text-center p-2"
                                     t-if="!state.data.overdue.length">
                                    No overdue payments. 🎉
                                </div>
                                <div t-foreach="state.data.overdue" t-as="o" t-key="o.id"
                                     class="o_rd_list_item"
                                     t-on-click="() => this.openContract(o.contract_name)">
                                    <div class="d-flex justify-content-between">
                                        <strong><t t-esc="o.contract_name"/></strong>
                                        <span class="badge bg-danger"><t t-esc="o.days_overdue"/>d</span>
                                    </div>
                                    <div class="small text-muted"><t t-esc="o.partner_name"/></div>
                                    <div class="small">
                                        <t t-esc="state.data.currency"/> <t t-esc="formatMoney(o.amount)"/>
                                        · due <t t-esc="o.date_due"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="o_rd_card">
                            <div class="o_rd_card_title d-flex justify-content-between align-items-center">
                                <span><i class="fa fa-wrench me-2 text-warning"/>Open Maintenance</span>
                                <span class="badge bg-warning text-dark">
                                    <t t-esc="state.data.maintenance.length"/>
                                </span>
                            </div>
                            <div class="o_rd_list">
                                <div class="text-muted small text-center p-2"
                                     t-if="!state.data.maintenance.length">
                                    No open maintenance requests.
                                </div>
                                <div t-foreach="state.data.maintenance" t-as="m" t-key="m.id"
                                     class="o_rd_list_item"
                                     t-on-click="() => this.openMaintenance(m.id)">
                                    <div class="d-flex justify-content-between">
                                        <strong><t t-esc="m.name"/></strong>
                                        <span class="badge bg-secondary"><t t-esc="m.state"/></span>
                                    </div>
                                    <div class="small text-muted"><t t-esc="m.property_name"/></div>
                                    <div class="small">
                                        <t t-esc="m.scheduled_date or m.request_date or ''"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </t>

</templates>
