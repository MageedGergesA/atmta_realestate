<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Tree View -->
    <record id="view_contract_increment_rule_tree" model="ir.ui.view">
        <field name="name">contract.increment.rule.tree</field>
        <field name="model">realestate.contract.increment.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="discount" optional="show"/>
                <field name="start_month" optional="show"/>
                <field name="duration_months"/>
                <field name="increase_type" optional="show"/>
                <field name="increase_value" optional="show"/>
                <field name="priority" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_contract_increment_rule_form" model="ir.ui.view">
        <field name="name">contract.increment.rule.form</field>
        <field name="model">realestate.contract.increment.rule</field>
        <field name="arch" type="xml">
            <form string="Price Increment Rule">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                        <hr/>
                    </div>
                    <group col="2">
                        <field name="start_month"/>
                        <field name="duration_months"/>
                        <field name="increase_type"/>
                        <field name="discount"/>
                        <field name="increase_value"/>
                        <field name="priority"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_contract_increment_rule" model="ir.actions.act_window">
        <field name="name">Price Increment Rules</field>
        <field name="res_model">realestate.contract.increment.rule</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>
