    <record id="view_realestate_contract_kanban" model="ir.ui.view">
        <field name="name">realestate.contract.kanban</field>
        <field name="model">realestate.contract</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_realestate_contract" default_order="start_date desc">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="start_date"/>
                <field name="end_date"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_card shadow rounded p-2"
                             t-att-style="
            'border-left: 5px solid ' + (
                record.state.raw_value == 'active' and '#28a745' or
                record.state.raw_value == 'terminated' and '#dc3545' or
                record.state.raw_value == 'expired' and '#dc3545' or
                record.state.raw_value == 'confirmed' and '#0d6efd' or
                record.state.raw_value == 'invoiced' and '#0d6efd' or
                record.state.raw_value == 'ready' and '#ffc107' or
                record.state.raw_value == 'draft' and '#6c757d' or
                '#dee2e6'
            )
        ">
                            <div class="d-flex justify-content-between mb-2">
                                <strong class="text-primary fs-5">
                                    <field name="name"/>
                                </strong>
                                <span t-attf-class="badge rounded-pill bg-#{record.state.raw_value}">
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'active'"
                                           decoration-danger="state in ('terminated', 'expired')"
                                           decoration-info="state in ('confirmed', 'invoiced')"
                                           decoration-warning="state == 'ready'"
                                           decoration-muted="state == 'draft'" optional="show"/>
                                </span>
                            </div>

                            <div class="text-muted small mb-1">
                                Tenant:
                                <span class="text-dark fw-bold">
                                    <field name="partner_id"/>
                                </span>
                            </div>

                            <div class="text-muted small">
                                <i class="fa fa-calendar me-1 text-info"/>
                                <field name="start_date"/>
                                →
                                <field name="end_date"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="action_realestate_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">realestate.contract</field>
        <field name="view_mode">kanban,list,form,pivot</field>
    </record>
</odoo>
