<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_realestate_contract_form" model="ir.ui.view">
        <field name="name">realestate.contract.form</field>
        <field name="model">realestate.contract</field>
        <field name="arch" type="xml">
            <form string="Real Estate Contract">
                <header>
                    <button name="action_generate_payment_lines"
                            type="object"
                            string="Generate Payment Schedule"
                            class="btn-info"
                            groups="atmta_real_estate.group_realestate_user"
                            invisible="state != 'draft'"/>

                    <button name="action_confirm"
                            type="object"
                            string="Confirm Contract"
                            class="btn-primary"
                            groups="atmta_real_estate.group_realestate_user"
                            invisible="state != 'ready'"/>

                    <button name="action_generate_invoices"
                            type="object"
                            string="Create Invoices"
                            class="btn-warning"
                            invisible="state != 'confirmed'"
                            groups="account.group_account_user,account.group_account_invoice,atmta_real_estate.group_realestate_user"/>

                    <button name="action_activate"
                            type="object"
                            string="Activate"
                            class="btn-success"
                            groups="atmta_real_estate.group_realestate_user"
                            invisible="state != 'invoiced'"/>

                    <button name="action_terminate"
                            type="object"
                            string="Terminate"
                            class="btn-danger"
                            groups="atmta_real_estate.group_realestate_user"
                            invisible="state != 'active'"/>

                    <button name="action_reset_to_draft"
                            type="object"
                            string="Reset to Draft"
                            groups="atmta_real_estate.group_realestate_user"
                            class="btn-secondary"/>

                    <button name="action_open_report_wizard"
                            type="object"
                            groups="atmta_real_estate.group_realestate_user"
                            string="Print Contract Report"
                            class="btn-secondary"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,ready,confirmed,invoiced,active,expired,terminated"/>
                </header>
                <sheet>
                    <!-- Top Stats -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_payments"
                                icon="fa-line-chart"
                                type="object"
                                class="oe_stat_button m-1"
                                invisible="payment_count == 0">
                            <field string="Payments" name="payment_count" widget="statinfo"/>
                        </button>
                        <button name="action_get_invoices"
                                icon="fa-pencil-square-o"
                                type="object"
                                class="oe_stat_button m-1"
                                invisible="payment_count == 0">
                            <field string="Invoices" name="invoice_count" widget="statinfo"/>
                        </button>
                    </div>

                    <!-- Title -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group col="2">
                        <!-- ========== Contract Info Section ========== -->
                        <group string="Contract Information" col="2"
                               style="padding-right: 16px; border-right: 1px solid #f0f0f0;">
                            <field name="partner_id"/>
                            <field name="main_contract_no"/>
                            <field name="contract_no"/>
                            <field name="contract_type"/>
                            <field name="lessor_rep_id"/>
                            <field name="lessor_id"/>
                            <field name="issuer"/>
                            <field name="title_need_no"/>
                            <field name="place_of_issue"/>
                            <field name="issue_Date"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="notes"/>
                        </group>

                        <!-- ========== Sealing Info Section ========== -->
                        <group string="Sealing Information" col="2"
                               style="padding-right: 16px; border-right: 1px solid #f0f0f0;">
                            <field name="contract_sealing_location_id"/>
                            <field name="contract_sealing_date"/>
                            <field name="is_renewed" widget="boolean_toggle"/>
                            <field name="old_contract_id" invisible="is_renewed == False"/>
                                                        <field name="property_id"/>
                            <field name="property_type_id"/>
                            <field name="price"/>

                        </group>
                    </group>

                    <!-- ========== Property Settings Section ========== -->
                    <group string=" " col="2">

                        <!-- ✅ Manual Payment Toggle -->
                        <group string="Payment Configuration" col="2">
                            <field name="use_manual_payment"/>
                        </group>

                        <!-- ✅ Property Mode: Single or Multi -->
                        <group string="Property Mode" col="2" invisible="not use_manual_payment">
                            <field name="is_single_property"/>
                            <field name="is_multi_property"/>
                        </group>

                        <!-- ✅ Single Property Details -->
                        <group string="Single Property Details" col="2"
                               invisible="not use_manual_payment or not is_single_property">
                            <field name="payment_plan_ids" widget="many2many_tags"/>
                            <field name="increment_rule_ids" widget="many2many_tags"/>
                            <field name="discount_rule_ids" widget="many2many_tags"/>
                        </group>

                    </group>
                    <br/>
                    <br/>

                    <!-- Notebook Tabs -->
                    <notebook>
                        <!-- Contract Lines Tab -->
                        <page string="Contract Lines" invisible="not is_multi_property">
                            <field name="line_ids" widget="sol_o2m" mode="list,kanban">
                                <form string="Contract Line">
                                    <sheet>
                                        <group col="2">
                                            <field name="contract_id"/>
                                            <field name="property_id"/>
                                            <field name="start_date"/>
                                            <field name="end_date"/>
                                            <field name="payment_plan_ids" widget="many2many_tags"/>
                                            <field name="price"/>
                                        </group>
                                        <group>
                                            <field name="notes"/>
                                        </group>
                                    </sheet>
                                </form>

                                <list string="Contract Lines" editable="bottom">
                                    <field name="property_id" optional="show"/>
                                    <field name="property_type_id" optional="show"/>
                                    <field name="start_date" optional="show"/>
                                    <field name="end_date" optional="show"/>
                                    <field name="payment_plan_ids" widget="many2many_tags" options="{'no_create': True}"
                                           optional="show"/>
                                    <field name="increment_rule_ids" widget="many2many_tags"
                                           options="{'no_create': True}" optional="show"/>
                                    <field name="discount_rule_ids" widget="many2many_tags"
                                           options="{'no_create': True}" optional="show"/>
                                    <field name="price"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'active'"
                                           decoration-danger="state in ('terminated', 'expired')"
                                           decoration-info="state in ('confirmed', 'invoiced')"
                                           decoration-warning="state == 'ready'"
                                           decoration-muted="state == 'draft'"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>

                        <!-- Payment Schedules Tab -->
                        <page string="Payment Schedules">
                            <field name="contract_payment_ids">
                                <list editable="bottom">
                                    <field name="name" optional="show"/>
                                    <field name="label" optional="show"/>
                                    <field name="contract_id" optional="show"/>
                                    <field name="partner_id" optional="show"/>
                                    <field name="contract_line_id" invisible="not is_multi_property" optional="hide"/>
                                    <field name="property_id" optional="show"/>
                                    <field name="date_due" optional="show"/>
                                    <field name="amount" sum="Total Amount" optional="show"/>
                                    <field name="move_state" optional="show" widget="badge"
                                           decoration-success="move_state == 'posted'"
                                           decoration-warning="move_state == 'draft'"
                                           decoration-danger="move_state == 'cancel'"/>
                                    <field name="move_id" optional="show" widget="badge"
                                           decoration-success="move_state == 'posted'"
                                           decoration-warning="move_state == 'draft'"
                                           decoration-danger="move_state == 'cancel'"
                                    />
                                    <field name="payment_plan_id" optional="hide"/>
                                    <field name="increment_rule_ids" widget="many2many_tags" optional="hide"/>
                                    <field name="discount_rule_ids" widget="many2many_tags" optional="hide"/>
                                    <field name="increase_amount" sum="Total Increase Amount" optional="hide"/>
                                    <field name="discount_amount" sum="Total Discount Amount" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <!-- Utilities Tab -->
                        <page string="Utilities">
                            <field name="utility_line_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="bill_id"/>
                                    <field name="bill_paid" readonly="1"/>
                                </list>
                            </field>
                            <group>
                                <field name="total_utilities" readonly="1"/>
                                <field name="paid_utilities" readonly="1"/>
                                <field name="net_income" readonly="1"/>
                            </group>
                        </page>

                        <!-- Financial Summary Tab -->
                        <page string="Financial Summary">
                            <group string="Financial Summary" col="2" style="padding-left: 16px;">
                                <field name="total_scheduled" readonly="1"/>
                                <field name="total_paid" readonly="1"/>
                                <field name="balance_due" readonly="1"/>
                            </group>
                        </page>

                        <!-- Attachments Tab -->
                        <page string="Attachments">
                            <group string="Attachments">
                                <field name="attachment_ids" widget="many2many_binary"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="o_attachment_preview"/>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_realestate_contract_list" model="ir.ui.view">
        <field name="name">realestate.contract.list</field>
        <field name="model">realestate.contract</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="start_date" optional="show"/>
                <field name="end_date" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-danger="state in ('terminated', 'expired')"
                       decoration-info="state in ('confirmed', 'invoiced')"
                       decoration-warning="state == 'ready'"
                       decoration-muted="state == 'draft'" optional="show"/>
                <field name="is_renewed" optional="show"/>

            </list>
        </field>
    </record>

    <record id="view_contract_pivot" model="ir.ui.view">
        <field name="name">realestate.contract.pivot</field>
        <field name="model">realestate.contract</field>
        <field name="arch" type="xml">
            <pivot string="Contracts">
                <field name="state" type="row"/>
                <field name="partner_id" type="row"/>
                <field name="start_date" type="col"/>
                <field name="total_scheduled" type="measure"/>
                <field name="total_paid" type="measure"/>
                <field name="balance_due" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_realestate_contract_kanban" model="ir.ui.view">
        <field name="name">realestate.contract.kanban</field>
        <field name="model">realestate.contract</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_realestate_contract" default_order="start_date desc">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="start_date"/>
                <field name="end_date"/>

                <templates>
                    <t t-name="card" class="rounded shadow-sm">
                        <div class="oe_kanban_global_click ">
                            <div t-att-class="
                'border-start border-4 p-3 ' +
                (
                    record.state.raw_value == 'active' and 'border-success' or
                    record.state.raw_value in ['terminated', 'expired'] and 'border-danger' or
                    record.state.raw_value in ['confirmed', 'invoiced'] and 'border-primary' or
                    record.state.raw_value == 'ready' and 'border-warning' or
                    'border-secondary'
                )
            ">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong class="text-primary fs-6">
                                        <field name="name"/>
                                    </strong>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'active'"
                                           decoration-danger="state in ('terminated', 'expired')"
                                           decoration-info="state in ('confirmed', 'invoiced')"
                                           decoration-warning="state == 'ready'"
                                           decoration-muted="state == 'draft'"
                                           optional="show"/>
                                </div>

                                <div class="text-muted small mb-1">
                                    <i class="fa fa-user me-1 text-secondary"/>
                                    <span class="fw-semibold text-dark">
                                        <field name="partner_id"/>
                                    </span>
                                </div>

                                <div class="text-muted small">
                                    <i class="fa fa-calendar me-1 text-info"/>
                                    <field name="start_date"/>
                                    →
                                    <field name="end_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_realestate_contract_search" model="ir.ui.view">
        <field name="name">realestate.contract.search</field>
        <field name="model">realestate.contract</field>
        <field name="arch" type="xml">
            <search string="Real Estate Contracts">
                <!-- Default Filters -->
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Ready to Invoice" name="ready" domain="[('state', '=', 'ready')]"/>
                <filter string="Invoiced" name="invoiced" domain="[('state', '=', 'invoiced')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Terminated" name="terminated" domain="[('state', '=', 'terminated')]"/>

                <!-- Searchable Fields -->
                <field name="name"/>
                <field name="partner_id"/>
                <field name="property_id"/>
                <field name="property_type_id"/>
                <field name="state"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="is_single_property"/>
                <field name="is_multi_property"/>
                <field name="is_renewed"/>
                <field name="old_contract_id"/>

                <!-- Group By Options -->
                <group expand="1" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Tenant" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Property" name="group_property" context="{'group_by': 'property_id'}"/>
                    <filter string="Start Date" name="group_start_date" context="{'group_by': 'start_date'}"/>
                    <filter string="End Date" name="group_end_date" context="{'group_by': 'end_date'}"/>
                    <filter string="Property Type" name="group_type" context="{'group_by': 'property_type_id'}"/>
                    <filter string="Single vs Multi" name="group_single_multi"
                            context="{'group_by': 'is_single_property'}"/>
                </group>

                <!-- Advanced Filters -->
                <separator/>
                <field name="total_scheduled"/>
                <field name="total_paid"/>
                <field name="balance_due"/>
                <field name="total_utilities"/>
                <field name="paid_utilities"/>
                <field name="net_income"/>
            </search>
        </field>
    </record>


    <record id="action_realestate_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">realestate.contract</field>
        <field name="view_mode">kanban,list,form,pivot</field>
    </record>
</odoo>
