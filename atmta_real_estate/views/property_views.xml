<?xml version="1.0" encoding="UTF-8" ?>
<!--
  The Properties action as the Rental app presents it.

  The five base views this action opens moved to `atmta_property_core`, which
  owns `realestate.property`; they were only ever declared here because Rental
  happened to be the first module that needed them. The action stays: it is
  Rental's entry point, `views/rental_property_views.xml` adds the rental graph
  view to it, and `atmta_real_estate.action_property_view` is referenced by the
  menus and by other modules.
-->
<odoo>

    <record id="action_property_view" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">realestate.property</field>
        <field name="view_mode">kanban,list,form,hierarchy</field>
        <field name="view_ids" eval="[(5, 0, 0),
                    (0, 0, {'view_mode': 'kanban', 'view_id': ref('atmta_property_core.view_property_kanban')}),
                    (0, 0, {'view_mode': 'list', 'view_id': ref('atmta_property_core.view_property_list')}),
                    (0, 0, {'view_mode': 'form', 'view_id': ref('atmta_property_core.view_property_form')}),
                    (0, 0, {'view_mode': 'hierarchy', 'view_id': ref('atmta_property_core.view_property_hierarchy')})]"/>
        <field name="search_view_id" ref="atmta_property_core.view_property_search"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to define a new Property.
            </p>
        </field>
    </record>

</odoo>
