<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================= -->
    <!-- Renewals                                                       -->
    <!-- ============================================================= -->
    <record id="view_renewal_form" model="ir.ui.view">
        <field name="name">realestate.contract.renewal.form</field>
        <field name="model">realestate.contract.renewal</field>
        <field name="arch" type="xml">
            <form string="Lease Renewal">
                <header>
                    <button name="action_propose" type="object" string="Propose"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_negotiate" type="object" string="Negotiating"
                            invisible="state != 'proposed'"/>
                    <button name="action_approve" type="object" string="Approve Terms"
                            class="oe_highlight"
                            invisible="state not in ('proposed', 'negotiating')"
                            groups="atmta_real_estate.group_rental_manager"/>
                    <button name="action_accept" type="object"
                            string="Tenant Accepted" class="oe_highlight"
                            invisible="state != 'approved'"/>
                    <button name="action_create_renewal_lease" type="object"
                            string="Create Renewal Lease" class="oe_highlight"
                            invisible="state != 'accepted'"
                            groups="atmta_real_estate.group_rental_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state in ('renewed', 'rejected', 'expired')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,proposed,negotiating,approved,accepted,renewed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_new_contract" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not new_contract_id">
                            <span class="o_stat_text">Renewal Lease</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Current Lease">
                            <field name="contract_id" options="{'no_create': True}"/>
                            <field name="partner_id"/>
                            <field name="current_start_date"/>
                            <field name="current_end_date"/>
                            <field name="current_rent"/>
                        </group>
                        <group string="Proposed Terms">
                            <field name="proposed_start_date"/>
                            <field name="proposed_end_date"/>
                            <field name="proposed_term_months"/>
                            <field name="proposed_rent"/>
                            <field name="agreed_rent"/>
                            <field name="increase_amount"/>
                            <field name="increase_pct"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Carry Over">
                            <field name="copy_parties"/>
                            <field name="copy_charge_rules"/>
                            <field name="copy_escalations"/>
                        </group>
                        <group string="Ownership">
                            <field name="user_id"/>
                            <field name="decision_date"/>
                            <field name="new_contract_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Rejection Reason" invisible="state != 'rejected'">
                        <field name="rejection_reason" nolabel="1"/>
                    </group>
                    <field name="notes" placeholder="Negotiation notes…"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_renewal_list" model="ir.ui.view">
        <field name="name">realestate.contract.renewal.list</field>
        <field name="model">realestate.contract.renewal</field>
        <field name="arch" type="xml">
            <list string="Renewals">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="current_end_date"/>
                <field name="proposed_start_date"/>
                <field name="proposed_end_date"/>
                <field name="current_rent" optional="show"/>
                <field name="proposed_rent"/>
                <field name="increase_pct"/>
                <field name="user_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('renewed', 'accepted')"
                       decoration-danger="state in ('rejected', 'expired')"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_renewal_search" model="ir.ui.view">
        <field name="name">realestate.contract.renewal.search</field>
        <field name="model">realestate.contract.renewal</field>
        <field name="arch" type="xml">
            <search string="Renewals">
                <field name="name"/>
                <field name="contract_id" string="Lease"/>
                <field name="partner_id" string="Tenant"/>
                <field name="user_id" string="Responsible"/>
                <filter name="my_renewals" string="My Renewals" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="open" string="Open"
                        domain="[('state', 'in', ('draft', 'proposed', 'negotiating', 'approved', 'accepted'))]"/>
                <filter name="accepted" string="Accepted" domain="[('state', '=', 'accepted')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="renewed" string="Renewed" domain="[('state', '=', 'renewed')]"/>
                <group expand="0" string="Group By">
                    <filter name="gb_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="gb_user" string="Responsible" context="{'group_by': 'user_id'}"/>
                    <filter name="gb_end_month" string="Current End Month"
                            context="{'group_by': 'current_end_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_renewal_kanban" model="ir.ui.view">
        <field name="name">realestate.contract.renewal.kanban</field>
        <field name="model">realestate.contract.renewal</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column"
                    quick_create="false" group_create="false" records_draggable="false">
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="contract_id" class="fw-bold"/>
                            <field name="activity_ids" widget="kanban_activity"/>
                        </div>
                        <field name="partner_id"/>
                        <div class="text-muted">
                            Ends <field name="current_end_date"/>
                        </div>
                        <footer class="d-flex justify-content-between align-items-center">
                            <field name="proposed_rent" widget="monetary"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_renewals" model="ir.actions.act_window">
        <field name="name">Lease Renewals</field>
        <field name="res_model">realestate.contract.renewal</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No renewals in progress</p>
            <p>Renewals start from a lease that is expiring.</p>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- Expiry / renewal board (Phase 25)                              -->
    <!-- ============================================================= -->
    <record id="view_lease_expiry_kanban" model="ir.ui.view">
        <field name="name">realestate.contract.expiry.kanban</field>
        <field name="model">realestate.contract</field>
        <field name="arch" type="xml">
            <kanban default_group_by="expiry_bucket" class="o_kanban_small_column"
                    create="false" group_create="false">
                <field name="expiry_bucket"/>
                <field name="days_to_expiry"/>
                <field name="renewal_state"/>
                <field name="payment_status"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="partner_id"/>
                                </div>
                            </div>
                            <field name="activity_ids" widget="kanban_activity"/>
                        </div>
                        <div class="o_kanban_record_body">
                            <div>
                                <i class="fa fa-calendar me-1" title="Lease end date"/>
                                <field name="end_date"/>
                                <span class="ms-2 badge text-bg-secondary">
                                    <field name="days_to_expiry"/> days
                                </span>
                            </div>
                            <div>
                                <i class="fa fa-building me-1" title="Unit"/>
                                <field name="property_id"/>
                            </div>
                            <div t-if="record.renewal_state.raw_value">
                                <i class="fa fa-refresh me-1" title="Renewal status"/>
                                <field name="renewal_state"/>
                            </div>
                            <div t-if="record.payment_status.raw_value == 'overdue'"
                                 class="text-danger">
                                <i class="fa fa-exclamation-triangle me-1"
                                   title="Arrears"/>
                                <span>In arrears</span>
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left">
                                <field name="current_rent" widget="monetary"/>
                                <button name="action_start_renewal" type="object" string="Renew"
                                        class="btn btn-sm btn-primary ms-2"
                                        invisible="renewal_state"
                                        groups="atmta_real_estate.group_rental_agent"/>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="user_id" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- The board has its own search view: the lease search's status panel
         would repeat what the board's columns already show. -->
    <record id="view_lease_expiry_search" model="ir.ui.view">
        <field name="name">realestate.contract.expiry.search</field>
        <field name="model">realestate.contract</field>
        <field name="inherit_id" ref="view_realestate_contract_search"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//searchpanel" position="replace"/>
        </field>
    </record>

    <record id="action_lease_expiry_board" model="ir.actions.act_window">
        <field name="name">Expiry &amp; Renewal Board</field>
        <field name="res_model">realestate.contract</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_lease_expiry_kanban"/>
        <field name="search_view_id" ref="view_lease_expiry_search"/>
        <field name="domain">[('lifecycle_state', 'in', ('active', 'notice')), ('end_date', '!=', False)]</field>
        <field name="context">{'search_default_group_expiry': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No leases are approaching expiry.</p>
            <p>Leases move across this board as their end date approaches, so nothing
               expires without somebody having had the renewal conversation.</p>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- Amendments                                                     -->
    <!-- ============================================================= -->
    <record id="view_amendment_form" model="ir.ui.view">
        <field name="name">realestate.contract.amendment.form</field>
        <field name="model">realestate.contract.amendment</field>
        <field name="arch" type="xml">
            <form string="Lease Amendment">
                <header>
                    <button name="action_propose" type="object" string="Propose"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="oe_highlight" invisible="state != 'proposed'"
                            groups="atmta_real_estate.group_rental_manager"/>
                    <button name="action_sign" type="object" string="Mark Signed"
                            class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_apply" type="object" string="Apply"
                            class="oe_highlight" invisible="state != 'signed'"
                            groups="atmta_real_estate.group_rental_manager"
                            confirm="Applying an amendment changes the lease from its effective date and re-cuts the un-invoiced schedule. Continue?"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('applied', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,proposed,approved,signed,applied"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Amendment">
                            <field name="contract_id" options="{'no_create': True}"/>
                            <field name="partner_id"/>
                            <field name="amendment_type"/>
                            <field name="effective_date"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Change">
                            <field name="new_rent"
                                   invisible="amendment_type != 'rent_change'"
                                   required="amendment_type == 'rent_change'"/>
                            <field name="new_end_date"
                                   invisible="amendment_type not in ('term_extension', 'term_reduction')"
                                   required="amendment_type in ('term_extension', 'term_reduction')"/>
                            <field name="property_id"
                                   invisible="amendment_type not in ('property_addition', 'property_removal')"
                                   required="amendment_type in ('property_addition', 'property_removal')"/>
                            <field name="property_rent"
                                   invisible="amendment_type != 'property_addition'"/>
                            <field name="new_partner_id"
                                   invisible="amendment_type != 'party_change'"
                                   required="amendment_type == 'party_change'"/>
                            <field name="new_deposit_amount"
                                   invisible="amendment_type != 'deposit_change'"
                                   required="amendment_type == 'deposit_change'"/>
                        </group>
                    </group>
                    <group string="Reason">
                        <field name="reason" nolabel="1"
                               placeholder="Why is the lease being amended?"/>
                    </group>
                    <group string="History" invisible="state != 'applied'">
                        <field name="previous_value" readonly="1"/>
                        <field name="new_value" readonly="1"/>
                        <field name="applied_date" readonly="1"/>
                    </group>
                    <group>
                        <group string="Governance">
                            <field name="approver_id" readonly="1"/>
                            <field name="approval_date" readonly="1"/>
                            <field name="signed_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="document_ids" widget="many2many_binary"/>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_amendment_list" model="ir.ui.view">
        <field name="name">realestate.contract.amendment.list</field>
        <field name="model">realestate.contract.amendment</field>
        <field name="arch" type="xml">
            <list string="Amendments">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="amendment_type"/>
                <field name="effective_date"/>
                <field name="reason" optional="show"/>
                <field name="approver_id" optional="show"/>
                <field name="applied_date" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'applied'"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_amendment_search" model="ir.ui.view">
        <field name="name">realestate.contract.amendment.search</field>
        <field name="model">realestate.contract.amendment</field>
        <field name="arch" type="xml">
            <search string="Amendments">
                <field name="name"/>
                <field name="contract_id" string="Lease"/>
                <field name="partner_id" string="Tenant"/>
                <field name="property_id" string="Unit"/>
                <filter name="open" string="Open"
                        domain="[('state', 'in', ('draft', 'proposed', 'approved', 'signed'))]"/>
                <separator/>
                <filter name="proposed" string="Proposed" domain="[('state', '=', 'proposed')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="signed" string="Signed" domain="[('state', '=', 'signed')]"/>
                <filter name="applied" string="Applied" domain="[('state', '=', 'applied')]"/>
                <group expand="0" string="Group By">
                    <filter name="gb_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="gb_type" string="Type" context="{'group_by': 'amendment_type'}"/>
                    <filter name="gb_lease" string="Lease" context="{'group_by': 'contract_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_amendments" model="ir.actions.act_window">
        <field name="name">Lease Amendments</field>
        <field name="res_model">realestate.contract.amendment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No amendments</p>
            <p>Amendments change a lease's rent, term or units. Start one from the lease.</p>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- Terminations                                                   -->
    <!-- ============================================================= -->
    <record id="view_termination_form" model="ir.ui.view">
        <field name="name">realestate.contract.termination.form</field>
        <field name="model">realestate.contract.termination</field>
        <field name="arch" type="xml">
            <form string="Lease Termination">
                <header>
                    <button name="action_give_notice" type="object"
                            string="Record Notice" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="oe_highlight" invisible="state != 'notice_given'"
                            groups="atmta_real_estate.group_rental_manager"/>
                    <field name="can_post_accounting" invisible="1"/>
                    <button name="action_settle" type="object" string="Settle"
                            class="oe_highlight" invisible="state != 'approved' or not can_post_accounting"
                            groups="atmta_real_estate.group_rental_manager"
                            confirm="Settlement cancels un-invoiced obligations after the termination date, issues credit notes for invoiced ones, and raises the final invoice. Continue?"/>
                    <button name="action_complete" type="object" string="Complete"
                            class="oe_highlight" invisible="state != 'settled'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('settled', 'completed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,notice_given,approved,settled,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <widget name="web_ribbon" title="Early Termination"
                            bg_color="text-bg-warning" invisible="not is_early"/>
                    <group>
                        <group string="Lease">
                            <field name="contract_id" options="{'no_create': True}"/>
                            <field name="partner_id"/>
                            <field name="is_early"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Notice">
                            <field name="request_date"/>
                            <field name="requested_by"/>
                            <field name="requested_end_date"/>
                            <field name="effective_date"/>
                            <field name="notice_period_days"/>
                            <field name="notice_given_days"/>
                            <field name="notice_shortfall_days"
                                   decoration-danger="notice_shortfall_days &gt; 0"/>
                            <field name="reason"/>
                        </group>
                    </group>
                    <group>
                        <group string="Settlement">
                            <field name="outstanding_balance"/>
                            <field name="penalty_amount"/>
                            <field name="penalty_waived"/>
                            <field name="penalty_net"/>
                            <field name="utility_settlement"/>
                            <field name="final_charges"/>
                            <field name="deposit_held"/>
                            <field name="net_settlement" decoration-bf="1"/>
                        </group>
                        <group string="Outcome">
                            <field name="deposit_treatment"/>
                            <field name="final_invoice_id" readonly="1"/>
                            <field name="credit_note_ids" widget="many2many_tags" readonly="1"
                                   groups="account.group_account_invoice,account.group_account_readonly"/>
                            <field name="move_out_id" readonly="1"/>
                            <field name="property_available_date" readonly="1"/>
                            <field name="approver_id" readonly="1"/>
                            <field name="approval_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Waiver Reason" invisible="not penalty_waived">
                        <field name="waiver_reason" nolabel="1"
                               placeholder="Why is the penalty being waived?"/>
                    </group>
                    <group string="Reason">
                        <field name="reason_note" nolabel="1"/>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_termination_list" model="ir.ui.view">
        <field name="name">realestate.contract.termination.list</field>
        <field name="model">realestate.contract.termination</field>
        <field name="arch" type="xml">
            <list string="Terminations">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="effective_date"/>
                <field name="reason"/>
                <field name="is_early" optional="show"/>
                <field name="notice_shortfall_days" optional="hide"/>
                <field name="penalty_net" optional="show"/>
                <field name="net_settlement"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_termination_search" model="ir.ui.view">
        <field name="name">realestate.contract.termination.search</field>
        <field name="model">realestate.contract.termination</field>
        <field name="arch" type="xml">
            <search string="Terminations">
                <field name="name"/>
                <field name="contract_id" string="Lease"/>
                <field name="partner_id" string="Tenant"/>
                <filter name="open" string="Open"
                        domain="[('state', 'in', ('draft', 'notice_given', 'approved', 'settled'))]"/>
                <separator/>
                <filter name="notice_given" string="Notice Given" domain="[('state', '=', 'notice_given')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="settled" string="Settled" domain="[('state', '=', 'settled')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <group expand="0" string="Group By">
                    <filter name="gb_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="gb_reason" string="Reason" context="{'group_by': 'reason'}"/>
                    <filter name="gb_effective_month" string="Effective Month"
                            context="{'group_by': 'effective_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_terminations" model="ir.actions.act_window">
        <field name="name">Lease Terminations</field>
        <field name="res_model">realestate.contract.termination</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No terminations</p>
            <p>A termination handles notice, settlement, the deposit and the move-out.
                Start one from a live lease.</p>
        </field>
    </record>

</odoo>
