<templates>
    <t t-name="kanban-box">
        <div t-att-class="'oe_kanban_global_click position-relative h-100' + (record.is_favorite.raw_value ? ' oe_kanban_card_favorite' : '')">
            <!-- Full-height status indicator -->
            <div class="position-absolute top-0 start-0 bottom-0"
                 t-attf-style="width: 4px; background-color: #{
                    record.state.raw_value == 'rented' and 'var(--success)' or
                    record.state.raw_value == 'available' and 'var(--info)' or
                    record.state.raw_value == 'inactive' and 'var(--danger)' or
                    record.state.raw_value == 'maintenance' and 'var(--warning)' or
                    '#dee2e6'
                 }">
            </div>

            <!-- Main container with no padding -->
            <div class="d-flex h-100 w-100" style="margin-left: 4px;">
                <!-- Main Content -->
                <div class="flex-grow-1 pe-2" style="min-width: 0; overflow: hidden;">
                    <!-- Header Row -->
                    <div class="d-flex align-items-center mb-1">
                        <field name="is_favorite" widget="boolean_favorite" nolabel="1" class="me-1"/>
                        <h5 class="mb-0 fw-bold text-truncate" style="max-width: 200px;">
                            <field name="name" class="oe_kanban_card_title"/>
                        </h5>
                    </div>

                    <!-- Property Details -->
                    <div class="d-flex flex-column gap-1">
                        <div class="d-flex align-items-center">
                            <span class="text-muted small">Type:</span>
                            <div class="ms-1 text-truncate" style="max-width: 150px;">
                                <field name="property_type_id" widget="badge"
                                       decoration-success="state in 'rented'"
                                       decoration-danger="state in ('inactive')"
                                       decoration-info="state in ('available')"
                                       decoration-warning="state in ('maintenance','reserved')"
                                       class="badge"/>
                            </div>
                        </div>

                        <div class="d-flex align-items-center">
                            <span class="text-muted small">Status:</span>
                            <div class="ms-1">
                                <field name="state" widget="badge"
                                       decoration-success="state in 'rented'"
                                       decoration-danger="state == 'inactive'"
                                       decoration-info="state in ('available')"
                                       decoration-warning="state in ('maintenance','reserved')"
                                       class="badge"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Image - flush right -->
                <div class="flex-shrink-0 d-flex align-items-stretch" style="width: 150px;">
                    <field name="image_128" widget="image"
                           options="{'img_class': 'img-fluid rounded border object-fit-cover w-100 h-100'}"
                           invisible="not image_128"
                           alt="Property Image"
                           class="h-100 w-100"/>
                </div>
            </div>
        </div>
    </t>
</templates>
            </kanban>
        </field>
    </record>


    <record id="action_property_view" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">kanban,list,form,graph,hierarchy</field>
        <field name="view_ids" eval="[(5, 0, 0),(0, 0, {'view_mode': 'kanban', 'view_id': ref('atmta_real_estate.property_product_kanban_view')}), (0, 0, {'view_mode': 'list', 'view_id': ref('atmta_real_estate.view_property_list')}),
                    (0, 0, {'view_mode': 'form', 'view_id': ref('atmta_real_estate.view_property_form')})]"/>
        <field name="context">
            {"search_default_property":1,"default_type":"service","default_is_property":True,"default_detailed_type":"service"}
        </field>
        <field name="search_view_id" ref="view_property_product_search"/>

        <field name="domain">[('is_property','=',True)]</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to define a new Property.
            </p>
            <p>
                You must define a Property for everything you buy or sell,
            </p>
        </field>
    </record>


