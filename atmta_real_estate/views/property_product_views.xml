<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_property_form" model="ir.ui.view">
        <field name="name">product.product.realestate.form</field>
        <field name="model">product.product</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="set_property_inactive" type="object" string="Set Inactive" invisible="state in ('reserved','rented', 'maintenance', 'inactive')"/>
                    <button name="set_property_available" type="object" string="Set To Available" invisible="state not in ('inactive')"/>
                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="is_property" widget="boolean_toggle"/>
                            <field name="property_type_id"/>
<!--                            <field name="state"/>-->
                        </group>
                    </group>
                    <notebook>
                        <page string="Property Hierarchy">
                            <group>
                                <group string="Hierarchy">
                                    <field name="child_ids" invisible="1"/>
                                    <field name="is_parent_child" invisible="1"/>
                                    <field name="parent_id" domain="[('is_property', '=', True),('id','!=',id)]"/>
                                </group>
                                <group>
                                    <field name="child_ids" class="position-relative" widget="org_chart" nolabel="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="General Info">
                            <group col="2">
                                <group string="Basic Details">
                                    <field name="property_ref"/>
                                    <field name="property_number"/>
                                    <field name="furnished_status"/>
                                    <field name="area_sqm"/>
                                    <field name="floor_number"/>
                                </group>
                                <group string="Rooms Layout">
                                    <field name="bedroom_count"/>
                                    <field name="bathroom_count"/>
                                    <field name="living_room_count"/>
                                    <field name="has_kitchen" widget="boolean_toggle"/>
                                    <field name="has_balcony" widget="boolean_toggle"/>
                                </group>
                            </group>
                            <group string="Notes">
                                <field name="property_notes"/>
                            </group>
                        </page>

                        <page string="Location">
                            <group col="2">
                                <group string="General Area">
                                    <field name="country_id"/>
                                    <field name="city"/>
                                    <field name="district"/>
                                </group>
                                <group string="Exact Location">
                                    <field name="sub_area"/>
                                    <field name="street_name"/>
                                    <field name="building_no"/>
                                    <field name="landmark"/>
                                </group>
                            </group>
                            <group string="Map Preview">
                                <field name="gmap_url" widget="embed_map_viewer"/>
                            </group>
                        </page>

                        <page string="Ownership">
                            <group col="2">
                                <group string="Ownership Details">
                                    <field name="owner_id"/>
                                    <field name="is_internal" widget="boolean_toggle"/>
                                </group>
                                <group string="Management">
                                    <field name="manager_id"/>
                                    <field name="next_available_date"/>
                                </group>
                            </group>
                        </page>
                        <page string="Contract History">
                            <field name="contract_history_ids">
                                <list create="0" edit="0">
                                    <field name="contract_id" optional="show"/>
                                    <field name="partner_id" optional="show"/>
                                    <!--                                    <field name="property_id" optional="show"/>-->
                                    <field name="start_date" optional="show"/>
                                    <field name="end_date" optional="show"/>
                                    <field name="payment_plan_ids" widget="many2many_tags" options="{'no_create': True}"
                                           optional="show"/>
                                    <field name="increment_rule_ids" widget="many2many_tags"
                                           options="{'no_create': True}"
                                           optional="show"/>
                                    <field name="discount_rule_ids" widget="many2many_tags"
                                           options="{'no_create': True}"
                                           optional="show"/>
                                    <field name="price" optional="show"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'active'"
                                           decoration-danger="state in ('terminated', 'expired')"
                                           decoration-info="state in ('confirmed', 'invoiced')"
                                           decoration-warning="state == 'ready'"
                                           decoration-muted="state == 'draft'" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Rental Stats">
                            <group col="2">
                                <group string="Rental History">
                                    <field name="rent_count" readonly="1"/>
                                    <field name="total_rent_months" readonly="1"/>
                                    <field name="actual_rent_months" readonly="1"/>
                                </group>
                                <group string="Revenue Summary">
                                    <field name="revenue_collected" readonly="1"/>
                                    <field name="revenue_expected" readonly="1"/>
                                    <field name="total_amount_due" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Media">
                            <group string="Images and Videos">
                                <field
                                        name="property_Attachment_media_ids"
                                        class="o_website_sale_image_list"
                                        context="{'default_name': name}"
                                        mode="kanban"
                                        add-label="Add Media"
                                        nolabel="1"
                                        widget="x2_many_media_viewer"
                                        options="{'convert_to_webp': True}"
                                />
                            </group>
                        </page>
                        <page string="Attachments">
                            <group string="Attachments">
                                <div class="d-flex align-items-center gap-3">
                                    <field name="attachment_ids" widget="many2many_binary" class="m-0"/>
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
                <div class="o_attachment_preview"/>

            </form>
        </field>
    </record>

    <record id="view_property_list" model="ir.ui.view">
        <field name="name">product.product.realestate.list</field>
        <field name="model">product.product</field>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="property_type_id" optional="show"/>
                <field name="state" optional="show"/>
                <field name="area_sqm" optional="show"/>
                <field name="bedroom_count" optional="show"/>
                <field name="bathroom_count" optional="show"/>
                <field name="manager_id" optional="show"/>
                <field name="is_property" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_property_product_search" model="ir.ui.view">
        <field name="name">product.product.realestate.search</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <!-- Quick text fields -->
                <field name="name" string="Name"/>
                <field name="property_ref" string="Reference"/>
                <field name="property_number" string="Number"/>
                <field name="city"/>
                <field name="district"/>
                <field name="sub_area"/>
                <field name="street_name"/>
                <field name="landmark"/>

                <!-- Filters -->
                <filter name="available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="rented" string="Rented" domain="[('state', '=', 'rented')]"/>
                <filter name="reserved" string="Reserved" domain="[('state', '=', 'reserved')]"/>
                <filter name="maintenance" string="Under Maintenance" domain="[('state', '=', 'maintenance')]"/>
                <filter name="inactive" string="Inactive" domain="[('state', '=', 'inactive')]"/>
                <filter name="internal_assets" string="Company-Owned" domain="[('is_internal', '=', True)]"/>
                <filter name="has_balcony" string="Has Balcony" domain="[('has_balcony', '=', True)]"/>
                <filter name="has_kitchen" string="Has Kitchen" domain="[('has_kitchen', '=', True)]"/>

                <!-- Group by options -->
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Property Type" context="{'group_by': 'property_type_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_city" string="City" context="{'group_by': 'city'}"/>
                    <filter name="group_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
                    <filter name="group_manager" string="Manager" context="{'group_by': 'manager_id'}"/>
                    <filter name="group_furnished" string="Furnished" context="{'group_by': 'furnished_status'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="product_product_view_hierarchy" model="ir.ui.view">
        <field name="name">product.product.view.hierarchy</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <hierarchy child_field="child_ids"
                       draggable="1">
                <field name="name"/>
                <templates>
                    <t t-name="hierarchy-box">
                        <div t-attf-class="o_hierarchy_node_header d-flex justify-content-center pb-4"
                             t-att-title="parent_id">
                        </div>
                        <div class="o_hierarchy_node_body d-flex flex-column text-center">
                            <div class="w-100 position-relative">
                                <field class="fw-bold" name="name"/>
                                <br/>
                            </div>
                        </div>
                    </t>
                </templates>
            </hierarchy>
        </field>
    </record>
    <record id="view_realestate_property_graph" model="ir.ui.view">
        <field name="name">product.product.graph</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <graph string="Property Rent Summary" type="bar">
                <field name="name" type="row"/>
                <field name="revenue_collected" type="measure"/>
                <field name="revenue_expected" type="measure"/>
                <field name="total_rent_months" type="measure"/>
                <field name="actual_rent_months" type="measure"/>
            </graph>
        </field>
    </record>

