<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_contract_form_inherit_deposit" model="ir.ui.view">
        <field name="name">realestate.contract.form.deposit</field>
        <field name="model">realestate.contract</field>
        <field name="inherit_id" ref="view_realestate_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <!-- Only on leases that still hold legacy deposit data. -->
                <page string="Security Deposit (history)" name="deposit"
                      invisible="deposit_state == 'none' and not deposit_amount">
                    <div class="alert alert-info" role="status">
                        Deposits are managed on the lease's Security Deposit records
                        (Deposits smart button). These fields are kept as history.
                    </div>
                    <group>
                        <group>
                            <field name="deposit_state" widget="badge"
                                   decoration-info="deposit_state == 'held'"
                                   decoration-success="deposit_state == 'refunded'"
                                   decoration-warning="deposit_state == 'partial_refund'"
                                   decoration-danger="deposit_state == 'forfeited'"/>
                            <field name="deposit_amount" readonly="1"/>
                            <field name="deposit_paid_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="deposit_refund_amount" readonly="1"/>
                            <field name="deposit_forfeit_amount" readonly="1"/>
                            <field name="deposit_settled_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="deposit_notes" nolabel="1" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
