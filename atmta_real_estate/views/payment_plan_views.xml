<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- list View -->
    <record id="view_payment_plan_list" model="ir.ui.view">
        <field name="name">realestate.payment.plan.list</field>
        <field name="model">realestate.payment.plan</field>
        <field name="arch" type="xml">
            <list>
<!--                <field name="contract_line_id"/>-->
                <field name="start_month"/>
                <field name="unit"/>
                <field name="interval"/>
<!--                <field name="payment_plans_ids" widget="many2many_tags"/>-->
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_payment_plan_form" model="ir.ui.view">
        <field name="name">realestate.payment.plan.form</field>
        <field name="model">realestate.payment.plan</field>
        <field name="arch" type="xml">
            <form string="Payment Plan Rule">
                <sheet>
                <group col="2">
<!--                    <field name="contract_line_id"/>-->
                    <field name="start_month"/>
                    <field name="unit"/>
                    <field name="interval"/>
                </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_payment_plan" model="ir.actions.act_window">
        <field name="name">Payment Plans</field>
        <field name="res_model">realestate.payment.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage payment plan intervals per contract line.
            </p>
        </field>
    </record>

</odoo>
