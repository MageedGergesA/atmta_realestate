<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- list View -->
    <record id="view_contract_line_list" model="ir.ui.view">
        <field name="name">realestate.contract.line.list</field>
        <field name="model">realestate.contract.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="property_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="payment_plan_ids"/>
                <field name="price"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-danger="state in ('terminated', 'expired')"
                       decoration-info="state in ('confirmed', 'invoiced')"
                       decoration-warning="state == 'ready'"
                       decoration-muted="state == 'draft'"/>

            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_contract_line_form" model="ir.ui.view">
        <field name="name">realestate.contract.line.form</field>
        <field name="model">realestate.contract.line</field>
        <field name="arch" type="xml">
            <form string="Contract Line" create="0" edit="0">
                <header>
                    <button name="action_terminate_line"
                            type="object"
                            string="Terminate"
                            class="btn-danger"
                            invisible="state != 'active'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,ready,confirmed,invoiced,active,expired,terminated"/>
                </header>
                <sheet>
                    <group col="2">
                        <field name="contract_id"/>
                        <field name="partner_id"/>
                        <field name="property_id"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="payment_plan_ids" widget="many2many_tags"/>
                        <field name="price"/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_contract_line" model="ir.actions.act_window">
        <field name="name">Contract Lines</field>
        <field name="res_model">realestate.contract.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create and manage individual property contract lines.
            </p>
        </field>
    </record>
</odoo>
