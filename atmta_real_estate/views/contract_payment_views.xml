<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- List View -->
    <record id="view_contract_payment_tree" model="ir.ui.view">
        <field name="name">realestate.contract.payment.tree</field>
        <field name="model">realestate.contract.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="label" optional="hide"/>
                <field name="contract_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="property_id" optional="show"/>
                <field name="date_due" optional="show"/>
                <field name="amount" sum="Total Base Amount" optional="show"/>
                <field name="amount_total" sum="Total Due" optional="show"/>
                <field name="move_state" optional="show" widget="badge"
                       decoration-success="move_state == 'posted'"
                       decoration-warning="move_state == 'draft'"
                       decoration-danger="move_state == 'cancel'"/>
                <field name="move_id" optional="show" widget="badge"
                       decoration-success="move_state == 'posted'"
                       decoration-warning="move_state == 'draft'"
                       decoration-danger="move_state == 'cancel'"
                />
                <field name="increment_rule_ids" widget="many2many_tags" optional="hide"/>
                <field name="discount_rule_ids" widget="many2many_tags" optional="hide"/>
                <field name="increase_amount" sum="Total Increase Amount" optional="hide"/>
                <field name="discount_amount" sum="Total Discount Amount" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_contract_payment_form" model="ir.ui.view">
        <field name="name">realestate.contract.payment.form</field>
        <field name="model">realestate.contract.payment</field>
        <field name="arch" type="xml">
            <form string="Billing Obligation">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="True"/>
                        </h1>
                        <!--                        <hr/>-->
                    </div>
                    <group>
                        <group string="Lease" col="2" style="border-right:1px solid #f5f5f5;">
                            <field name="label"/>
                            <field name="contract_id"/>
                            <field name="partner_id"/>
                            <field name="property_id"/>
                        </group>

                        <!-- Retired legacy price rules (batch 4 carried them over to rent
                             escalations and incentives). Kept visible only on obligations
                             that still record them, as history. -->
                        <group name="legacy_price_rules" string="Legacy Price Rules" col="2"
                               invisible="not increment_rule_ids and not discount_rule_ids">
                            <field name="increment_rule_ids" widget="many2many_tags" readonly="1"/>
                            <field name="discount_rule_ids" widget="many2many_tags" readonly="1"/>
                        </group>

                        <group string="Schedule Details" col="2" style="border-right:1px solid #f5f5f5;">
                            <field name="date_due"/>
                            <field name="date_due_deadline"/>
                            <field name="hijri_date_due"/>
                            <field name="hijri_date_due_deadline"/>
                            <field name="amount"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="move_id" readonly="1"/>
                        </group>

                        <group string="Price Breakdown" col="2">
                            <field name="increase_amount" readonly="1" optional="show"/>
                            <field name="discount_amount" readonly="1" optional="show"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Additional Charges">
                            <field name="charge_line_ids">
                                <list editable="bottom">
                                    <field name="charge_type"/>
                                    <field name="name"/>
                                    <field name="product_id" optional="show"/>
                                    <field name="maintenance_request_id" optional="hide" readonly="1"/>
                                    <field name="amount" sum="Total Charges"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_contract_payment_pivot" model="ir.ui.view">
        <field name="name">realestate.contract.payment.pivot</field>
        <field name="model">realestate.contract.payment</field>
        <field name="arch" type="xml">
            <pivot string="Billing Obligations">
                <field name="contract_id" type="row"/>
                <field name="property_id" type="row"/>
                <field name="date_due" type="col"/>
                <field name="state" type="col"/>
                <field name="amount" type="measure"/>
                <field name="amount_total" type="measure"/>
                <field name="increase_amount" type="measure"/>
                <field name="discount_amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_realestate_contract_payment_search" model="ir.ui.view">
        <field name="name">realestate.contract.payment.search</field>
        <field name="model">realestate.contract.payment</field>
        <field name="arch" type="xml">
            <search string="Billing Obligations">
                <!-- Quick Search Fields -->
                <field name="name" string="Reference"/>
                <field name="label" string="Label"/>
                <field name="amount"/>
                <field name="amount_total"/>
                <field name="date_due"/>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="property_id"/>
                <field name="state"/>
                <field name="move_state"/>
                <field name="discount_amount"/>
                <field name="increase_amount"/>

                <!-- Filters -->
                <filter name="draft" string="Unpaid" domain="[('state', '=', 'draft')]"/>
                <filter name="invoiced" string="Invoiced" domain="[('state', '=', 'invoiced')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>

                <separator/>

                <!-- Filters on invoice state -->
                <filter name="invoice_draft" string="Invoice Draft" domain="[('move_state', '=', 'draft')]"/>
                <filter name="invoice_posted" string="Invoice Posted" domain="[('move_state', '=', 'posted')]"/>
                <filter name="invoice_cancel" string="Invoice Cancelled" domain="[('move_state', '=', 'cancel')]"/>

                <separator/>

                <!-- Group By -->
                <group expand="1" string="Group By">
                    <filter name="group_contract" string="Contract" context="{'group_by': 'contract_id'}"/>
                    <filter name="group_partner" string="Tenant/Partner" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_property" string="Property" context="{'group_by': 'property_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_invoice_state" string="Invoice State" context="{'group_by': 'move_state'}"/>
                    <filter name="group_due_date" string="Due Date" context="{'group_by': 'date_due'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_realestate_contract_payment_calendar" model="ir.ui.view">
        <field name="name">realestate.contract.payment.calendar</field>
        <field name="model">realestate.contract.payment</field>
        <field name="arch" type="xml">
            <calendar string="Billing Obligations" date_start="date_due" color="state" mode="month" create="0" edit="0">
                <field name="name"/>
                <field name="amount"/>
                <field name="partner_id"/>
            </calendar>
        </field>
    </record>

    <record id="action_contract_payment" model="ir.actions.act_window">
        <field name="name">Billing Obligations</field>
        <field name="res_model">realestate.contract.payment</field>
        <field name="view_mode">list,form,calendar,pivot</field>
    </record>
</odoo>
