<!--              parent="real_estate_menu_root"-->
<!--              sequence="10"/>-->

    <menuitem id="menu_property_list"
              name="All Properties"
              parent="atmta_real_estate.real_estate_menu_root"
              action="atmta_real_estate.action_property_view"
              sequence="1"/>

    <menuitem id="menu_property_type"
