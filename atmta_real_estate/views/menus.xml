<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Main Application Menu -->
    <menuitem id="real_estate_menu_root"
              name="Real Estate"
              web_icon="atmta_real_estate,static/description/icon.png"
              sequence="10"/>

    <!-- ========== PROPERTIES SECTION ========== -->
    <menuitem id="menu_property_management"
              name="Properties"
              parent="real_estate_menu_root"
              sequence="10"/>

    <menuitem id="menu_property_list"
              name="All Properties"
              parent="menu_property_management"
              action="atmta_real_estate.action_property_view"
              sequence="10"/>

    <menuitem id="menu_property_types"
              name="Property Types"
              parent="menu_property_management"
              action="atmta_real_estate.action_property_type"
              sequence="20"/>

    <!-- ========== CONTRACTS SECTION ========== -->
    <menuitem id="menu_contract_management"
              name="Contracts"
              parent="real_estate_menu_root"
              sequence="20"/>

    <menuitem id="menu_contract_list"
              name="All Contracts"
              parent="menu_contract_management"
              action="atmta_real_estate.action_realestate_contract"
              sequence="10"/>

    <menuitem id="menu_contract_units"
              name="Contract Units"
              parent="menu_contract_management"
              action="atmta_real_estate.action_contract_line"
              sequence="20"/>

    <menuitem id="menu_payment_schedules"
              name="Payment Schedules"
              parent="menu_contract_management"
              action="atmta_real_estate.action_contract_payment"
              sequence="30"/>

    <!-- ========== MAINTENANCE SECTION ========== -->
    <menuitem id="menu_maintenance_management"
              name="Maintenance"
              parent="real_estate_menu_root"
              sequence="30"/>

    <menuitem id="menu_maintenance_requests"
              name="Requests"
              parent="menu_maintenance_management"
              action="atmta_real_estate.action_maintenance_requests"
              sequence="10"/>

    <!-- ========== UTILITIES SECTION ========== -->
    <menuitem id="menu_utilities_management"
              name="Utilities"
              parent="real_estate_menu_root"
              action="atmta_real_estate.action_utility_lines"
              sequence="40"/>

    <!-- ========== REPORTS SECTION ========== -->
    <menuitem id="menu_reports"
              name="Reports"
              parent="real_estate_menu_root"
              sequence="100"/>

    <menuitem id="menu_contract_reports"
              name="Contract Reports"
              parent="menu_reports"
              sequence="10"/>

    <menuitem id="menu_contract_pivot_report"
              name="Contract Overview"
              parent="menu_contract_reports"
              action="atmta_real_estate.action_realestate_contract_pivot_report"
              sequence="10"/>

    <menuitem id="menu_contract_line_report"
              name="Unit Analysis"
              parent="menu_contract_reports"
              action="atmta_real_estate.action_contract_line_pivot"
              sequence="20"/>

    <!-- ========== CONFIGURATION SECTION ========== -->
    <menuitem id="menu_configuration"
              name="Settings"
              parent="real_estate_menu_root"
              sequence="200"/>

    <menuitem id="menu_payment_plans"
              name="Payment Plans"
              parent="menu_configuration"
              action="atmta_real_estate.action_payment_plan"
              sequence="10"/>

    <menuitem id="menu_price_adjustment_rules"
              name="Price Adjustment Rules"
              parent="menu_configuration"
              action="atmta_real_estate.action_contract_increment_rule"
              sequence="20"/>

</odoo>