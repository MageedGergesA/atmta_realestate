#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/contract_increment_rule.py:0
msgid "\"%s\" applies from the lease start; set it as the base rent instead."
msgstr "\"%s\" يسري من بداية العقد؛ اجعله الإيجار الأساسي بدلًا من ذلك."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/contract_increment_rule.py:0
msgid "\"%s\" falls on a date that already has an escalation."
msgstr "\"%s\" يقع في تاريخ توجد فيه زيادة إيجار بالفعل."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/contract_increment_rule.py:0
msgid "\"%s\" has no end date to carry over."
msgstr "\"%s\" ليس له تاريخ نهاية لترحيله."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/contract_increment_rule.py:0
msgid "\"%s\" is a temporary increase; rent escalations are permanent."
msgstr "\"%s\" زيادة مؤقتة؛ بينما زيادات الإيجار دائمة."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/contract_increment_rule.py:0
msgid "\"%s\" is not a percentage between 0 and 100."
msgstr "\"%s\" ليست نسبة مئوية بين 0 و100."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/contract_increment_rule.py:0
msgid "\"%s\" would start after the lease ends."
msgstr "\"%s\" سيبدأ بعد انتهاء العقد."

