#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/contract_termination.py:0
msgid ""
"Lease %(lease)s already has termination %(other)s in progress. Continue that"
" one, or cancel it first."
msgstr ""
"عقد الإيجار %(lease)s لديه بالفعل إنهاء قيد التنفيذ %(other)s. أكمل ذلك "
"الإنهاء أو ألغه أولًا."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/contract_lifecycle.py:0
msgid ""
"Lease %(lease)s is %(status)s. Only a lease awaiting signature, active or on"
" notice can be amended."
msgstr ""
"حالة عقد الإيجار %(lease)s هي %(status)s. لا يمكن تعديل إلا العقد بانتظار "
"التوقيع أو الساري أو الذي تم تقديم إشعار عليه."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/contract_lifecycle.py:0
msgid ""
"Lease %(lease)s is on notice through termination %(termination)s. Cancel "
"that termination to withdraw the notice."
msgstr ""
"عقد الإيجار %(lease)s في فترة الإشعار بموجب الإنهاء %(termination)s. ألغِ "
"ذلك الإنهاء لسحب الإشعار."

#. module: atmta_real_estate
#: model_terms:ir.ui.view,arch_db:atmta_real_estate.view_realestate_contract_wizard_form
msgid "Lease & Documents"
msgstr "العقد والمستندات"

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/contract_lifecycle.py:0
msgid ""
"Lease '%(lease)s' belongs to company '%(cc)s' but property '%(prop)s' "
"belongs to '%(pc)s'."
msgstr ""
"عقد الإيجار «%(lease)s» يتبع الشركة «%(cc)s» بينما العقار «%(prop)s» يتبع "
"«%(pc)s»."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/billing_engine.py:0
msgid ""
"Lease '%(lease)s' still has %(count)s payment(s) from the legacy schedule. "
"Generating a billing schedule now would bill those periods twice; they must "
"be converted to billing periods first."
msgstr ""
"عقد الإيجار «%(lease)s» لا يزال لديه %(count)s دفعة من الجدول القديم. إنشاء "
"جدول استحقاقات الآن سيؤدي إلى فوترة تلك الفترات مرتين؛ يجب تحويلها إلى فترات"
" فوترة أولًا."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/contract_lifecycle.py:0
msgid ""
"Lease '%(name)s' cannot move from '%(cur)s' to '%(new)s'. Allowed from here:"
" %(allowed)s."
msgstr ""
"لا يمكن نقل عقد الإيجار «%(name)s» من «%(cur)s» إلى «%(new)s». الحالات "
"المسموح بها من هنا: %(allowed)s."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/contract_lifecycle.py:0
msgid ""
"Lease '%(name)s' must be approved before it can go to signature. Company "
"'%(company)s' requires the approval step."
msgstr ""
"يجب اعتماد عقد الإيجار «%(name)s» قبل إرساله للتوقيع. الشركة «%(company)s» "
"تشترط خطوة الاعتماد."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/contract_party.py:0
msgid "Lease '%s' already has a primary tenant. Clear the existing one first."
msgstr "عقد الإيجار «%s» لديه مستأجر رئيسي بالفعل. أزل المستأجر الحالي أولًا."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/contract.py:0
msgid ""
"Lease '%s' already has billing obligations invoiced per period. Invoicing "
"its whole term now would bill that rent twice."
msgstr ""
"عقد الإيجار «%s» لديه بالفعل استحقاقات مفوترة لكل فترة. فوترة كامل مدة العقد"
" الآن ستؤدي إلى فوترة ذلك الإيجار مرتين."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/move_out.py:0
msgid "Lease '%s' has no deposit being held."
msgstr "عقد الإيجار «%s» ليس لديه مبلغ تأمين محتجز."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/billing_engine.py:0
msgid ""
"Lease '%s' has no end date. Set one before generating a billing schedule."
msgstr "عقد الإيجار «%s» ليس له تاريخ نهاية. حدده قبل إنشاء جدول الاستحقاقات."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/contract_lifecycle.py:0
msgid "Lease '%s' has no property allocation."
msgstr "عقد الإيجار «%s» ليس له تخصيص وحدة."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/contract_lifecycle.py:0
msgid "Lease '%s' has not been signed yet."
msgstr "عقد الإيجار «%s» لم يتم توقيعه بعد."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/billing_engine.py:0
msgid ""
"Lease '%s' is billed by a single invoice for its whole term. It cannot also "
"get a per-period billing schedule."
msgstr ""
"عقد الإيجار «%s» تتم فوترته بفاتورة واحدة لكامل مدته. لا يمكن أن يكون له "
"أيضًا جدول استحقاقات لكل فترة."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/contract.py:0
msgid ""
"Lease '%s' is billed per period by the billing engine. Use Invoice Due "
"instead of one invoice for the whole term."
msgstr ""
"عقد الإيجار «%s» تتم فوترته لكل فترة بواسطة محرك الفوترة. استخدم فوترة "
"المستحق بدلًا من فاتورة واحدة لكامل مدة العقد."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/billing_engine.py:0
msgid ""
"Lease '%s' is not configured for advanced billing. Enable 'Use Advanced "
"Billing' first, or use the legacy 'Generate Payment Schedule' action."
msgstr ""
"عقد الإيجار «%s» غير مهيأ للفوترة المتقدمة. فعّل «استخدام الفوترة المتقدمة» "
"أولًا، أو استخدم إجراء «إنشاء جدول الدفعات» القديم."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/move_in.py:0
msgid "Lease '%s' must be active before a tenant can move in."
msgstr ""
"يجب أن يكون عقد الإيجار «%s» ساريًا قبل أن يتمكن المستأجر من استلام الوحدة."

#. module: atmta_real_estate
#. odoo-python
#: code:addons/atmta_real_estate/models/contract_renewal.py:0
msgid ""
"Lease <b>%(name)s</b> for %(tenant)s expires on %(end)s. Start the renewal "
"conversation."
msgstr ""
"عقد الإيجار <b>%(name)s</b> للمستأجر %(tenant)s ينتهي في %(end)s. ابدأ "
"التفاوض على تجديد العقد."

#. module: atmta_real_estate
