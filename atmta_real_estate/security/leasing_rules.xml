<?xml version="1.0" encoding="UTF-8"?>
<!--
  Record rules (Phases 27 & 28).

  The pre-upgrade module had NO ir.rule records at all across the whole suite,
  which meant multi-company isolation did not exist: any user could read any
  company's properties, leases and rent.

  Every model that carries a company is given the standard Odoo multi-company
  rule (`company_id in company_ids`), so a user only ever sees the companies
  they are logged into. These are global rules — they apply to every group,
  including managers, because company isolation is not a permission level.

  Note on realestate.property: its company comes from the delegated
  product.template but is materialised as a real, indexed column
  (see property_identity.py) precisely so it can be used here.
-->
<odoo noupdate="1">

    <!-- ============================================================= -->
    <!-- Multi-company isolation                                        -->
    <!-- ============================================================= -->

    <!--
        Property isolation moved to `atmta_property_core`
        (`security/property_core_rules.xml`), together with the `company_id` it
        filters on. A module that defines a model owns the boundary around it;
        this application keeps the rules for the lease models below, which are
        genuinely its own.
    -->

    <record id="rule_contract_company" model="ir.rule">
        <field name="name">Lease: multi-company</field>
        <field name="model_id" ref="model_realestate_contract"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_contract_property_line_company" model="ir.rule">
        <field name="name">Lease allocation: multi-company</field>
        <field name="model_id" ref="model_realestate_contract_property_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_contract_party_company" model="ir.rule">
        <field name="name">Lease party: multi-company</field>
        <field name="model_id" ref="model_realestate_contract_party"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_contract_payment_company" model="ir.rule">
        <field name="name">Billing obligation: multi-company</field>
        <field name="model_id" ref="model_realestate_contract_payment"/>
