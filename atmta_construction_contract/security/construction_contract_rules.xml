<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!--
            Wave 13 — the company rule for the package.

            Only this one moved. The project-team and manager rules stayed in
            `real_estate_construction`: their domains read
            `project_id.construction_member_ids`, a field that module declares
            on the project. A rule may be declared above the model it guards;
            it may not be declared below a field it reads.
        -->
        <record id="rule_realestate_construction_contract_package_company" model="ir.rule">
            <field name="name">realestate.construction.contract.package: company</field>
            <field name="model_id" ref="model_realestate_construction_contract_package"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
