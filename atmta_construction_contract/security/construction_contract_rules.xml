<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!--
            Wave 13 — the company rule for the package.

            Only this one moved. The project-team and manager rules stayed in
            `real_estate_construction`: their domains read
            `project_id.construction_member_ids`, a field that module declares
            on the project. A rule may be declared above the model it guards;
            it may not be declared below a field it reads.
        -->
        <record id="rule_realestate_construction_contract_package_company" model="ir.rule">
            <field name="name">realestate.construction.contract.package: company</field>
            <field name="model_id" ref="model_realestate_construction_contract_package"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!--
            Wave 25 — the project-team rules, finally beside their models.

            These stayed in `real_estate_construction` through every earlier
            wave for one reason, recorded in this file at the time: their
            domains read `project_id.construction_member_ids`, and a rule may
            be declared above the model it guards but never below the field it
            reads. Wave 25 moved that field down to
            `atmta_construction_core`, which removed the pin.

            The group is rebound from the legacy `group_construction_user` to
            the canonical role it already implies. Every legacy member is
            materialised into the canonical group by the Wave 12 bridge, so
            nobody covered by these rules stops being covered. Users holding
            only the canonical role start being covered, which tightens the
            filter and never loosens it. That widening was measured before
            and after, per model, per user.

            `(6, 0, [...])` and not `(4, ...)`: the records already exist and
            carry the legacy group, and appending would leave both bound.
        -->

        <record id="rule_realestate_construction_contract_package_manager" model="ir.rule">
            <field name="name">realestate.construction.contract.package: manager sees every project</field>
            <field name="model_id" ref="model_realestate_construction_contract_package"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(6, 0, [ref('atmta_roles.group_construction_manager')])]"/>
        </record>

        <record id="rule_realestate_construction_contract_package_project_member" model="ir.rule">
            <field name="name">realestate.construction.contract.package: project team</field>
            <field name="model_id" ref="model_realestate_construction_contract_package"/>
            <field name="domain_force">['|', '|', ('project_id', '=', False), ('project_id.construction_member_ids', '=', False), ('project_id.construction_member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(6, 0, [ref('atmta_roles.group_construction_site_user')])]"/>
        </record>
    </data>
</odoo>
