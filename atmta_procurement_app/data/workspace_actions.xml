<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      The ONE action this module creates.

      `atmta_procurement_control.action_approval_register` shows every approval
      step to everyone who may read them. A workspace has to answer "what is
      waiting on ME", and no existing action carries that domain. The model,
      the views and the access rules are all the existing ones; only the domain
      is new, and it names the two fields the model already defines:
      `approver_user_id` (who should decide) and `decision` (whose 'pending'
      value is declared in the model's own selection).
    -->
    <record id="action_v2_my_approvals" model="ir.actions.act_window">
        <field name="name">My Approvals</field>
        <field name="res_model">realestate.procurement.approval.step</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('approver_user_id', '=', uid), ('decision', '=', 'pending')]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing is waiting on you.</p>
            <p>Approval steps addressed to you appear here while their decision is still pending.</p>
        </field>
    </record>

</odoo>
