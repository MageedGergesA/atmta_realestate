<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_placeholder_autofill_wizard_form" model="ir.ui.view">
        <field name="name">realestate.placeholder.autofill.wizard.form</field>
        <field name="model">realestate.placeholder.autofill.wizard</field>
        <field name="arch" type="xml">
            <form string="Auto-Fill Placeholders">
                <sheet>
                    <field name="state" invisible="1"/>
                    <group>
                        <field name="template_id" readonly="1"/>
                        <field name="target_model_id" readonly="1"/>
                    </group>

                    <!-- STATE: scan -->
                    <div invisible="state != 'scan'">
                        <div class="alert alert-info" role="alert">
                            <p><b>How it works:</b> mark the words you want to replace in your
                               .docx with square brackets, e.g.
                               <code>[Customer Name]</code>, <code>[Unit Number]</code>,
                               <code>[Total Amount]</code>, <code>[اسم العميل]</code>.</p>
                            <p>Click <b>Scan Document</b>. The system reads every bracketed token,
                               fuzzy-matches it to the chosen model's fields, and shows you a
                               review screen where you can accept or override each suggestion.</p>
                        </div>
                    </div>

                    <!-- STATE: review -->
                    <div invisible="state != 'review'">
                        <field name="scan_summary" readonly="1" nolabel="1"/>
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom" default_order="confidence desc, token">
                                <field name="token" readonly="1"/>
                                <field name="suggested_label" readonly="1"/>
                                <field name="confidence" readonly="1" widget="progressbar"/>
                                <field name="mapped_jinja"/>
                                <field name="accepted" widget="boolean_toggle"/>
                            </list>
                        </field>
                        <div class="alert alert-warning" role="alert" invisible="state != 'review'">
                            <p>Edit <b>Placeholder</b> directly to override the suggestion
                               (use the Catalog button on the template form for the full list of
                               valid Jinja expressions). Untick <b>Accepted</b> to leave a token as
                               <code>[Token]</code> in the final document.</p>
                        </div>
                    </div>

                    <!-- STATE: applied -->
                    <div invisible="state != 'applied'">
                        <div class="alert alert-success" role="alert">
                            <p><b>Done.</b> The template's .docx has been rewritten with Jinja
                               placeholders. The previous version was replaced in the template
                               record — re-generate any contract to see the new placeholders
                               take effect.</p>
                        </div>
                        <group>
                            <field name="applied_count" readonly="1"/>
                            <field name="unmapped_count" readonly="1"/>
                            <field name="new_docx_filename" readonly="1"/>
                            <field name="new_docx" filename="new_docx_filename" readonly="1"/>
                        </group>
                    </div>
                </sheet>
                <footer>
                    <button name="action_scan" type="object"
                            string="Scan Document" class="btn-primary"
                            invisible="state != 'scan'"/>
                    <button name="action_accept_high_confidence" type="object"
                            string="Accept All ≥75% Confidence" class="btn-secondary"
                            invisible="state != 'review'"/>
                    <button name="action_apply" type="object"
                            string="Apply Mappings" class="btn-primary"
                            invisible="state != 'review'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
