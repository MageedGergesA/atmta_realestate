<?xml version="1.0" encoding="UTF-8"?>
<!--
  Record rules.

  The module shipped with none, although both models carry a `company_id`:
  a template created for another company was visible from — and usable by —
  the main company, and so were the documents issued from it.

  Global rules, as in the rest of the suite (atmta_real_estate/security/
  leasing_rules.xml): company isolation is not a permission level, it applies
  to managers too. A template with no company is shared configuration, so it
  stays visible everywhere; a document always has one.
-->
<odoo noupdate="1">

    <record id="rule_contract_template_company" model="ir.rule">
        <field name="name">Contract template: multi-company</field>
        <field name="model_id" ref="model_realestate_contract_template"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_contract_document_company" model="ir.rule">
        <field name="name">Generated document: multi-company</field>
        <field name="model_id" ref="model_realestate_contract_document"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
