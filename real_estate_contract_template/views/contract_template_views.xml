<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_contract_template_list" model="ir.ui.view">
        <field name="name">realestate.contract.template.list</field>
        <field name="model">realestate.contract.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="kind"/>
                <field name="jurisdiction"/>
                <field name="language"/>
                <field name="target_model_id"/>
                <field name="form_version"/>
                <field name="use_count"/>
                <field name="last_used"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_contract_template_form" model="ir.ui.view">
        <field name="name">realestate.contract.template.form</field>
        <field name="model">realestate.contract.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_target_records" type="object"
                            string="Open Target Records" class="oe_highlight"
                            help="Jump to the list of records this template can render against — then click Generate Document from the record itself."/>
                    <button name="action_open_placeholder_catalog" type="object"
                            string="Placeholder Catalog" class="btn-secondary"
                            invisible="not target_model_id"
                            help="Show every {{ record.field }} expression available on the chosen target model."/>
                    <button name="action_open_placeholder_autofill" type="object"
                            string="Auto-Fill Placeholders" class="btn-secondary"
                            invisible="not docx_template or not target_model_id"
                            help="Scan the uploaded .docx for [Bracketed Tokens] and replace them with Jinja placeholders matched against the target model's fields."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Egypt — Sale (Bilingual) v1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="kind"/>
                            <field name="jurisdiction"/>
                            <field name="language"/>
                        </group>
                        <group>
                            <field name="target_model_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="target_model_name" invisible="1"/>
                            <field name="form_version"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="DOCX Template">
                        <field name="docx_template" filename="docx_template_filename"
                               widget="binary"/>
                        <field name="docx_template_filename" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Notes / Placeholder Reference" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                        <page string="Usage" name="usage">
                            <group>
                                <field name="use_count" readonly="1"/>
                                <field name="last_used" readonly="1"/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                <p><b>Placeholders use Jinja2 syntax inside Word.</b></p>
                                <ul>
                                    <li>Simple field: <code>{{ record.partner_id.name }}</code></li>
                                    <li>Date format: <code>{{ record.contract_date.strftime('%d/%m/%Y') }}</code></li>
                                    <li>Conditional: <code>{% if record.state == 'signed' %}…{% endif %}</code></li>
                                    <li>Table row repeat (inside a Word table): <code>{%tr for line in record.installment_line_ids %}</code> … <code>{%tr endfor %}</code></li>
                                    <li>Inline loop: <code>{% for p in record.partner_ids %}{{ p.name }}{% endfor %}</code></li>
                                </ul>
                                <p>Built-in context variables: <code>record</code> (alias <code>doc</code>),
                                   <code>company</code>, <code>user</code>, <code>today</code>, <code>now</code>,
                                   <code>jurisdiction</code>, <code>language</code>,
                                   <code>template_version</code>.</p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_contract_template_search" model="ir.ui.view">
        <field name="name">realestate.contract.template.search</field>
        <field name="model">realestate.contract.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="target_model_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="kind_sale" string="Sale" domain="[('kind', '=', 'sale')]"/>
                <filter name="kind_rental" string="Rental" domain="[('kind', '=', 'rental')]"/>
                <filter name="kind_brokerage" string="Brokerage" domain="[('kind', '=', 'brokerage')]"/>
                <filter name="kind_subcontract" string="Subcontract" domain="[('kind', '=', 'subcontract')]"/>
                <separator/>
                <filter name="j_eg" string="Egypt" domain="[('jurisdiction', '=', 'eg')]"/>
                <filter name="j_sa" string="Saudi Arabia" domain="[('jurisdiction', '=', 'sa')]"/>
                <filter name="j_dubai" string="UAE — Dubai" domain="[('jurisdiction', '=', 'ae_dubai')]"/>
                <filter name="j_abudhabi" string="UAE — Abu Dhabi" domain="[('jurisdiction', '=', 'ae_abudhabi')]"/>
                <group expand="0" string="Group By">
                    <filter name="g_kind" string="Kind" context="{'group_by': 'kind'}"/>
                    <filter name="g_jurisdiction" string="Jurisdiction" context="{'group_by': 'jurisdiction'}"/>
                    <filter name="g_target" string="Target Model" context="{'group_by': 'target_model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_contract_template" model="ir.actions.act_window">
        <field name="name">Contract Templates</field>
        <field name="res_model">realestate.contract.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_contract_template_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No contract templates yet.</p>
            <p>Upload a <b>.docx</b> file with Jinja2 placeholders to generate
               Word or PDF contracts from any real estate record.</p>
        </field>
    </record>

</odoo>
