<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Button on the developer sale contract -->
    <record id="view_sale_contract_form_inherit_template" model="ir.ui.view">
        <field name="name">realestate.sale.contract.form.template.button</field>
        <field name="model">realestate.sale.contract</field>
        <field name="inherit_id" ref="real_estate_developer.view_sale_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generate_contract_document"
                        type="object" string="Generate Document"
                        class="btn-secondary"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_generated_documents" type="object"
                        class="oe_stat_button" icon="fa-file-text-o">
                    <field name="generated_document_count" widget="statinfo" string="Documents"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Generate Document on a lease is an occasional action: it lives in the
         gear menu, not the lease header. -->
    <record id="action_server_generate_lease_document" model="ir.actions.server">
        <field name="name">Generate Document</field>
        <field name="model_id" ref="atmta_real_estate.model_realestate_contract"/>
        <field name="binding_model_id" ref="atmta_real_estate.model_realestate_contract"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_generate_contract_document()</field>
    </record>

    <!-- Documents smart button on the lease -->
    <record id="view_realestate_contract_form_inherit_template" model="ir.ui.view">
        <field name="name">realestate.contract.form.template.button</field>
        <field name="model">realestate.contract</field>
        <field name="inherit_id" ref="atmta_real_estate.view_realestate_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_generated_documents" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="generated_document_count == 0">
                    <field name="generated_document_count" widget="statinfo" string="Documents"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Button on the brokerage transaction -->
    <record id="view_transaction_form_inherit_template" model="ir.ui.view">
        <field name="name">realestate.transaction.form.template.button</field>
        <field name="model">realestate.transaction</field>
        <field name="inherit_id" ref="real_estate_brokerage.view_transaction_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generate_contract_document"
                        type="object" string="Generate Document"
                        class="btn-secondary"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_generated_documents" type="object"
                        class="oe_stat_button" icon="fa-file-text-o">
                    <field name="generated_document_count" widget="statinfo" string="Documents"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Button on the subcontractor record -->
    <record id="view_contractor_form_inherit_template" model="ir.ui.view">
        <field name="name">realestate.contractor.form.template.button</field>
        <field name="model">realestate.contractor</field>
        <field name="inherit_id" ref="real_estate_construction.view_contractor_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generate_contract_document"
                        type="object" string="Generate Document"
                        class="btn-secondary"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_generated_documents" type="object"
                        class="oe_stat_button" icon="fa-file-text-o">
                    <field name="generated_document_count" widget="statinfo" string="Documents"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
