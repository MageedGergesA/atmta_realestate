<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!--
            `sla_breached` is stored, and a stored compute only runs when one
            of its dependencies is written. A deadline passing writes nothing,
            so the tickets that breach silently are exactly the ones nobody is
            looking at. This is the thing that notices.

            Hourly: an SLA is quoted in hours, so an hour is the smallest
            granularity the number is meaningful at, and a cheap indexed
            search at that rate costs nothing.
        -->
        <record id="ir_cron_refresh_sla_breaches" model="ir.cron">
            <field name="name">Customer Service: refresh SLA breaches</field>
            <field name="model_id" ref="model_realestate_customer_ticket"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_sla_breaches()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
