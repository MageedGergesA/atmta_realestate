<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_category_list" model="ir.ui.view">
        <field name="name">realestate.customer.ticket.category.list</field>
        <field name="model">realestate.customer.ticket.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="default_sla_hours"/>
                <field name="default_assignee_id" widget="many2one_avatar_user"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_category" model="ir.actions.act_window">
        <field name="name">Ticket Categories</field>
        <field name="res_model">realestate.customer.ticket.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
