<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_realestate_service" model="ir.module.category">
        <field name="name">Real Estate Customer Service</field>
        <field name="sequence">32</field>
    </record>
    <record id="group_service_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_realestate_service"/>
    </record>
    <record id="group_service_agent" model="res.groups">
        <field name="name">Agent</field>
        <field name="category_id" ref="module_category_realestate_service"/>
        <field name="implied_ids" eval="[(4, ref('group_service_user'))]"/>
    </record>
    <record id="group_service_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_realestate_service"/>
        <field name="implied_ids" eval="[(4, ref('group_service_agent'))]"/>
    </record>
</odoo>
