<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!--
            Wave 16 — the company rules for the change models. The project-team
            rules stayed in `real_estate_construction`: their domains read
            `project_id.construction_member_ids`, which that module declares.
            Group references are rebound to the canonical roles through the
            Wave 12 bridge.
        -->
        <record id="rule_realestate_construction_change_event_company" model="ir.rule">
                <field name="name">realestate.construction.change.event: company</field>
                <field name="model_id" ref="model_realestate_construction_change_event"/>
                <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
                <field name="global" eval="True"/>
            </record>
        <record id="rule_realestate_construction_change_order_company" model="ir.rule">
                <field name="name">realestate.construction.change.order: company</field>
                <field name="model_id" ref="model_realestate_construction_change_order"/>
                <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
                <field name="global" eval="True"/>
            </record>
        <record id="rule_realestate_construction_change_order_line_company" model="ir.rule">
                <field name="name">realestate.construction.change.order.line: company</field>
                <field name="model_id" ref="model_realestate_construction_change_order_line"/>
                <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
                <field name="global" eval="True"/>
            </record>
        <record id="rule_realestate_construction_change_event_manager" model="ir.rule">
                <field name="name">realestate.construction.change.event: manager sees every project</field>
                <field name="model_id" ref="model_realestate_construction_change_event"/>
                <field name="domain_force">[(1, '=', 1)]</field>
                <field name="groups" eval="[(4, ref('atmta_roles.group_construction_manager'))]"/>
            </record>
        <record id="rule_realestate_construction_change_order_manager" model="ir.rule">
                <field name="name">realestate.construction.change.order: manager sees every project</field>
                <field name="model_id" ref="model_realestate_construction_change_order"/>
                <field name="domain_force">[(1, '=', 1)]</field>
                <field name="groups" eval="[(4, ref('atmta_roles.group_construction_manager'))]"/>
            </record>
    </data>
</odoo>
