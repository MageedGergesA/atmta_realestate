<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="atmta_dashboard.Chart">
        <div class="o_ad_card" t-attf-class="{{ props.chart.span or 'o_ad_col_4' }}"
             t-att-data-chart="props.chart.key">
            <div class="o_ad_card_head">
                <div>
                    <h3 class="o_ad_card_title">
                        <i t-if="props.chart.icon" t-attf-class="fa {{ props.chart.icon }}" aria-hidden="true"/>
                        <span t-esc="props.chart.title"/>
                    </h3>
                    <p t-if="props.chart.subtitle" class="o_ad_delta_caption" t-esc="props.chart.subtitle"/>
                </div>
            </div>
            <div t-if="isEmpty" class="o_ad_empty" role="status">
                <i class="fa fa-bar-chart o_ad_empty_icon" aria-hidden="true"/>
                <p class="o_ad_empty_text">Nothing to show for this period.</p>
            </div>
            <div t-else="" class="o_ad_chart_canvas_wrap">
                <canvas t-ref="canvas" role="img" t-att-aria-label="props.chart.title"/>
            </div>
        </div>
    </t>

    <t t-name="atmta_dashboard.Dashboard">
        <div class="o_ad_dashboard o_action">
            <!-- The root carries `o_action`, which Odoo styles
                 `overflow: hidden` at a higher specificity than any rule of
                 ours, so the root can never scroll itself. This inner box
                 does. atmta_dashboard/tests guards it. -->
            <div class="o_ad_scroll">

                <header class="o_ad_header">
                    <div>
                        <h1 class="o_ad_title" t-esc="data.title"/>
                        <p class="o_ad_subtitle" t-if="state.status === 'ready'">
                            <span t-esc="data.company_name"/>
                            <span class="o_ad_sep" aria-hidden="true">·</span>
                            <span class="o_ad_asof">
                                <i class="fa fa-calendar-o" aria-hidden="true"/>
                                <span>As of <t t-esc="data.as_of"/></span>
                            </span>
                            <span t-if="lastUpdatedLabel" class="o_ad_sep" aria-hidden="true">·</span>
                            <span t-if="lastUpdatedLabel" t-esc="lastUpdatedLabel"/>
                        </p>
                    </div>
                    <div class="o_ad_header_actions">
                        <t t-foreach="data.quick_actions or []" t-as="q" t-key="q.key">
                            <button class="btn btn-sm" t-att-class="q_first ? 'btn-primary' : 'btn-secondary'"
                                    t-att-data-quick-action="q.key" t-on-click="() => this.quick(q.key)">
                                <i t-attf-class="fa {{ q.icon }} me-1" aria-hidden="true"/>
                                <span t-esc="q.label"/>
                            </button>
                        </t>
                        <div t-if="data.supports_scope" class="btn-group" role="group" aria-label="Whose work to show">
                            <button class="btn btn-sm" data-scope="mine"
                                    t-att-class="state.scope === 'mine' ? 'btn-primary' : 'btn-outline-secondary'"
                                    t-on-click="() => this.setScope('mine')">Mine</button>
                            <button class="btn btn-sm" data-scope="team"
                                    t-att-class="state.scope === 'team' ? 'btn-primary' : 'btn-outline-secondary'"
                                    t-on-click="() => this.setScope('team')">Team</button>
                        </div>
                        <button class="btn btn-sm btn-secondary o_ad_refresh" t-on-click="refresh"
                                aria-label="Refresh the dashboard">
                            <i class="fa fa-refresh" aria-hidden="true"/>
                            <span class="d-none d-md-inline ms-1">Refresh</span>
                        </button>
                    </div>
                </header>

                <AtmtaFilterBar t-if="state.status === 'ready' and filterDefs.length"
                                filters="filterDefs" values="state.filters"
                                period="state.period"
                                onChange="(k, v) => this.setFilter(k, v)"
                                onPeriod="(p) => this.setPeriod(p)"
                                onReset="() => this.resetFilters()"/>

                <!-- Skeleton, not a spinner: the page keeps its shape, so
                     nothing jumps when the numbers land. -->
                <AtmtaSkeleton t-if="state.status === 'loading'"/>

                <div t-elif="state.status === 'error'" class="o_ad_state" role="alert">
                    <i class="fa fa-exclamation-circle o_ad_state_icon" aria-hidden="true"/>
                    <h2 class="o_ad_state_title">The dashboard could not be loaded</h2>
                    <p class="o_ad_state_text" t-esc="state.error"/>
                    <button class="btn btn-primary" t-on-click="refresh">Retry</button>
                </div>

                <t t-else="">
                    <div t-if="!data.sections.length and !data.charts.length" class="o_ad_state" role="status">
                        <i class="fa fa-lock o_ad_state_icon" aria-hidden="true"/>
                        <h2 class="o_ad_state_title">Nothing to show</h2>
                        <p class="o_ad_state_text">None of the figures on this dashboard are available to your role.</p>
                    </div>

                    <section t-foreach="data.sections" t-as="section" t-key="section.id"
                             class="o_ad_section" t-att-data-section="section.id">
                        <h2 class="o_ad_section_title">
                            <i t-attf-class="fa {{ section.icon }}" aria-hidden="true"/>
                            <span t-esc="section.title"/>
                        </h2>
                        <p t-if="section.subtitle" class="o_ad_section_subtitle"
                           t-esc="section.subtitle"/>
                        <div class="o_ad_kpi_grid">
                            <t t-foreach="section.tiles" t-as="tile" t-key="tile.key">
                                <AtmtaKpiCard tile="tile" currencyId="data.currency_id"
                                              onDrill="(key) => this.drill(key)"/>
                            </t>
                        </div>
                    </section>

                    <!-- Problems and personal work before the charts: the
                         dashboard should answer "what needs me" above the
                         fold, and analysis below it. -->
                    <div t-if="(data.alerts or []).length or (data.work_queue or []).length"
                         class="o_ad_grid o_ad_section">
                        <AtmtaCard t-if="(data.alerts or []).length" className="'o_ad_col_6'"
                                   title="'Attention Required'" icon="'fa-exclamation-triangle'">
                            <AtmtaRowList rows="data.alerts" currencyId="data.currency_id"
                                          onRow="(key) => this.drill(key)"/>
                        </AtmtaCard>
                        <AtmtaCard t-if="(data.work_queue or []).length" className="'o_ad_col_6'"
                                   title="'My Work'" icon="'fa-check-square-o'">
                            <AtmtaRowList rows="data.work_queue" currencyId="data.currency_id"
                                          onRow="(key) => this.drill(key)"
                                          emptyText="'Your queue is clear.'"/>
                        </AtmtaCard>
                    </div>

                    <section t-if="data.charts.length" class="o_ad_section" data-section="charts">
                        <div class="o_ad_grid">
                            <t t-foreach="data.charts" t-as="chart" t-key="chart.key">
                                <AtmtaDashboardChart chart="chart" currencyId="data.currency_id"
                                                     onSegment="(key, index) => this.drillChart(key, index)"/>
                            </t>
                        </div>
                    </section>

                    <div t-if="(data.tables or []).length" class="o_ad_grid o_ad_section">
                        <AtmtaCard t-foreach="data.tables" t-as="table" t-key="table.key"
                                   className="table.span or 'o_ad_col_6'"
                                   title="table.title" icon="table.icon">
                            <AtmtaDataTable columns="table.columns" rows="table.rows"
                                            currencyId="data.currency_id"/>
                        </AtmtaCard>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
