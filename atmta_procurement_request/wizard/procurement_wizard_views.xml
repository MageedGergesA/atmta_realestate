<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_material_request_rfq_form" model="ir.ui.view">
        <field name="name">realestate.material.request.rfq.form</field>
        <field name="model">realestate.material.request.rfq</field>
        <field name="arch" type="xml">
            <form string="Create Requests for Quotation">
                <div class="alert alert-info" role="alert">
                    Each vendor named here receives their own draft quotation, carrying
                    every line with its project, WBS and cost code. Nothing is committed:
                    a quotation becomes an order only when somebody confirms it.
                </div>
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="vendor_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="suggested_vendor_ids" widget="many2many_tags"
                           readonly="1" invisible="not suggested_vendor_ids"/>
                </group>
                <footer>
                    <button name="action_create_rfqs" type="object" string="Create RFQs"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_material_request_revise_form" model="ir.ui.view">
        <field name="name">realestate.material.request.revise.form</field>
        <field name="model">realestate.material.request.revise</field>
        <field name="arch" type="xml">
            <form string="Revise Requisition">
                <div class="alert alert-warning" role="alert">
                    The requisition returns to draft and its current basis is kept as a
                    revision, so what was approved stays readable next to what replaced it.
                </div>
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="reason" placeholder="e.g. structural revision C increased the pour"/>
                </group>
                <footer>
                    <button name="action_revise" type="object" string="Revise"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
