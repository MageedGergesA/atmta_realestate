<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Company isolation. Global rules are ANDed with everything else,
             so this is the floor no group rule below can lift. -->
        <record id="rule_material_request_company" model="ir.rule">
            <field name="name">Requisition: company</field>
            <field name="model_id" ref="model_realestate_material_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_material_request_line_company" model="ir.rule">
            <field name="name">Requisition line: company</field>
            <field name="model_id" ref="model_realestate_material_request_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_request_revision_company" model="ir.rule">
            <field name="name">Requisition revision: company</field>
            <field name="model_id" ref="model_realestate_material_request_revision"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_procurement_plan_company" model="ir.rule">
            <field name="name">Procurement plan: company</field>
            <field name="model_id" ref="model_realestate_procurement_plan"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_procurement_plan_line_company" model="ir.rule">
            <field name="name">Procurement plan line: company</field>
            <field name="model_id" ref="model_realestate_procurement_plan_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Group rules are ORed with each other. A requester sees the demand
             they raised; a buyer sees all of it. Someone who is both sees all
             of it, which is what the union is for. -->
        <record id="rule_material_request_own" model="ir.rule">
            <field name="name">Requisition: my own requests</field>
            <field name="model_id" ref="model_realestate_material_request"/>
            <field name="groups" eval="[(4, ref('atmta_roles.group_procurement_requester'))]"/>
            <field name="domain_force">['|', ('requested_by_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        </record>

        <record id="rule_material_request_buyer" model="ir.rule">
            <field name="name">Requisition: the sourcing queue</field>
            <field name="model_id" ref="model_realestate_material_request"/>
            <field name="groups" eval="[(4, ref('atmta_roles.group_procurement_buyer'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
