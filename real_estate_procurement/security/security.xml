<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_realestate_procurement" model="ir.module.category">
        <field name="name">Real Estate Procurement</field>
        <field name="description">Access to the real-estate procurement workflow.</field>
        <field name="sequence">28</field>
    </record>

    <record id="group_procurement_requester" model="res.groups">
        <field name="name">Requester</field>
        <field name="category_id" ref="module_category_realestate_procurement"/>
        <field name="comment">Raise material requests for permitted projects. Deliberately grants no
            purchasing rights: asking for materials is not the same as being able to buy them.</field>
    </record>

    <record id="group_procurement_user" model="res.groups">
        <field name="name">Buyer</field>
        <field name="category_id" ref="module_category_realestate_procurement"/>
        <field name="implied_ids" eval="[(4, ref('group_procurement_requester'))]"/>
        <field name="comment">Process approved requisitions, prepare requests for quotation, view purchase
            orders and vendors.</field>
    </record>

    <record id="group_procurement_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="category_id" ref="module_category_realestate_procurement"/>
        <field name="implied_ids" eval="[(4, ref('group_procurement_user'))]"/>
        <field name="comment">Approve material requests, confirm purchase orders.</field>
    </record>

    <!-- ============================================================
         M4Z — vendor governance authority, kept apart from spend authority.

         Assessing a vendor and approving money are different jobs done by
         different people, and a company may reasonably give somebody one
         and not the other. So these two groups sit beside the spend ladder
         rather than inside it: an assessor is a buyer who may also assess,
         and a qualification approver may approve *qualifications* — it
         grants no requisition or purchase-order authority whatsoever.

         Nothing here implies, or is implied by, Accounting, Inventory or
         Construction. A Construction Manager does not become a vendor
         approver by being a Construction Manager.
         ============================================================ -->

    <record id="group_procurement_qualification_assessor" model="res.groups">
        <field name="name">Qualification Assessor</field>
        <field name="category_id" ref="module_category_realestate_procurement"/>
        <field name="implied_ids" eval="[(4, ref('group_procurement_user'))]"/>
        <field name="comment">Run vendor assessments, record and verify evidence, see confidential
            qualification documents. Cannot approve a qualification — that is deliberately somebody
            else, and the server checks it rather than the screen.</field>
    </record>

    <record id="group_procurement_qualification_approver" model="res.groups">
        <field name="name">Qualification Approver</field>
        <field name="category_id" ref="module_category_realestate_procurement"/>
        <field name="implied_ids" eval="[(4, ref('group_procurement_qualification_assessor'))]"/>
        <field name="comment">Approve or reject vendor qualifications and impose or lift restrictions.
            Carries no spend authority: approving a supplier is not approving a purchase.</field>
    </record>

    <!-- M8. Deliberately NOT implied by the buyer group: the person who chose
         the vendor is not the person who should certify that the vendor's
         material is acceptable. A system that lets one user do both has
         recorded a signature rather than a control. Manager implies it so a
         small site is not locked out of its own loading bay. -->
    <record id="group_procurement_inspector" model="res.groups">
        <field name="name">Material Inspector</field>
        <field name="category_id" ref="module_category_realestate_procurement"/>
        <field name="comment">Record what arrived and what of it is fit to use. Carries no buying
            authority and no spend authority: accepting material is not approving a purchase, and
            the two are separated on purpose.</field>
    </record>

    <record id="group_procurement_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_realestate_procurement"/>
        <field name="implied_ids" eval="[(4, ref('group_procurement_approver')), (4, ref('group_procurement_qualification_approver')), (4, ref('group_procurement_inspector'))]"/>
        <field name="comment">Full administrative access including configuration.</field>
    </record>

    <!-- ============================================================
         Record rules.

         Company first, because a procurement document that spans two
         companies has no single set of books to belong to. Then the
         requester/buyer split: a requester sees what they raised, a buyer
         sees the queue they are sourcing. The two rules are separate on
         purpose — same-model rules from different groups are OR-ed, so a
         buyer (who also carries the requester group) is widened by the
         second rule rather than narrowed by the first.
         ============================================================ -->






    <!-- M3W — control records are company-scoped for the same reason the
         documents are: an approval, a reservation and a budget belong to one
         set of books, and an exception approved in one company has never
         authorised anything in another. -->






    <!-- ============================================================
         M4AA — vendor governance is company-scoped.

         The partner is shared; the decision about them is not. A vendor
         qualified by Cairo Developments has not been qualified by the
         coastal subsidiary, and the only way to make that reliably true is
         to stop the second company reading the first one's assessment at
         all.
         ============================================================ -->

    <record id="rule_vendor_profile_company" model="ir.rule">
        <field name="name">Vendor profile: company</field>
        <field name="model_id" ref="atmta_procurement_vendor.model_realestate_procurement_vendor_profile"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_vendor_qualification_company" model="ir.rule">
        <field name="name">Qualification: company</field>
        <field name="model_id" ref="atmta_procurement_vendor.model_realestate_procurement_vendor_qualification"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), '&amp;', ('is_group_wide', '=', True), ('shared_company_ids', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_qualification_response_company" model="ir.rule">
        <field name="name">Qualification response: company</field>
        <field name="model_id" ref="atmta_procurement_vendor.model_realestate_procurement_qualification_response"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_qualification_condition_company" model="ir.rule">
        <field name="name">Qualification condition: company</field>
        <field name="model_id" ref="atmta_procurement_vendor.model_realestate_procurement_qualification_condition"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_vendor_restriction_company" model="ir.rule">
        <field name="name">Vendor restriction: company</field>
        <field name="model_id" ref="atmta_procurement_vendor.model_realestate_procurement_vendor_restriction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_qualification_template_company" model="ir.rule">
        <field name="name">Qualification template: company</field>
        <field name="model_id" ref="atmta_procurement_vendor.model_realestate_procurement_qualification_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_qualification_requirement_company" model="ir.rule">
        <field name="name">Qualification requirement: company</field>
        <field name="model_id" ref="atmta_procurement_vendor.model_realestate_procurement_qualification_requirement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_qualification_area_company" model="ir.rule">
        <field name="name">Qualification area: company or shared</field>
        <field name="model_id" ref="atmta_procurement_vendor.model_realestate_procurement_qualification_area"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_vendor_category_company" model="ir.rule">
        <field name="name">Vendor trade: company or shared</field>
        <field name="model_id" ref="atmta_procurement_vendor.model_realestate_procurement_vendor_category"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <!-- ============================================================
         Confidential evidence.

         Two rules on the same model from two groups, which Odoo ORs. A
         buyer sees the responses that are not confidential; an assessor
         sees all of them. That is why the buyer rule is written as a
         restriction rather than as a global one — a global
         `confidential = False` would hide the financial assessment from
         the person doing the financial assessment.

         The documents follow automatically: every attachment is stamped
         with this response as its record (`_bind_attachments`), so Odoo's
         own attachment check asks these same rules. There is no separate
         attachment ACL to keep in step, and no `sudo()` in the read path.
         ============================================================ -->

    <record id="rule_qualification_response_not_confidential" model="ir.rule">
        <field name="name">Qualification response: non-confidential only</field>
        <field name="model_id" ref="atmta_procurement_vendor.model_realestate_procurement_qualification_response"/>
        <field name="domain_force">[('confidential', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_procurement_user'))]"/>
    </record>

    <record id="rule_qualification_response_assessor" model="ir.rule">
        <field name="name">Qualification response: assessors see the evidence</field>
        <field name="model_id" ref="atmta_procurement_vendor.model_realestate_procurement_qualification_response"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_procurement_qualification_assessor'))]"/>
    </record>




    <!-- ============================================================
         M5 — SOURCING AND TENDER
         Company isolation on every sourcing record, plus one rule that is
         about confidentiality rather than companies: a buyer sees the events
         they run and the ones they are on the team of, and Managers see all.
         Commercial bid detail is not readable by Requesters at all — there is
         no ACL row granting it, which is a stronger statement than a domain.
         ============================================================ -->

    <record id="rule_sourcing_event_company" model="ir.rule">
        <field name="name">Sourcing event: company</field>
        <field name="model_id" ref="model_realestate_procurement_sourcing_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_sourcing_version_company" model="ir.rule">
        <field name="name">Tender version: company</field>
        <field name="model_id" ref="model_realestate_procurement_sourcing_version"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_sourcing_line_company" model="ir.rule">
        <field name="name">Tender line: company</field>
        <field name="model_id" ref="model_realestate_procurement_sourcing_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_sourcing_allocation_company" model="ir.rule">
        <field name="name">Tender allocation: company</field>
        <field name="model_id" ref="model_realestate_procurement_sourcing_demand_allocation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_sourcing_invitation_company" model="ir.rule">
        <field name="name">Invitation: company</field>
        <field name="model_id" ref="model_realestate_procurement_sourcing_invitation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_bid_response_company" model="ir.rule">
        <field name="name">Bid response: company</field>
        <field name="model_id" ref="model_realestate_procurement_bid_response"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_bid_response_line_company" model="ir.rule">
        <field name="name">Bid response line: company</field>
        <field name="model_id" ref="model_realestate_procurement_bid_response_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_sourcing_clarification_company" model="ir.rule">
        <field name="name">Clarification: company</field>
        <field name="model_id" ref="model_realestate_procurement_sourcing_clarification"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <!-- Confidentiality: a Buyer reads the tenders they are responsible for.
         Managers are exempt because somebody has to be able to audit a
         tender they did not run. -->
    <record id="rule_bid_response_own_event" model="ir.rule">
        <field name="name">Bid response: own sourcing only</field>
        <field name="model_id" ref="model_realestate_procurement_bid_response"/>
        <field name="groups" eval="[(4, ref('group_procurement_user'))]"/>
        <field name="domain_force">['|', ('event_id.buyer_id', '=', user.id), ('event_id.team_ids', 'in', [user.id])]</field>
    </record>

    <record id="rule_bid_response_manager" model="ir.rule">
        <field name="name">Bid response: manager</field>
        <field name="model_id" ref="model_realestate_procurement_bid_response"/>
        <field name="groups" eval="[(4, ref('group_procurement_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_bid_response_line_own_event" model="ir.rule">
        <field name="name">Bid response line: own sourcing only</field>
        <field name="model_id" ref="model_realestate_procurement_bid_response_line"/>
        <field name="groups" eval="[(4, ref('group_procurement_user'))]"/>
        <field name="domain_force">['|', ('response_id.event_id.buyer_id', '=', user.id), ('response_id.event_id.team_ids', 'in', [user.id])]</field>
    </record>

    <record id="rule_bid_response_line_manager" model="ir.rule">
        <field name="name">Bid response line: manager</field>
        <field name="model_id" ref="model_realestate_procurement_bid_response_line"/>
        <field name="groups" eval="[(4, ref('group_procurement_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>


    <!-- ============================================================
         M6 — EVALUATION ROLES

         Split from the buying roles on purpose. A buyer running a tender is
         not automatically entitled to score it, and a technical evaluator is
         not entitled to see the money. The technical role deliberately does
         NOT imply Buyer: implying it would hand every technical evaluator the
         bid register through the back door.
         ============================================================ -->

    <record id="group_evaluation_technical" model="res.groups">
        <field name="name">Technical Evaluator</field>
        <field name="category_id" ref="module_category_realestate_procurement"/>
        <field name="comment">Scores technical criteria. Sees no commercial value through M6.</field>
    </record>

    <record id="group_evaluation_commercial" model="res.groups">
        <field name="name">Commercial Evaluator</field>
        <field name="category_id" ref="module_category_realestate_procurement"/>
        <field name="implied_ids" eval="[(4, ref('group_procurement_user'))]"/>
        <field name="comment">Analyses commercial offers once commercial evaluation is opened.</field>
    </record>

    <record id="group_evaluation_manager" model="res.groups">
        <field name="name">Evaluation Manager</field>
        <field name="category_id" ref="module_category_realestate_procurement"/>
        <field name="implied_ids" eval="[(4, ref('group_evaluation_technical')), (4, ref('group_evaluation_commercial'))]"/>
        <field name="comment">Runs the evaluation lifecycle. Cannot rewrite a submitted sheet or a sealed bid.</field>
    </record>

    <!-- Company isolation on every M6 record. -->
    <record id="rule_evaluation_plan_company" model="ir.rule">
        <field name="name">Evaluation plan: company</field>
        <field name="model_id" ref="model_realestate_procurement_evaluation_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_evaluation_criterion_company" model="ir.rule">
        <field name="name">Evaluation criterion: company</field>
        <field name="model_id" ref="model_realestate_procurement_evaluation_criterion"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_evaluation_round_company" model="ir.rule">
        <field name="name">Evaluation round: company</field>
        <field name="model_id" ref="model_realestate_procurement_evaluation_round"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_evaluation_candidate_company" model="ir.rule">
        <field name="name">Evaluation candidate: company</field>
        <field name="model_id" ref="model_realestate_procurement_evaluation_candidate"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_evaluation_assignment_company" model="ir.rule">
        <field name="name">Evaluation assignment: company</field>
        <field name="model_id" ref="model_realestate_procurement_evaluation_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_technical_evaluation_company" model="ir.rule">
        <field name="name">Technical sheet: company</field>
        <field name="model_id" ref="model_realestate_procurement_technical_evaluation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_technical_evaluation_line_company" model="ir.rule">
        <field name="name">Technical sheet line: company</field>
        <field name="model_id" ref="model_realestate_procurement_technical_evaluation_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_commercial_analysis_company" model="ir.rule">
        <field name="name">Commercial analysis: company</field>
        <field name="model_id" ref="model_realestate_procurement_commercial_analysis"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_commercial_adjustment_company" model="ir.rule">
        <field name="name">Commercial adjustment: company</field>
        <field name="model_id" ref="model_realestate_procurement_commercial_adjustment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_leveling_line_company" model="ir.rule">
        <field name="name">Leveling line: company</field>
        <field name="model_id" ref="model_realestate_procurement_leveling_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_evaluation_deviation_company" model="ir.rule">
        <field name="name">Evaluation deviation: company</field>
        <field name="model_id" ref="model_realestate_procurement_evaluation_deviation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <!-- M7 — award. Company isolation, same as every other control record. -->
    <record id="rule_procurement_award_company" model="ir.rule">
        <field name="name">Procurement award: company</field>
        <field name="model_id" ref="model_realestate_procurement_award"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_procurement_award_line_company" model="ir.rule">
        <field name="name">Procurement award line: company</field>
        <field name="model_id" ref="model_realestate_procurement_award_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_procurement_award_allocation_company" model="ir.rule">
        <field name="name">Procurement award allocation: company</field>
        <field name="model_id" ref="model_realestate_procurement_award_allocation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <!-- M8 — receipt inspection. Company isolation, same as every other
         control record. -->
    <record id="rule_receipt_inspection_company" model="ir.rule">
        <field name="name">Receipt inspection: company</field>
        <field name="model_id" ref="model_realestate_procurement_receipt_inspection"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_receipt_inspection_line_company" model="ir.rule">
        <field name="name">Receipt inspection line: company</field>
        <field name="model_id" ref="model_realestate_procurement_receipt_inspection_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>