<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================================
         M6 — Evaluation.

         The technical sheet form carries no monetary field, and there is no
         commercial field anywhere a technical evaluator can reach: the
         segregation is in the access rules, and these views simply do not
         offer what those rules refuse.
         ================================================================ -->

    <record id="view_evaluation_plan_form" model="ir.ui.view">
        <field name="name">evaluation.plan.form</field>
        <field name="model">realestate.procurement.evaluation.plan</field>
        <field name="arch" type="xml">
            <form string="Evaluation Plan">
                <header>
                    <button name="action_freeze" type="object" string="Freeze Basis"
                            class="btn-primary" invisible="state not in ('draft','review')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="state in ('draft','review')">
                        This basis is frozen. Criteria, weights, currency and rate basis
                        can no longer be edited — raise a revision instead.
                    </div>
                    <group>
                        <group string="Basis">
                            <field name="sourcing_event_id"/>
                            <field name="sourcing_version_id"/>
                            <field name="evaluation_method"/>
                            <field name="committee_mode"/>
                            <field name="tie_rule"/>
                        </group>
                        <group string="Money">
                            <field name="evaluation_currency_id"/>
                            <field name="rate_date_basis"/>
                            <field name="rate_date" invisible="rate_date_basis != 'fixed'"/>
                            <field name="financial_formula"/>
                        </group>
                        <group string="Weighting" invisible="evaluation_method != 'rated_combined'">
                            <field name="technical_weight"/>
                            <field name="commercial_weight"/>
                        </group>
                        <group string="Thresholds">
                            <field name="technical_threshold"/>
                            <field name="rated_weight_total"/>
                            <field name="allow_partial_bids"/>
                            <field name="bafo_policy"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Criteria">
                            <field name="criterion_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="criterion_type"/>
                                    <field name="category"/>
                                    <field name="max_score"/>
                                    <field name="weight" sum="Weight"/>
                                    <field name="minimum_score"/>
                                    <field name="evidence_expected" optional="hide"/>
                                    <field name="scoring_guidance" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Revision">
                            <group>
                                <field name="revision"/>
                                <field name="supersedes_id"/>
                                <field name="revision_reason"/>
                                <field name="frozen_on"/>
                                <field name="frozen_by_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_evaluation_plan_list" model="ir.ui.view">
        <field name="name">evaluation.plan.list</field>
        <field name="model">realestate.procurement.evaluation.plan</field>
        <field name="arch" type="xml">
            <list string="Evaluation Plans">
                <field name="name"/>
                <field name="sourcing_event_id"/>
                <field name="evaluation_method"/>
                <field name="evaluation_currency_id"/>
                <field name="revision"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_evaluation_plan" model="ir.actions.act_window">
        <field name="name">Evaluation Plans</field>
        <field name="res_model">realestate.procurement.evaluation.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_evaluation_round_form" model="ir.ui.view">
        <field name="name">evaluation.round.form</field>
        <field name="model">realestate.procurement.evaluation.round</field>
        <field name="arch" type="xml">
            <form string="Evaluation Round">
                <header>
                    <button name="action_open_technical" type="object" string="Open Technical"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_finalise_technical" type="object" string="Finalise Technical"
                            class="btn-primary" invisible="state != 'technical_open'"/>
                    <button name="action_open_commercial" type="object" string="Open Commercial"
                            class="btn-primary" invisible="state != 'technical_final'"/>
                    <button name="action_normalise" type="object" string="Normalise Offers"
                            invisible="state != 'commercial_open'"/>
                    <button name="action_print_evaluation_report" type="object"
                            string="Evaluation Report" class="btn-secondary"
                            invisible="state != 'finalised'"
                            groups="real_estate_procurement.group_procurement_user,real_estate_procurement.group_evaluation_commercial"/>
                    <button name="action_finalise" type="object" string="Finalise Evaluation"
                            class="btn-primary" invisible="state != 'commercial_open'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'finalised'">
                        This is an evaluation result, not an award. No purchase is
                        authorised by it: a tender RFQ still refuses to confirm.
                    </div>
                    <group>
                        <group>
                            <field name="sourcing_event_id"/>
                            <field name="plan_id"/>
                            <field name="round_type"/>
                            <field name="previous_round_id" invisible="round_type != 'bafo'"/>
                            <field name="result_status"/>
                        </group>
                        <group>
                            <field name="technical_opened_on"/>
                            <field name="technical_finalised_on"/>
                            <field name="commercial_opened_on"/>
                            <field name="finalised_on"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Candidates">
                            <field name="candidate_ids" readonly="1">
                                <list decoration-muted="not in_technical">
                                    <field name="partner_id"/>
                                    <field name="in_technical" widget="boolean_toggle"/>
                                    <field name="technical_score"/>
                                    <field name="technical_result" widget="badge"
                                           decoration-success="technical_result == 'responsive'"
                                           decoration-danger="technical_result == 'non_responsive'"/>
                                    <field name="score_spread"/>
                                    <field name="rank"/>
                                    <field name="is_tied" widget="boolean_toggle"/>
                                    <field name="exclusion_reason" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Committee">
                            <field name="assignment_ids">
                                <list editable="bottom">
                                    <field name="user_id"/>
                                    <field name="role"/>
                                    <field name="conflict_status" widget="badge"/>
                                    <field name="declared_on"/>
                                    <field name="declaration" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technical Sheets">
                            <field name="sheet_ids" readonly="1">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="evaluator_name"/>
                                    <field name="weighted_total"/>
                                    <field name="knockout_failed" widget="boolean_toggle"/>
                                    <field name="state" widget="badge"/>
                                    <field name="submitted_on"/>
                                </list>
                            </field>
                        </page>
                        <page string="Commercial" groups="real_estate_procurement.group_evaluation_commercial">
                            <field name="commercial_candidate_ids" readonly="1">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="financial_score"/>
                                    <field name="combined_score"/>
                                    <field name="rank"/>
                                </list>
                            </field>
                        </page>
                        <page string="Deviations">
                            <field name="deviation_ids">
                                <list editable="bottom">
                                    <field name="name" readonly="1"/>
                                    <field name="partner_id"/>
                                    <field name="deviation_type"/>
                                    <field name="is_material" widget="boolean_toggle"/>
                                    <field name="description"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_evaluation_round_list" model="ir.ui.view">
        <field name="name">evaluation.round.list</field>
        <field name="model">realestate.procurement.evaluation.round</field>
        <field name="arch" type="xml">
            <list string="Evaluation Rounds">
                <field name="name"/>
                <field name="sourcing_event_id"/>
                <field name="round_type"/>
                <field name="result_status"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_evaluation_round" model="ir.actions.act_window">
        <field name="name">Evaluations</field>
        <field name="res_model">realestate.procurement.evaluation.round</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_technical_evaluation_form" model="ir.ui.view">
        <field name="name">technical.evaluation.form</field>
        <field name="model">realestate.procurement.technical.evaluation</field>
        <field name="arch" type="xml">
            <form string="Technical Evaluation">
                <header>
                    <button name="action_submit" type="object" string="Submit Evaluation"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Technical evaluation only. Commercial values are not shown here
                        and are not readable by a technical evaluator.
                    </div>
                    <group>
                        <field name="round_id"/>
                        <field name="partner_id"/>
                        <field name="evaluator_name"/>
                        <field name="weighted_total"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="criterion_name" readonly="1"/>
                            <field name="criterion_type" readonly="1"/>
                            <field name="max_score" readonly="1"/>
                            <field name="weight" readonly="1"/>
                            <field name="result"/>
                            <field name="score"/>
                            <field name="rationale"/>
                            <field name="evidence_reference" optional="show"/>
                        </list>
                    </field>
                    <field name="overall_comment" placeholder="Overall technical comment"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_technical_evaluation" model="ir.actions.act_window">
        <field name="name">My Technical Evaluations</field>
        <field name="res_model">realestate.procurement.technical.evaluation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('evaluator_id', '=', uid)]</field>
    </record>

</odoo>
