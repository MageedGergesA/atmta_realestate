<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Expose the new flags on the product template form -->
    <record id="view_product_template_form_re" model="ir.ui.view">
        <field name="name">product.template.form.realestate</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase']" position="after">
                <page string="Real Estate" name="realestate">
                    <group>
                        <group>
                            <field name="is_construction_material"/>
                            <field name="is_property_fitting"/>
                        </group>
                        <group>
                            <field name="is_marketing_asset"/>
                            <field name="is_maintenance_consumable"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Catalog action — all RE-flagged products -->
    <record id="action_realestate_catalog" model="ir.actions.act_window">
        <field name="name">Material Catalog</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_realestate_product', '=', True)]</field>
        <field name="context">{'search_default_group_categ': 1}</field>
    </record>
</odoo>
