<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_evaluation_audit_wizard_form" model="ir.ui.view">
        <field name="name">evaluation.audit.wizard.form</field>
        <field name="model">realestate.procurement.evaluation.audit.wizard</field>
        <field name="arch" type="xml">
            <form string="Evaluation Integrity Audit">
                <div class="alert alert-info" role="alert">
                    This audit <strong>reports</strong> and never repairs.
                    Every finding is a question for a person to answer —
                    correcting one automatically would remove the evidence
                    that it ever happened.
                </div>
                <group invisible="state == 'done'">
                    <field name="company_id" options="{'no_create': True}"/>
                    <field name="round_id" options="{'no_create': True}"
                           placeholder="Leave empty to audit every evaluation in the company"/>
                    <field name="state" invisible="1"/>
                </group>
                <div invisible="state != 'done'">
                    <group>
                        <group string="Scope">
                            <field name="scope" readonly="1"/>
                            <field name="round_count" string="Rounds Audited" readonly="1"/>
                            <field name="run_on" readonly="1"/>
                        </group>
                        <group string="Findings by Severity">
                            <field name="critical_count" string="Critical" readonly="1"
                                   decoration-danger="critical_count &gt; 0"/>
                            <field name="high_count" string="High" readonly="1"
                                   decoration-warning="high_count &gt; 0"/>
                            <field name="medium_count" string="Medium" readonly="1"/>
                            <field name="low_count" string="Low" readonly="1"/>
                        </group>
                    </group>
                    <field name="summary" readonly="1" nolabel="1"/>
                    <separator string="Findings"/>
                    <field name="finding_ids" readonly="1" nolabel="1">
                        <list decoration-danger="severity == 'critical'"
                              decoration-warning="severity == 'high'">
                            <field name="severity" widget="badge"
                                   decoration-danger="severity == 'critical'"
                                   decoration-warning="severity == 'high'"/>
                            <field name="key"/>
                            <field name="summary"/>
                            <field name="record_count" string="Records"/>
                            <field name="references" optional="show"/>
                            <field name="remediation" optional="show"/>
                            <field name="severity_sequence" column_invisible="1"/>
                        </list>
                    </field>
                </div>
                <footer>
                    <button name="action_run" type="object" string="Run Audit"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_run" type="object" string="Run Again"
                            class="btn-secondary" invisible="state != 'done'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_evaluation_audit_wizard" model="ir.actions.act_window">
        <field name="name">Evaluation Integrity Audit</field>
        <field name="res_model">realestate.procurement.evaluation.audit.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(6, 0, [
            ref('real_estate_procurement.group_evaluation_manager'),
            ref('real_estate_procurement.group_procurement_manager')])]"/>
    </record>

</odoo>
