<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      The ONE action this module creates.

      `real_estate_construction.action_rfi` lists every RFI. A site engineer's
      workspace has to answer "what is waiting on ME", and no existing action
      carries that domain. Model, views and access rules are the existing ones;
      only the domain is new, and it names fields the model already defines:
      `assigned_to_id` and `state` (whose values are declared in the model's own
      selection: draft/open/under_review/answered/closed/reopened/void).
    -->
    <record id="action_v2_my_rfis" model="ir.actions.act_window">
        <field name="name">My RFIs</field>
        <field name="res_model">realestate.construction.rfi</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('assigned_to_id', '=', uid), ('state', 'in', ['open', 'under_review', 'reopened'])]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No RFI is waiting on you.</p>
            <p>Requests for information assigned to you appear here until they are answered or closed.</p>
        </field>
    </record>

</odoo>
