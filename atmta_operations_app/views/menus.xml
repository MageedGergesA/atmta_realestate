<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      Property Operations composes the operations that surround a rental portfolio
      but are not leasing: handover and service.

      The lease, billing, occupancy, property, reporting and rental-configuration
      screens used to be duplicated here under different names. Rental now owns
      that navigation in one place (rental re-architecture, decision 1), so this
      application no longer repeats it. Every action below is pre-existing.
    -->

    <menuitem id="menu_root"
              name="Property Operations"
              web_icon="atmta_operations_app,static/description/icon.png"
              sequence="10"/>

    <!-- ========================== HANDOVER ========================== -->
    <menuitem id="menu_handover_sec" name="Handover" parent="menu_root" sequence="50"
              groups="real_estate_handover.group_handover_user"/>
    <menuitem id="menu_handover_dashboard" name="Handover Dashboard" parent="menu_handover_sec" sequence="5"
              action="real_estate_handover.action_handover_dashboard"/>
    <menuitem id="menu_handovers" name="Handovers" parent="menu_handover_sec" sequence="10"
              action="real_estate_handover.action_handover"/>
    <menuitem id="menu_snagging" name="Snagging Issues" parent="menu_handover_sec" sequence="20"
              action="real_estate_handover.action_snagging"/>
    <menuitem id="menu_warranties" name="Warranties" parent="menu_handover_sec" sequence="30"
              action="real_estate_handover.action_warranty"/>

    <!-- ========================== SERVICE ========================== -->
    <!-- Service agents reach tickets here: the Customer Service root this app
         replaces is retired, so its own group must open the section. -->
    <menuitem id="menu_service" name="Service" parent="menu_root" sequence="60"
              groups="atmta_real_estate.group_realestate_readonly,real_estate_customer_service.group_service_user"/>
    <menuitem id="menu_service_dashboard" name="Service Dashboard" parent="menu_service" sequence="5"
              action="real_estate_customer_service.action_service_dashboard"
              groups="real_estate_customer_service.group_service_user"/>
    <menuitem id="menu_tickets" name="Tickets" parent="menu_service" sequence="10"
              action="real_estate_customer_service.action_customer_ticket"
              groups="real_estate_customer_service.group_service_user"/>
    <menuitem id="menu_my_work" name="My Maintenance" parent="menu_service" sequence="15"
              action="action_v2_my_maintenance"/>
    <menuitem id="menu_maintenance" name="Maintenance Requests" parent="menu_service" sequence="20"
              action="atmta_real_estate.action_maintenance_requests"/>

    <!-- ======================= CONFIGURATION ======================= -->
    <menuitem id="menu_config" name="Configuration" parent="menu_root" sequence="90"
              groups="atmta_real_estate.group_realestate_manager"/>
    <menuitem id="menu_cfg_handover_templates" name="Handover Checklist Templates" parent="menu_config" sequence="30"
              action="real_estate_handover.action_template"
              groups="real_estate_handover.group_handover_manager"/>
    <menuitem id="menu_cfg_ticket_categories" name="Ticket Categories" parent="menu_config" sequence="40"
              action="real_estate_customer_service.action_category"
              groups="real_estate_customer_service.group_service_manager"/>
    <menuitem id="menu_cfg_embed_tokens" name="Embed Tokens" parent="menu_config" sequence="50"
              action="real_estate_api.action_embed_token"
              groups="real_estate_api.group_realestate_api_user"/>

</odoo>
