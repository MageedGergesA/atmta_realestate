<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ================= ITP ================= -->
    <record id="view_itp_list" model="ir.ui.view">
        <field name="name">realestate.construction.itp.list</field>
        <field name="model">realestate.construction.itp</field>
        <field name="arch" type="xml">
            <list string="Inspection &amp; Test Plans"
                  decoration-success="state == 'active'"
                  decoration-muted="state in ('superseded','closed')">
                <field name="name"/>
                <field name="title"/>
                <field name="project_id"/>
                <field name="package_id" optional="hide"/>
                <field name="contractor_id" optional="show"/>
                <field name="discipline"/>
                <field name="revision"/>
                <field name="item_count"/>
                <field name="hold_point_count" optional="show"/>
                <field name="effective_date" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_itp_form" model="ir.ui.view">
        <field name="name">realestate.construction.itp.form</field>
        <field name="model">realestate.construction.itp</field>
        <field name="arch" type="xml">
            <form string="Inspection &amp; Test Plan">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'review'"/>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_create_revision" type="object"
                            string="Create Revision" invisible="state != 'active'"/>
                    <button name="action_supersede" type="object" string="Supersede"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,review,approved,active"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status" invisible="state != 'active'">
                        This plan is in force. Inspections record the revision they were
                        performed against — create a revision rather than editing it.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/> <span invisible="not revision">Rev <field name="revision" readonly="1" class="oe_inline"/></span></h1>
                        <h2><field name="title"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="package_id"/>
                            <field name="contractor_id"/>
                            <field name="wbs_id"/>
                            <field name="discipline"/>
                            <field name="activity"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="specification_section"/>
                            <field name="method_statement_revision_id"/>
                            <field name="submittal_id"/>
                            <field name="effective_date"/>
                            <field name="prepared_by_id"/>
                            <field name="approved_by_id"/>
                            <field name="supersedes_id" invisible="not supersedes_id"/>
                            <field name="superseded_by_id" invisible="not superseded_by_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checkpoints">
                            <field name="item_ids" readonly="state in ('active','superseded','closed')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="activity"/>
                                    <field name="description"/>
                                    <field name="inspection_point" widget="badge"
                                           decoration-danger="inspection_point == 'hold'"/>
                                    <field name="work_release_required" optional="hide"/>
                                    <field name="acceptance_criteria"/>
                                    <field name="frequency" optional="hide"/>
                                    <field name="responsible_contractor_id" optional="hide"/>
                                    <field name="inspector_id" optional="hide"/>
                                    <field name="reviewer_partner_id" optional="hide"/>
                                    <field name="checklist_template_id"/>
                                    <field name="certificate_required" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reference Documents">
                            <field name="document_revision_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Notes"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_itp" model="ir.actions.act_window">
        <field name="name">Inspection &amp; Test Plans</field>
        <field name="res_model">realestate.construction.itp</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_checklist_template" model="ir.actions.act_window">
        <field name="name">Checklist Templates</field>
        <field name="res_model">realestate.construction.checklist.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================= Inspection requests ================= -->
    <record id="view_inspection_request_list" model="ir.ui.view">
        <field name="name">realestate.construction.inspection.request.list</field>
        <field name="model">realestate.construction.inspection.request</field>
        <field name="arch" type="xml">
            <list string="Inspection Requests" decoration-warning="lead_time_shortfall">
                <field name="name"/>
                <field name="title"/>
                <field name="project_id"/>
                <field name="contractor_id"/>
                <field name="inspection_type"/>
                <field name="required_datetime"/>
                <field name="lead_time_hours" optional="show"/>
                <field name="inspector_id"/>
                <field name="inspection_count" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="lead_time_shortfall" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_inspection_request_form" model="ir.ui.view">
        <field name="name">realestate.construction.inspection.request.form</field>
        <field name="model">realestate.construction.inspection.request</field>
        <field name="arch" type="xml">
            <form string="Inspection Request">
                <header>
                    <button name="action_request" type="object" string="Request"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_schedule" type="object" string="Schedule"
                            invisible="state != 'requested'"/>
                    <button name="action_create_inspection" type="object"
                            string="Start Inspection" class="btn-primary"
                            invisible="state not in ('requested','scheduled')"/>
                    <button name="action_reject_request" type="object" string="Reject"
                            invisible="state in ('responded','closed','cancelled','rejected_request')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('responded','closed','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,requested,scheduled,in_progress,responded,closed"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="status" invisible="not lead_time_shortfall">
                        Short notice given. Recorded, not blocked.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="title"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="package_id"/>
                            <field name="contractor_id"/>
                            <field name="wbs_id"/>
                            <field name="location"/>
                            <field name="discipline"/>
                            <field name="inspection_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="itp_id"/>
                            <field name="itp_item_id"/>
                            <field name="requested_datetime"/>
                            <field name="required_datetime"/>
                            <field name="lead_time_hours"/>
                            <field name="requested_by_id"/>
                            <field name="inspector_id"/>
                            <field name="reviewer_partner_id"/>
                        </group>
                        <group string="Subject">
                            <field name="document_revision_id"/>
                            <field name="submittal_id"/>
                            <field name="product_id"/>
                            <field name="purchase_order_id"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                        </group>
                    </group>
                    <field name="inspection_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="inspection_datetime"/>
                            <field name="inspector_id"/>
                            <field name="result" widget="badge"/>
                            <field name="reinspection_sequence"/>
                        </list>
                    </field>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_inspection_request" model="ir.actions.act_window">
        <field name="name">Inspection Requests</field>
        <field name="res_model">realestate.construction.inspection.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================= Inspections ================= -->
    <record id="view_inspection_list" model="ir.ui.view">
        <field name="name">realestate.construction.inspection.list</field>
        <field name="model">realestate.construction.inspection</field>
        <field name="arch" type="xml">
            <list string="Inspections"
                  decoration-success="result in ('accepted','accepted_with_comments')"
                  decoration-danger="result == 'rejected'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="contractor_id"/>
                <field name="inspection_type"/>
                <field name="inspection_point" optional="show"/>
                <field name="wbs_id" optional="hide"/>
                <field name="location" optional="hide"/>
                <field name="inspection_datetime"/>
                <field name="inspector_id"/>
                <field name="document_revision_id" optional="hide"/>
                <field name="result" widget="badge"/>
                <field name="reinspection_sequence" optional="show"/>
                <field name="failed_line_count" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_inspection_form" model="ir.ui.view">
        <field name="name">realestate.construction.inspection.form</field>
        <field name="model">realestate.construction.inspection</field>
        <field name="arch" type="xml">
            <form string="Inspection">
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_accept" type="object"
                            string="Accept" class="btn-primary"
                            invisible="result or state not in ('draft','in_progress')"/>
                    <button name="action_accept_with_comments" type="object"
                            string="Accept with Comments"
                            invisible="result or state not in ('draft','in_progress')"/>
                    <button name="action_require_reinspection" type="object"
                            string="Reinspection Required"
                            invisible="result or state not in ('draft','in_progress')"/>
                    <button name="action_reject_result" type="object"
                            string="Reject"
                            invisible="result or state not in ('draft','in_progress')"/>
                    <button name="action_not_applicable" type="object"
                            string="Not Applicable"
                            invisible="result or state not in ('draft','in_progress')"/>
                    <button name="action_create_reinspection" type="object"
                            string="Raise Reinspection"
                            invisible="result in (False,'accepted','accepted_with_comments')"/>
                    <button name="action_create_observation" type="object"
                            string="Raise Observation" invisible="not result"/>
                    <button name="action_create_ncr" type="object"
                            string="Raise NCR" invisible="not result"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="not result or state == 'closed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,responded,closed"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status" invisible="not result">
                        This inspection has been recorded. Raise a reinspection rather
                        than rewriting what was found.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="result" widget="badge" readonly="1"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="request_id"/>
                            <field name="package_id"/>
                            <field name="contractor_id"/>
                            <field name="wbs_id"/>
                            <field name="location"/>
                            <field name="discipline"/>
                            <field name="inspection_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="itp_id"/>
                            <field name="itp_item_id"/>
                            <field name="itp_revision"/>
                            <field name="inspection_point"/>
                            <field name="document_revision_id"/>
                            <field name="submittal_id"/>
                            <field name="specification_reference"/>
                            <field name="inspector_id"/>
                            <field name="witness_partner_id"/>
                            <field name="inspection_datetime"/>
                        </group>
                        <group string="Chain" invisible="not parent_inspection_id and not has_reinspection">
                            <field name="parent_inspection_id"/>
                            <field name="reinspection_sequence"/>
                            <field name="reinspection_reason"/>
                            <field name="has_reinspection"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checklist">
                            <field name="checklist_line_ids" readonly="state == 'closed'">
                                <list editable="bottom"
                                      decoration-danger="passed == 'fail'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="item_type"/>
                                    <field name="acceptance_criteria" optional="hide"/>
                                    <field name="passed" widget="badge"/>
                                    <field name="measured_value"/>
                                    <field name="minimum_value" optional="hide"/>
                                    <field name="maximum_value" optional="hide"/>
                                    <field name="uom_id" optional="hide"/>
                                    <field name="within_tolerance" optional="hide"/>
                                    <field name="disposition"/>
                                    <field name="disposition_reason" optional="hide"/>
                                    <field name="comments"/>
                                    <field name="is_mandatory" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Comments">
                            <field name="comments"/>
                            <field name="follow_up_required"/>
                        </page>
                        <page string="Findings">
                            <field name="observation_ids" readonly="1"/>
                            <field name="ncr_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_inspection" model="ir.actions.act_window">
        <field name="name">Inspections</field>
        <field name="res_model">realestate.construction.inspection</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================= Observations ================= -->
    <record id="view_observation_list" model="ir.ui.view">
        <field name="name">realestate.construction.quality.observation.list</field>
        <field name="model">realestate.construction.quality.observation</field>
        <field name="arch" type="xml">
            <list string="Quality Observations" decoration-danger="is_overdue">
                <field name="name"/>
                <field name="description"/>
                <field name="project_id"/>
                <field name="contractor_id"/>
                <field name="location" optional="hide"/>
                <field name="severity" widget="badge"/>
                <field name="assigned_to_id"/>
                <field name="due_date"/>
                <field name="inspection_id" optional="hide"/>
                <field name="ncr_id" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_observation_form" model="ir.ui.view">
        <field name="name">realestate.construction.quality.observation.form</field>
        <field name="model">realestate.construction.quality.observation</field>
        <field name="arch" type="xml">
            <form string="Quality Observation">
                <header>
                    <button name="action_require_action" type="object"
                            string="Require Action" invisible="state != 'open'"/>
                    <button name="action_ready_for_verification" type="object"
                            string="Ready for Verification" class="btn-primary"
                            invisible="state not in ('open','action_required')"/>
                    <button name="action_verify" type="object" string="Verify &amp; Close"
                            class="btn-primary" invisible="state != 'ready_for_verification'"/>
                    <button name="action_open_reason_wizard" type="object"
                            string="Escalate to NCR" invisible="ncr_id or state == 'closed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,action_required,ready_for_verification,closed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="inspection_id"/>
                            <field name="contractor_id"/>
                            <field name="wbs_id"/>
                            <field name="location"/>
                            <field name="severity"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="assigned_to_id"/>
                            <field name="due_date"/>
                            <field name="completed_date"/>
                            <field name="verified_by_id"/>
                            <field name="verified_date"/>
                            <field name="ncr_id"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What is wrong"/>
                    <field name="corrective_action" placeholder="What was done about it"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_observation" model="ir.actions.act_window">
        <field name="name">Quality Observations</field>
        <field name="res_model">realestate.construction.quality.observation</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================= NCR ================= -->
    <record id="view_ncr_list" model="ir.ui.view">
        <field name="name">realestate.construction.ncr.list</field>
        <field name="model">realestate.construction.ncr</field>
        <field name="arch" type="xml">
            <list string="Non-Conformance Reports" decoration-danger="is_overdue"
                  decoration-success="state in ('verified','closed')">
                <field name="name"/>
                <field name="title"/>
                <field name="project_id"/>
                <field name="contractor_id"/>
                <field name="severity" widget="badge"
                       decoration-danger="severity == 'critical'"/>
                <field name="discovery_date"/>
                <field name="target_completion_date"/>
                <field name="proposed_disposition" optional="show"/>
                <field name="root_cause_category" optional="hide"/>
                <field name="estimated_rework_cost" optional="show" sum="Exposure"/>
                <field name="cost_impact" optional="hide"/>
                <field name="change_event_id" optional="hide"/>
                <field name="closure_time_days" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ncr_form" model="ir.ui.view">
        <field name="name">realestate.construction.ncr.form</field>
        <field name="model">realestate.construction.ncr</field>
        <field name="arch" type="xml">
            <form string="Non-Conformance Report">
                <header>
                    <button name="action_open" type="object" string="Open"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_investigate" type="object" string="Investigate"
                            invisible="state not in ('open','reopened')"/>
                    <button name="action_propose_disposition" type="object"
                            string="Propose Disposition" class="btn-primary"
                            invisible="state != 'under_investigation'"/>
                    <button name="action_approve_disposition" type="object"
                            string="Approve Disposition" class="btn-primary"
                            invisible="state != 'disposition_proposed'"/>
                    <button name="action_ready_for_verification" type="object"
                            string="Ready for Verification"
                            invisible="state != 'corrective_action'"/>
                    <button name="action_create_reinspection" type="object"
                            string="Verification Inspection"
                            invisible="state not in ('corrective_action','ready_for_verification')"/>
                    <button name="action_verify" type="object" string="Verify"
                            class="btn-primary" invisible="state != 'ready_for_verification'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'verified'"/>
                    <button name="action_open_reason_wizard" type="object"
                            string="Reopen" invisible="state not in ('verified','closed')"/>
                    <button name="action_create_change_event" type="object"
                            string="Create Change Event" invisible="change_event_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,under_investigation,disposition_proposed,corrective_action,ready_for_verification,verified,closed"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status" invisible="cost_impact != 'potential'">
                        Estimated rework is <strong>quality exposure</strong>. It is not
                        actual cost and authorises no budget — use Create Change Event.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="title"/></h2>
                    </div>
                    <group>
                        <group string="Where">
                            <field name="project_id"/>
                            <field name="package_id"/>
                            <field name="contractor_id"/>
                            <field name="wbs_id"/>
                            <field name="cost_code_id"/>
                            <field name="location"/>
                            <field name="discipline"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Origin">
                            <field name="source"/>
                            <field name="source_inspection_id"/>
                            <field name="source_observation_id"/>
                            <field name="requirement_violated"/>
                            <field name="document_revision_id"/>
                            <field name="specification_reference"/>
                            <field name="discovery_date"/>
                            <field name="raised_by_id"/>
                            <field name="severity"/>
                        </group>
                        <group string="Action">
                            <field name="assigned_to_id"/>
                            <field name="proposed_disposition"/>
                            <field name="disposition_approved_by_id"/>
                            <field name="root_cause_category"/>
                            <field name="target_completion_date"/>
                            <field name="actual_completion_date"/>
                            <field name="verification_method"/>
                            <field name="verified_by_id"/>
                            <field name="verified_date"/>
                            <field name="reinspection_id"/>
                        </group>
                        <group string="Impact">
                            <field name="cost_impact"/>
                            <field name="estimated_rework_cost"/>
                            <field name="schedule_impact"/>
                            <field name="estimated_delay_days"/>
                            <field name="change_event_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description"><field name="description"/></page>
                        <page string="Investigation">
                            <field name="immediate_action" placeholder="What was done straight away"/>
                            <field name="root_cause" placeholder="Why it happened"/>
                        </page>
                        <page string="Corrective Action">
                            <field name="corrective_action"/>
                            <field name="preventive_action"
                                   placeholder="How recurrence is prevented (optional)"/>
                        </page>
                        <page string="Reopening" invisible="not reopen_reason">
                            <group>
                                <field name="reopened_by_id"/>
                                <field name="reopened_date"/>
                                <field name="reopen_reason"/>
                                <field name="closure_date"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ncr" model="ir.actions.act_window">
        <field name="name">Non-Conformance Reports</field>
        <field name="res_model">realestate.construction.ncr</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Wave 23 — the daily-report list and form moved to
         `atmta_construction_site`, which owns the model. Quality sits below
         site, so it cannot declare a view on a model defined above it. -->

    <!-- ================= Reason prompt ================= -->
    <record id="view_reason_wizard_form" model="ir.ui.view">
        <field name="name">realestate.construction.reason.wizard.form</field>
        <field name="model">realestate.construction.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Reason">
                <group>
                    <field name="mode" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="reason" nolabel="1"
                           placeholder="Why — this is kept on the record."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
