        <record id="rule_realestate_construction_inspection_manager" model="ir.rule">
                <field name="name">realestate.construction.inspection: manager sees every project</field>
                <field name="model_id" ref="model_realestate_construction_inspection"/>
                <field name="domain_force">[(1, '=', 1)]</field>
                <field name="groups" eval="[(4, ref('atmta_roles.group_construction_manager'))]"/>
            </record>
