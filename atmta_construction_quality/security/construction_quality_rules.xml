<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!--
            Wave 15 — the company rules for the quality models.

            Only the company and global rules moved; the project-team rules
            stayed in `real_estate_construction`, because their domains read
            `project_id.construction_member_ids`, a field that module declares
            on the project. Group references are rebound to the canonical roles
            through the bridge Wave 12 added: this module sits below the one
            that declares the legacy construction groups.
        -->
        <record id="rule_realestate_construction_checklist_template_company" model="ir.rule">
                <field name="name">realestate.construction.checklist.template: company</field>
                <field name="model_id" ref="model_realestate_construction_checklist_template"/>
                <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
                <field name="global" eval="True"/>
            </record>
        <record id="rule_realestate_construction_inspection_company" model="ir.rule">
                <field name="name">realestate.construction.inspection: company</field>
                <field name="model_id" ref="model_realestate_construction_inspection"/>
                <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
                <field name="global" eval="True"/>
            </record>
