<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!--
            Wave 15 — the company rules for the quality models.

            Only the company and global rules moved; the project-team rules
            stayed in `real_estate_construction`, because their domains read
            `project_id.construction_member_ids`, a field that module declares
            on the project. Group references are rebound to the canonical roles
            through the bridge Wave 12 added: this module sits below the one
            that declares the legacy construction groups.
        -->
        <record id="rule_realestate_construction_checklist_template_company" model="ir.rule">
                <field name="name">realestate.construction.checklist.template: company</field>
                <field name="model_id" ref="model_realestate_construction_checklist_template"/>
                <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
                <field name="global" eval="True"/>
            </record>
        <record id="rule_realestate_construction_inspection_company" model="ir.rule">
                <field name="name">realestate.construction.inspection: company</field>
                <field name="model_id" ref="model_realestate_construction_inspection"/>
                <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
                <field name="global" eval="True"/>
            </record>
        <record id="rule_realestate_construction_inspection_line_company" model="ir.rule">
                <field name="name">realestate.construction.inspection.line: company</field>
                <field name="model_id" ref="model_realestate_construction_inspection_line"/>
                <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
                <field name="global" eval="True"/>
            </record>
        <record id="rule_realestate_construction_inspection_request_company" model="ir.rule">
                <field name="name">realestate.construction.inspection.request: company</field>
                <field name="model_id" ref="model_realestate_construction_inspection_request"/>
                <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
                <field name="global" eval="True"/>
            </record>
        <record id="rule_realestate_construction_itp_company" model="ir.rule">
                <field name="name">realestate.construction.itp: company</field>
                <field name="model_id" ref="model_realestate_construction_itp"/>
                <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
                <field name="global" eval="True"/>
            </record>
        <record id="rule_realestate_construction_itp_item_company" model="ir.rule">
                <field name="name">realestate.construction.itp.item: company</field>
                <field name="model_id" ref="model_realestate_construction_itp_item"/>
                <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
                <field name="global" eval="True"/>
            </record>
        <record id="rule_realestate_construction_ncr_company" model="ir.rule">
                <field name="name">realestate.construction.ncr: company</field>
                <field name="model_id" ref="model_realestate_construction_ncr"/>
                <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
                <field name="global" eval="True"/>
            </record>
        <record id="rule_realestate_construction_quality_observation_company" model="ir.rule">
                <field name="name">realestate.construction.quality.observation: company</field>
                <field name="model_id" ref="model_realestate_construction_quality_observation"/>
                <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
                <field name="global" eval="True"/>
            </record>
        <record id="rule_realestate_construction_inspection_manager" model="ir.rule">
                <field name="name">realestate.construction.inspection: manager sees every project</field>
                <field name="model_id" ref="model_realestate_construction_inspection"/>
                <field name="domain_force">[(1, '=', 1)]</field>
                <field name="groups" eval="[(4, ref('atmta_roles.group_construction_manager'))]"/>
            </record>
        <record id="rule_realestate_construction_inspection_request_manager" model="ir.rule">
                <field name="name">realestate.construction.inspection.request: manager sees every project</field>
                <field name="model_id" ref="model_realestate_construction_inspection_request"/>
                <field name="domain_force">[(1, '=', 1)]</field>
                <field name="groups" eval="[(4, ref('atmta_roles.group_construction_manager'))]"/>
            </record>
        <record id="rule_realestate_construction_itp_manager" model="ir.rule">
                <field name="name">realestate.construction.itp: manager sees every project</field>
                <field name="model_id" ref="model_realestate_construction_itp"/>
                <field name="domain_force">[(1, '=', 1)]</field>
                <field name="groups" eval="[(4, ref('atmta_roles.group_construction_manager'))]"/>
            </record>
        <record id="rule_realestate_construction_ncr_manager" model="ir.rule">
