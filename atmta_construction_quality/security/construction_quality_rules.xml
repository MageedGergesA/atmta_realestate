                <field name="groups" eval="[(4, ref('atmta_roles.group_construction_manager'))]"/>
            </record>

        <!--
            Wave 25 — the project-team rules, finally beside their models.

            These stayed in `real_estate_construction` through every earlier
            wave for one reason, recorded in this file at the time: their
            domains read `project_id.construction_member_ids`, and a rule may
            be declared above the model it guards but never below the field it
            reads. Wave 25 moved that field down to
            `atmta_construction_core`, which removed the pin.

            The group is rebound from the legacy `group_construction_user` to
            the canonical role it already implies. Every legacy member is
            materialised into the canonical group by the Wave 12 bridge, so
            nobody covered by these rules stops being covered. Users holding
            only the canonical role start being covered, which tightens the
            filter and never loosens it. That widening was measured before
            and after, per model, per user.

            `(6, 0, [...])` and not `(4, ...)`: the records already exist and
            carry the legacy group, and appending would leave both bound.
        -->

        <record id="rule_realestate_construction_inspection_project_member" model="ir.rule">
            <field name="name">realestate.construction.inspection: project team</field>
            <field name="model_id" ref="model_realestate_construction_inspection"/>
            <field name="domain_force">['|', '|', ('project_id', '=', False), ('project_id.construction_member_ids', '=', False), ('project_id.construction_member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(6, 0, [ref('atmta_roles.group_construction_site_user')])]"/>
        </record>

        <record id="rule_realestate_construction_inspection_request_project_member" model="ir.rule">
            <field name="name">realestate.construction.inspection.request: project team</field>
            <field name="model_id" ref="model_realestate_construction_inspection_request"/>
            <field name="domain_force">['|', '|', ('project_id', '=', False), ('project_id.construction_member_ids', '=', False), ('project_id.construction_member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(6, 0, [ref('atmta_roles.group_construction_site_user')])]"/>
        </record>

        <record id="rule_realestate_construction_itp_project_member" model="ir.rule">
            <field name="name">realestate.construction.itp: project team</field>
            <field name="model_id" ref="model_realestate_construction_itp"/>
            <field name="domain_force">['|', '|', ('project_id', '=', False), ('project_id.construction_member_ids', '=', False), ('project_id.construction_member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(6, 0, [ref('atmta_roles.group_construction_site_user')])]"/>
        </record>

        <record id="rule_realestate_construction_ncr_project_member" model="ir.rule">
            <field name="name">realestate.construction.ncr: project team</field>
            <field name="model_id" ref="model_realestate_construction_ncr"/>
            <field name="domain_force">['|', '|', ('project_id', '=', False), ('project_id.construction_member_ids', '=', False), ('project_id.construction_member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(6, 0, [ref('atmta_roles.group_construction_site_user')])]"/>
        </record>

        <record id="rule_realestate_construction_quality_observation_project_member" model="ir.rule">
            <field name="name">realestate.construction.quality.observation: project team</field>
            <field name="model_id" ref="model_realestate_construction_quality_observation"/>
            <field name="domain_force">['|', '|', ('project_id', '=', False), ('project_id.construction_member_ids', '=', False), ('project_id.construction_member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(6, 0, [ref('atmta_roles.group_construction_site_user')])]"/>
        </record>
    </data>
</odoo>
