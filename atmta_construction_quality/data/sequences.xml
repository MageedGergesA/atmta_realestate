<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!--
      Wave 15 — the sequences for the numbered quality records.

      `noupdate` as they were. That is also why the hand-over names them:
      `_process_end` skips `noupdate` records when it cleans up.
    -->
    <record id="seq_construction_itp" model="ir.sequence">
        <field name="name">Construction ITP</field>
        <field name="code">realestate.construction.itp</field>
        <field name="prefix">ITP/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_construction_inspection_request" model="ir.sequence">
        <field name="name">Inspection Request</field>
        <field name="code">realestate.construction.inspection.request</field>
        <field name="prefix">IR/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_construction_inspection" model="ir.sequence">
        <field name="name">Quality Inspection</field>
        <field name="code">realestate.construction.inspection</field>
        <field name="prefix">INS/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_construction_observation" model="ir.sequence">
        <field name="name">Quality Observation</field>
        <field name="code">realestate.construction.quality.observation</field>
        <field name="prefix">OBS/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_construction_ncr" model="ir.sequence">
        <field name="name">Non-Conformance Report</field>
        <field name="code">realestate.construction.ncr</field>
        <field name="prefix">NCR/%(year)s/</field>
        <field name="padding">4</field>
    </record>
</odoo>
