msgstr "لا يقبل من رفع عدم المطابقة الحرجة قبولها على حالها."

#. module: atmta_construction_quality
#. odoo-python
#: code:addons/atmta_construction_quality/models/quality.py:0
msgid "A disposition without a root cause fixes this one and nothing else."
msgstr "المعالجة دون سبب جذري تصلح هذه الحالة فقط ولا شيء غيرها."

#. module: atmta_construction_quality
#. odoo-python
#: code:addons/atmta_construction_quality/models/quality.py:0
msgid "A verified NCR cannot be voided."
msgstr "لا يمكن إبطال تقرير عدم مطابقة تم التحقق منه."

#. module: atmta_construction_quality
#. odoo-python
