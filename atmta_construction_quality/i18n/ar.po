#. module: atmta_construction_quality
#. odoo-python
#: code:addons/atmta_construction_quality/models/quality.py:0
msgid ""
"%(count)s mandatory checklist item(s) have no answer. An inspection cannot "
"be accepted on unanswered checks."
msgstr ""
"%(count)s بند إلزامي في قائمة التحقق بلا إجابة. لا يمكن قبول تفتيش بفحوصات "
"لم تتم الإجابة عليها."

#. module: atmta_construction_quality
#. odoo-python
#: code:addons/atmta_construction_quality/models/quality.py:0
msgid ""
"%(items)s failed with no disposition recorded. A failure nobody resolved is "
"the one that reaches the client."
msgstr ""
"%(items)s فشل دون تسجيل معالجة. الإخفاق الذي لم يعالجه أحد هو الذي يصل إلى "
"العميل."

#. module: atmta_construction_quality
#. odoo-python
#: code:addons/atmta_construction_quality/models/quality.py:0
msgid ""
"%(name)s revision %(rev)s is already active. Supersede it rather than "
"activating a second one."
msgstr ""
"المراجعة %(rev)s من %(name)s سارية بالفعل. استبدلها بدلًا من تفعيل مراجعة "
"ثانية."

#. module: atmta_construction_quality
#. odoo-python
#: code:addons/atmta_construction_quality/models/quality.py:0
msgid ""
"%(refs)s are in force or historical. Create a revision rather than editing "
"the plan inspections were performed against."
msgstr ""
"%(refs)s سارية أو تاريخية. أنشئ مراجعة بدلًا من تعديل الخطة التي أُجري "
"التفتيش على أساسها."

#. module: atmta_construction_quality
#. odoo-python
#: code:addons/atmta_construction_quality/models/quality.py:0
msgid ""
"%(refs)s have been carried out and recorded. Raise a reinspection rather "
"than rewriting what was found."
msgstr ""
"%(refs)s تم تنفيذها وتسجيلها. اطلب إعادة تفتيش بدلًا من إعادة كتابة ما تم "
"رصده."

#. module: atmta_construction_quality
#. odoo-python
#: code:addons/atmta_construction_quality/models/quality.py:0
msgid ""
"%(refs)s have been verified or closed. Reopen with a reason rather than "
"editing the record somebody signed."
msgstr ""
"%(refs)s تم التحقق منها أو إغلاقها. أعد فتحها مع ذكر السبب بدلًا من تعديل "
"سجل وقّعه أحدهم."

#. module: atmta_construction_quality
#. odoo-python
#: code:addons/atmta_construction_quality/models/ncr_change_event.py:0
msgid "%s already has a change event."
msgstr "%s لديه حدث تغيير بالفعل."

#. module: atmta_construction_quality
#. odoo-python
#: code:addons/atmta_construction_quality/models/quality.py:0
msgid "%s already has a result. Raise a reinspection instead."
msgstr "%s لديه نتيجة بالفعل. اطلب إعادة تفتيش بدلًا من ذلك."

#. module: atmta_construction_quality
#. odoo-python
#: code:addons/atmta_construction_quality/models/quality.py:0
msgid "%s has already been escalated."
msgstr "تم تصعيد %s بالفعل."

#. module: atmta_construction_quality
#. odoo-python
#: code:addons/atmta_construction_quality/models/quality.py:0
msgid "%s is not open for a result."
msgstr "%s غير مفتوح لتسجيل نتيجة."

#. module: atmta_construction_quality
#. odoo-python
#: code:addons/atmta_construction_quality/models/quality.py:0
msgid "%s was accepted — there is nothing to reinspect."
msgstr "تم قبول %s — لا يوجد ما يستدعي إعادة التفتيش."

#. module: atmta_construction_quality
#. odoo-python
#: code:addons/atmta_construction_quality/models/quality.py:0
msgid ""
"'%s' failed and has no disposition. A failure nobody resolved is the one "
"that reaches the client."
msgstr ""
"'%s' فشل ولا توجد له معالجة. الإخفاق الذي لم يعالجه أحد هو الذي يصل إلى "
"العميل."

#. module: atmta_construction_quality
#. odoo-python
#: code:addons/atmta_construction_quality/models/quality.py:0
msgid "A closed observation is part of the record."
msgstr "الملاحظة المغلقة جزء من السجل."

#. module: atmta_construction_quality
#. odoo-python
#: code:addons/atmta_construction_quality/models/quality.py:0
msgid ""
"A critical non-conformance is not accepted as-is by the person who raised "
