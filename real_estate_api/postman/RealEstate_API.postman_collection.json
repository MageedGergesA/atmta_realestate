    {
      "name": "CORS / DB Routing",
      "item": [
        {
          "name": "CORS preflight (allowed origin)",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "{{website_origin}}"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "Authorization, Content-Type, X-Odoo-Database"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/interests",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "interests"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));",
                  "pm.test('Allow-Origin echoed', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql(pm.collectionVariables.get('website_origin')));",
                  "pm.test('Allow-Headers lists Authorization, X-Odoo-Database', () => {",
                  "    const h = pm.response.headers.get('Access-Control-Allow-Headers') || '';",
                  "    pm.expect(h).to.include('Authorization');",
                  "    pm.expect(h).to.include('X-Odoo-Database');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "DB selection \u2014 wrong db name (no match)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Odoo-Database",
                "value": "this_db_does_not_exist",
                "disabled": false
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/projects?limit=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "projects"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Replace the collection-level X-Odoo-Database with our bogus one.",
                  "pm.request.headers.upsert({ key: 'X-Odoo-Database', value: 'this_db_does_not_exist' });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 or 200 monodb-fallback', () => pm.expect([200, 404]).to.include(pm.response.code));",
                  "// On a single-DB host Odoo's monodb shortcut takes over after",
                  "// our header is rejected by dbfilter, which is acceptable.",
                  "// On a multi-DB host the server should refuse \u2014 neither outcome is a silent fallback to a different db."
                ]
              }
            }
          ]
        }
      ]
    }
  ]
