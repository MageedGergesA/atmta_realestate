<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_embed_token_list" model="ir.ui.view">
        <field name="name">realestate.embed.token.list</field>
        <field name="model">realestate.embed.token</field>
        <field name="arch" type="xml">
            <list string="Embed Tokens" default_order="create_date desc"
                  decoration-muted="is_expired">
                <field name="create_date"/>
                <field name="kind"/>
                <field name="resource_display"/>
                <field name="allowed_origins"/>
                <field name="expires_at"/>
                <field name="is_expired" widget="boolean_toggle" readonly="1"/>
                <field name="used_count"/>
                <field name="last_used_at" optional="hide"/>
                <field name="last_used_ip" optional="hide"/>
                <field name="created_by_key" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_embed_token_form" model="ir.ui.view">
        <field name="name">realestate.embed.token.form</field>
        <field name="model">realestate.embed.token</field>
        <field name="arch" type="xml">
            <form string="Embed Token" create="false">
                <sheet>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="kind" readonly="1"/>
                            <field name="resource_model" readonly="1"/>
                            <field name="resource_id" readonly="1"/>
                            <field name="resource_display" readonly="1"/>
                            <field name="token" readonly="1"/>
                        </group>
                        <group>
                            <field name="allowed_origins" readonly="1"/>
                            <field name="expires_at" readonly="1"/>
                            <field name="is_expired" readonly="1"/>
                            <field name="used_count" readonly="1"/>
                            <field name="last_used_at" readonly="1"/>
                            <field name="last_used_ip" readonly="1"/>
                            <field name="last_used_origin" readonly="1"/>
                            <field name="created_by_key" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Theme Overrides">
                            <field name="theme_json" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_embed_token" model="ir.actions.act_window">
        <field name="name">Embed Tokens</field>
        <field name="res_model">realestate.embed.token</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
