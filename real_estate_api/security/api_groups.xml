<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_realestate_api_user" model="res.groups">
            <field name="name">Real Estate API · User</field>
            <field name="category_id" ref="base.module_category_sales"/>
            <field name="comment">
                Holders may mint API keys with scope "real_estate_api"
                and call the catalog endpoints anonymously is not gated
                by this group — but interest submission, embed token
                minting, and admin views on captured leads ARE.
            </field>
        </record>

        <record id="group_realestate_api_manager" model="res.groups">
            <field name="name">Real Estate API · Manager</field>
            <field name="category_id" ref="base.module_category_sales"/>
            <field name="implied_ids" eval="[(4, ref('group_realestate_api_user'))]"/>
            <field name="comment">
                Manage embed tokens (mint, revoke, audit) and view the
                rate-limit counter table for diagnostics.
            </field>
        </record>

    </data>
</odoo>
