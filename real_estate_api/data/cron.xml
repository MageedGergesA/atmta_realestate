<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_gc_embed_tokens" model="ir.cron">
            <field name="name">Real Estate API: prune expired embed tokens</field>
            <field name="model_id" ref="model_realestate_embed_token"/>
            <field name="state">code</field>
            <field name="code">model._gc()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_gc_rate_limit" model="ir.cron">
            <field name="name">Real Estate API: prune rate-limit windows</field>
            <field name="model_id" ref="model_realestate_api_ratelimit"/>
            <field name="state">code</field>
            <field name="code">model._gc()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
