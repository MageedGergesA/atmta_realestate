#. module: atmta_construction_cost
#. odoo-python
#: code:addons/atmta_construction_cost/models/cost_report.py:0
msgid ""
"Actual cost is understated by %(amount)s: retention on %(count)s posted "
"certificate(s) was booked as a negative expense line rather than a retention"
" liability. The posted entries are not rewritten; Finance reclassification "
"is required. See IMPLEMENTATION_REPORT.md §Retention."
msgstr ""
"التكلفة الفعلية أقل من حقيقتها بمقدار %(amount)s: المحتجزات على %(count)s من"
" شهادات الدفع المرحّلة سُجّلت كبند مصروف سالب بدلًا من التزام محتجزات. لا "
"يُعاد تحرير القيود المرحّلة؛ ويلزم أن تعيد الإدارة المالية تصنيفها. راجع "
"IMPLEMENTATION_REPORT.md §المحتجزات."

#. module: atmta_construction_cost
#. odoo-python
#: code:addons/atmta_construction_cost/models/forecast.py:0
msgid ""
"Actual cost on this code cannot be attributed to its commitment, so "
"remaining commitment is unknown. Use a manual estimate rather than guessing."
msgstr ""
"لا يمكن نسب التكلفة الفعلية على هذا الرمز إلى الالتزام الخاص به، لذا فإن "
"الالتزام المتبقي غير معروف. استخدم تقديرًا يدويًا بدلًا من التخمين."

#. module: atmta_construction_cost
#: model:ir.model.fields,field_description:atmta_construction_cost.field_realestate_construction_forecast_line__actual_amount
msgid "Actual to Date"
msgstr "الفعلي حتى تاريخه"

#. module: atmta_construction_cost
#. odoo-python
#: code:addons/atmta_construction_cost/models/forecast.py:0
msgid "Actuals and commitments refreshed."
msgstr "تم تحديث التكاليف الفعلية والالتزامات."

#. module: atmta_construction_cost
#: model:ir.model.fields,field_description:atmta_construction_cost.field_realestate_construction_forecast_line__adjustment_total
