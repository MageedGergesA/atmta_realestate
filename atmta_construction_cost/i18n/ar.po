#: model:ir.model.fields,field_description:atmta_construction_cost.field_realestate_construction_budget_change_line__amount
#: model:ir.model.fields,field_description:atmta_construction_cost.field_realestate_construction_commitment_change__amount
#: model:ir.model.fields,field_description:atmta_construction_cost.field_realestate_construction_forecast_adjustment__amount
#: model:ir.model.fields,field_description:atmta_construction_cost.field_realestate_construction_revenue_change__amount
msgid "Amount"
msgstr "المبلغ"

#. module: atmta_construction_cost
#: model:ir.model.fields,field_description:atmta_construction_cost.field_realestate_construction_budget_line__amount_mode
msgid "Amount Mode"
msgstr "طريقة احتساب المبلغ"

#. module: atmta_construction_cost
#. odoo-python
#: code:addons/atmta_construction_cost/models/forecast.py:0
msgid "An approved forecast cannot be reopened."
msgstr "لا يمكن إعادة فتح توقع معتمد."

#. module: atmta_construction_cost
#. odoo-python
#: code:addons/atmta_construction_cost/models/forecast.py:0
msgid ""
"An approved forecast is a record of what was believed on %(date)s. Create a "
"new forecast rather than refreshing this one."
msgstr ""
"التوقع المعتمد سجل لما كان متوقعًا في %(date)s. أنشئ توقعًا جديدًا بدلًا من "
"تحديث هذا التوقع."

#. module: atmta_construction_cost
#. odoo-python
#: code:addons/atmta_construction_cost/models/forecast.py:0
msgid ""
"An approved forecast is history. Supersede it with a later one instead of "
"cancelling it."
msgstr ""
"التوقع المعتمد أصبح سجلًا تاريخيًا. استبدله بتوقع لاحق بدلًا من إلغائه."

#. module: atmta_construction_cost
#: model:ir.model.fields,help:atmta_construction_cost.field_realestate_construction_risk__management_rating
msgid ""
"An explicit human rating, which overrides the arithmetic on the register "
"when set."
msgstr "تقييم بشري صريح، يتجاوز الحساب الآلي في السجل عند تحديده."

#. module: atmta_construction_cost
#. odoo-python
#: code:addons/atmta_construction_cost/models/cost_sheet.py:0
msgid "Analytic postings"
msgstr "القيود التحليلية"

#. module: atmta_construction_cost
#: model:ir.model.fields.selection,name:atmta_construction_cost.selection__realestate_construction_forecast_adjustment__adjustment_type__anticipated_variation
msgid "Anticipated Variation"
msgstr "تغيير متوقع"

#. module: atmta_construction_cost
#: model_terms:ir.ui.view,arch_db:atmta_construction_cost.view_construction_budget_form
#: model_terms:ir.ui.view,arch_db:atmta_construction_cost.view_construction_forecast_form
msgid "Approve"
msgstr "اعتماد"

#. module: atmta_construction_cost
#. odoo-python
#: code:addons/atmta_construction_cost/models/budget.py:0
msgid ""
"Approve the revision first. A baseline is not withdrawn until there is "
"something to put in its place."
