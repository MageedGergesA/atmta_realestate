<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!--
            Wave 20 — company rules for the cost and forecast models. The
            project-team rules stayed in `real_estate_construction`: their
            domains read `project_id.construction_member_ids`, which that
            module declares. Group references are rebound to canonical roles
            via the Wave 12 bridge.
        -->
        <record id="rule_realestate_construction_budget_company" model="ir.rule">
                <field name="name">realestate.construction.budget: company</field>
                <field name="model_id" ref="model_realestate_construction_budget"/>
                <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
                <field name="global" eval="True"/>
            </record>
        <record id="rule_realestate_construction_budget_change_line_company" model="ir.rule">
                <field name="name">realestate.construction.budget.change.line: company</field>
