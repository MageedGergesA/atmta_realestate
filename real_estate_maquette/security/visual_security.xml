<?xml version="1.0" encoding="UTF-8"?>
<!--
  M29 / M30 — the roles and the tenancy the visual stack did not have.

  The Phase 0 audit found:

    * `base.group_user,1,1,1,1` on `realestate.plan.region` — every internal
      user, including accounting and HR, could create, edit and delete
      production polygon mappings on a live sales gallery.
    * zero `ir.rule` records across both modules.
    * zero `company_id` fields across both modules.
    * `building.region` and `building.floor` requiring `base.group_system` to
      write, while `plan.region` required nothing — the same gesture on the
      same screen needing a sysadmin in one module and nobody in the other.

  Four roles, because the brief is right that they are genuinely different
  jobs and conflating them is what produced the mess above:

      Viewer     — sees authorised galleries
      Author     — uploads assets, draws polygons, maps meshes
      Publisher  — validates and makes a gallery customer-visible
      Manager    — configuration and everything above

  A Sales Agent is deliberately NOT an Author. Selling from a gallery and
  changing what a gallery says are different responsibilities, and the audit
  found the second one available to everybody.
-->
<odoo noupdate="1">

    <record id="module_category_realestate_visual" model="ir.module.category">
        <field name="name">Real Estate Sales Gallery</field>
        <field name="sequence">22</field>
    </record>

    <record id="group_visual_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="category_id" ref="module_category_realestate_visual"/>
        <field name="comment">Can open published galleries for projects they
            may already see. Cannot change anything.</field>
    </record>

    <record id="group_visual_author" model="res.groups">
        <field name="name">Author</field>
        <field name="category_id" ref="module_category_realestate_visual"/>
        <field name="implied_ids" eval="[(4, ref('group_visual_viewer'))]"/>
        <field name="comment">Uploads models and plans, draws polygon regions
            and maps meshes to units. Cannot publish.</field>
    </record>

    <record id="group_visual_publisher" model="res.groups">
        <field name="name">Publisher</field>
        <field name="category_id" ref="module_category_realestate_visual"/>
        <field name="implied_ids" eval="[(4, ref('group_visual_author'))]"/>
        <field name="comment">Validates a gallery and makes it customer-visible.
            The step between "the mapping is drawn" and "a customer sees
            it".</field>
    </record>

    <record id="group_visual_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_realestate_visual"/>
        <field name="implied_ids" eval="[(4, ref('group_visual_publisher'))]"/>
    </record>

    <!-- ==============================================================
         Company isolation — global rules, applying to everyone.

         `company_id` on the visual models is a stored related on the owning
         property or project, so a region can never disagree with the property
         it is drawn on.

         The `realestate.plan.region` rule lives in `real_estate_plan` rather
         than here: that module depends on this one, so its model does not
         exist yet at the point this file loads.
         ============================================================== -->
    <record id="rule_building_region_company" model="ir.rule">
        <field name="name">Master plan region: own company</field>
        <field name="model_id" ref="model_realestate_building_region"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>

    <record id="rule_building_floor_company" model="ir.rule">
        <field name="name">Building floor: own company</field>
        <field name="model_id" ref="model_realestate_building_floor"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>

    <record id="rule_visual_validation_company" model="ir.rule">
        <field name="name">Validation report: own company</field>
        <field name="model_id" ref="model_realestate_visual_validation"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>

    <record id="rule_visual_validation_issue_company" model="ir.rule">
        <field name="name">Validation issue: own company</field>
        <field name="model_id" ref="model_realestate_visual_validation_issue"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>

    <record id="rule_visual_unit_type_company" model="ir.rule">
        <field name="name">Visual unit type: own company</field>
        <field name="model_id" ref="model_realestate_visual_unit_type"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>

    <record id="rule_visual_floor_template_company" model="ir.rule">
        <field name="name">Floor template: own company</field>
        <field name="model_id" ref="model_realestate_visual_floor_template"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>

    <record id="rule_visual_floor_slot_company" model="ir.rule">
        <field name="name">Floor slot: own company</field>
        <field name="model_id" ref="model_realestate_visual_floor_template_slot"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>

    <record id="rule_visual_slot_map_company" model="ir.rule">
        <field name="name">Slot mapping: own company</field>
        <field name="model_id" ref="model_realestate_visual_floor_slot_map"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>

</odoo>
