<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_project_form_maquette" model="ir.ui.view">
        <field name="name">realestate.project.form.maquette</field>
        <field name="model">realestate.project</field>
        <field name="inherit_id" ref="real_estate_developer.view_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="3D Maquette" name="maquette">
                    <group>
                        <group>
                            <field name="maquette_glb"
                                   filename="maquette_glb_filename"
                                   widget="binary"/>
                            <field name="maquette_glb_filename" invisible="1"/>
                            <field name="maquette_env_hdr"
                                   filename="maquette_env_hdr_filename"
                                   widget="binary"/>
                            <field name="maquette_env_hdr_filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="maquette_status" widget="badge"
                                   decoration-success="maquette_status == 'mapped'"
                                   decoration-warning="maquette_status == 'partial'"
                                   decoration-muted="maquette_status == 'not_uploaded'"
                                   decoration-info="maquette_status == 'uploaded_no_mapping'"/>
                            <field name="maquette_unit_count"/>
                            <field name="maquette_total_units"/>
                            <field name="maquette_mesh_naming_hint"/>
                            <field name="maquette_default_camera" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info"
                         invisible="maquette_glb">
                        <strong>How to upload:</strong>
                        Export the building/compound from 3ds Max / Blender / Revit to
                        <code>.glb</code> (glTF binary). Use the field above to upload it.
                        Each unit must be a named mesh inside the GLB — name them after the unit's
                        <code>property_code</code> for automatic mapping.
                    </div>
                    <field name="id" widget="maquette_viewer"
                           invisible="not maquette_glb"
                           nolabel="1"/>
                    <div class="mt-2"
                         invisible="not maquette_glb">
                        <button name="action_clear_maquette" type="object"
                                string="Clear 3D Model" class="btn btn-link text-danger"
                                confirm="Remove the GLB and reset all unit mesh mappings?"/>
                    </div>
                </page>
                <page string="2D Plan" name="plan_2d">
                    <field name="master_plan_2d_filename" invisible="1"/>
                    <group invisible="master_plan_2d">
                        <group string="Upload Master Plan">
                            <field name="master_plan_2d" widget="image"
                                   options="{'size': [1920, 1080]}"
                                   nolabel="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" invisible="master_plan_2d">
                        Upload the 2D site / master plan (PNG/JPG). Once uploaded,
                        the full interactive editor will appear here — draw building outlines,
                        link each to a property, and the gallery / units of every region
                        become available on click.
                    </div>
                    <!-- Embedded full editor: same one as Project Plans ▸ 2D Master Plan,
                         pinned to this project. -->
                    <field name="id" widget="master_plan_2d_editor" nolabel="1"
                           invisible="not master_plan_2d"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
