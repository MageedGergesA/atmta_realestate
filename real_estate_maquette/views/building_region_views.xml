<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_building_region_list" model="ir.ui.view">
        <field name="name">realestate.building.region.list</field>
        <field name="model">realestate.building.region</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="project_id"/>
                <field name="property_id"/>
                <field name="label"/>
                <field name="color" widget="color"/>
                <field name="polygon" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_building_region_form" model="ir.ui.view">
        <field name="name">realestate.building.region.form</field>
        <field name="model">realestate.building.region</field>
        <field name="arch" type="xml">
            <form string="Plan Region">
                <sheet>
                    <div class="oe_title">
                        <h2 class="mb-3">Pick the property</h2>
                        <p class="text-muted">
                            Choose which property (building, villa, block…) this spot on the master plan represents.
                            If the property isn't tied to a project yet, it will be linked to this one automatically.
                        </p>
                    </div>
                    <group>
                        <field name="property_id"
                               options="{'no_create_edit': True}"
                               required="1"/>
                        <field name="label" placeholder="Optional — defaults to the building name"/>
                        <field name="color" widget="color"/>
                    </group>
                    <!-- Hidden but kept so the click coordinates persist -->
                    <field name="project_id" invisible="1"/>
                    <field name="polygon" invisible="1"/>
                </sheet>
                <footer>
                    <button string="Save" special="save" class="btn-primary"/>
                    <button string="Delete" name="action_delete" type="object"
                            confirm="Delete this region?"
                            class="btn-danger"
                            invisible="not id"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
