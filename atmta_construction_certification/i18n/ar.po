#. module: atmta_construction_certification
#: model:ir.model.fields,help:atmta_construction_certification.field_realestate_construction_retention_release__reason
msgid ""
"Why it is due now. A release with no reason is a payment nobody can explain "
"later."
msgstr ""
"لماذا أصبح مستحقًا الآن. الإفراج بلا سبب هو دفعة لا يستطيع أحد تفسيرها "
"لاحقًا."

#. module: atmta_construction_certification
#: model:ir.model.fields,help:atmta_construction_certification.field_realestate_construction_payment_certificate__disallowance_reason
msgid "Why the claim was not certified in full."
msgstr "سبب عدم اعتماد المطالبة بالكامل."

#. module: atmta_construction_certification
#: model:ir.model.fields.selection,name:atmta_construction_certification.selection__realestate_construction_retention__movement_type__hold
