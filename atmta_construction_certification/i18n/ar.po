#. odoo-python
#: code:addons/atmta_construction_certification/models/owner_progress_billing.py:0
msgid ""
"%(billing)s has customer invoice %(invoice)s. Cancel it (or reverse it, once"
" posted) in Accounting first."
msgstr "%(billing)s له فاتورة عميل %(invoice)s. قم بإلغائها (أو عكسها إن كانت مُرحَّلة) من المحاسبة أولاً."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/payment_certificate.py:0
msgid ""
"%(boq)s has been superseded by %(revision)s. Certify against the current "
"revision."
msgstr "تم استبدال %(boq)s بالمراجعة %(revision)s. اعتمد مقابل المراجعة الحالية."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/owner_progress_billing.py:0
