#: model:ir.model.fields.selection,name:atmta_construction_certification.selection__realestate_construction_retention__side__owner
#: model:ir.model.fields.selection,name:atmta_construction_certification.selection__realestate_construction_retention_release__side__owner
msgid "Withheld by the Owner from us"
msgstr "محتجزة لدى المالك من مستحقاتنا"

#. module: atmta_construction_certification
#: model:ir.model.fields,help:atmta_construction_certification.field_realestate_owner_progress_billing__retention_pct
msgid ""
"Withheld by the owner from this billing. It is still ours to collect, so it "
"is posted to a receivable — not written off as revenue we never earned."
msgstr ""
"يحتجزها المالك من هذه الفوترة. لا تزال مستحقة لنا، لذا ترحل إلى حساب ذمم "
"مدينة — ولا تشطب كإيراد لم نكسبه."

#. module: atmta_construction_certification
#: model:ir.model.fields.selection,name:atmta_construction_certification.selection__realestate_construction_retention__side__contractor
#: model:ir.model.fields.selection,name:atmta_construction_certification.selection__realestate_construction_retention_release__side__contractor
msgid "Withheld from a Contractor"
msgstr "محتجزة من مقاول"

#. module: atmta_construction_certification
#: model:ir.model.fields,help:atmta_construction_certification.field_realestate_construction_retention__signed_amount
msgid "Withheld is positive, released is negative. The balance is their sum."
msgstr "المحتجز بقيمة موجبة والمفرج عنه بقيمة سالبة. الرصيد هو مجموعهما."

#. module: atmta_construction_certification
#: model:ir.model.fields,field_description:atmta_construction_certification.field_realestate_construction_payment_certificate_line__work_item_id
msgid "Work Item"
msgstr "بند عمل"

