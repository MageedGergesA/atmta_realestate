#. module: atmta_construction_certification
#: model:ir.model.fields,help:atmta_construction_certification.field_realestate_construction_payment_certificate__retention_pct
msgid "% withheld from this payment. Defaults from the contractor."
msgstr "% المحتجزة من هذه الدفعة. القيمة الافتراضية مأخوذة من المقاول."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/payment_certificate.py:0
msgid ""
"%(advance)s advanced %(amount).2f and %(already).2f has already been "
"recovered. Recovering %(now).2f more would take back money that was never "
"paid out."
msgstr ""
"الدفعة المقدمة %(advance)s بلغت %(amount).2f وتم استرداد %(already).2f منها "
"بالفعل. استرداد %(now).2f إضافية يعني استرجاع أموال لم تصرف أصلًا."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/advance.py:0
msgid ""
"%(advance)s was paid to %(paid)s. It cannot be recovered from %(other)s's "
"certificate."
msgstr ""
"الدفعة المقدمة %(advance)s صرفت إلى %(paid)s. لا يمكن استردادها من شهادة "
"%(other)s."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/payment_certificate.py:0
msgid ""
"%(bill)s is not paid yet. Register the payment in Accounting; this "
"certificate follows the ledger rather than deciding it."
msgstr ""
"%(bill)s غير مدفوعة بعد. سجل الدفعة في المحاسبة؛ فهذه الشهادة تتبع دفتر "
"الأستاذ ولا تحدده."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/payment_certificate.py:0
msgid ""
"%(contractor)s belongs to %(other)s. A certificate cannot bill another "
"company's vendor."
msgstr ""
"%(contractor)s يتبع %(other)s. لا يمكن لشهادة أن تفوتر مورد شركة أخرى."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/payment_certificate.py:0
msgid ""
"%(item)s: certifying %(qty).2f would take the total to %(total).2f against "
"an authorised quantity of %(authorised).2f. Extra quantity is a variation."
msgstr ""
"%(item)s: اعتماد %(qty).2f سيرفع الإجمالي إلى %(total).2f مقابل كمية معتمدة "
"قدرها %(authorised).2f. الكمية الإضافية تعد تغييرًا."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/payment_certificate.py:0
msgid ""
"%(name)s certifies %(certified)s against a claim of %(applied)s. More cannot"
" be certified than was applied for — the extra belongs on the next "
"application."
msgstr ""
"%(name)s تعتمد %(certified)s مقابل مطالبة بقيمة %(applied)s. لا يمكن اعتماد "
"أكثر مما طلب — الزيادة تدرج في الطلب التالي."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/payment_certificate.py:0
msgid ""
"%(name)s nets to %(net).2f. Nothing is payable, so there is nothing to bill "
"— reduce the recovery or wait for the next certificate."
msgstr ""
"صافي %(name)s يساوي %(net).2f. لا يوجد مبلغ مستحق الدفع، وبالتالي لا شيء "
"للفوترة — خفض الاسترداد أو انتظر الشهادة التالية."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/payment_certificate.py:0
msgid ""
"%(name)s would take cumulative certification to %(cumulative).2f against an "
"authorised %(authorised).2f. Certifying beyond the contract needs a "
"variation, not a bigger certificate."
msgstr ""
"%(name)s سترفع الاعتماد التراكمي إلى %(cumulative).2f مقابل قيمة معتمدة "
"قدرها %(authorised).2f. الاعتماد بما يتجاوز العقد يحتاج إلى تغيير، لا إلى "
"شهادة أكبر."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/payment_certificate.py:0
msgid "%(ref)s — work certified to %(date)s"
msgstr "%(ref)s — الأعمال المعتمدة حتى %(date)s"

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/advance.py:0
msgid ""
"%(refs)s have already been billed. Raise a further advance or a credit note "
"— the amount advanced is not edited after the fact."
msgstr ""
"%(refs)s تمت فوترتها بالفعل. أنشئ دفعة مقدمة إضافية أو إشعارًا دائنًا — لا "
"يعدل مبلغ الدفعة المقدمة بعد وقوعه."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/payment_certificate.py:0
msgid ""
"%(refs)s have been certified. Issue the next certificate with an adjustment "
"rather than rewriting one somebody signed and a bill was posted from."
msgstr ""
"%(refs)s تم اعتمادها. أصدر الشهادة التالية مع تسوية بدلًا من إعادة كتابة "
"شهادة وقعها شخص ما ورحلت منها فاتورة."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/retention.py:0
msgid ""
"%(release)s would release %(amount)s but only %(held)s is held. Retention "
"that was never withheld cannot be paid back."
msgstr ""
"%(release)s ستفرج عن %(amount)s بينما المحتجز %(held)s فقط. لا يمكن رد "
"محتجزات لم تقتطع أصلًا."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/advance.py:0
msgid "%(type)s — %(ref)s"
msgstr "%(type)s — %(ref)s"

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/advance.py:0
msgid "%s already has a bill."
msgstr "%s لديها فاتورة بالفعل."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/retention.py:0
msgid ""
"%s already released retention and posted a bill. Reverse the bill in "
"Accounting; the register keeps both entries."
msgstr ""
"%s أفرجت بالفعل عن المحتجزات ورحلت فاتورة. اعكس الفاتورة في المحاسبة؛ يحتفظ "
"السجل بكلا القيدين."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/advance.py:0
msgid "%s has been billed. Reverse the bill in Accounting."
msgstr "تمت فوترة %s. اعكس الفاتورة في المحاسبة."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/advance.py:0
msgid "%s is not a draft advance."
msgstr "%s ليست دفعة مقدمة في حالة مسودة."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/payment_certificate.py:0
msgid "%s is not a draft application."
msgstr "%s ليس طلبًا في حالة مسودة."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/retention.py:0
msgid "%s is not a draft release."
msgstr "%s ليس إفراجًا في حالة مسودة."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/owner_progress_billing.py:0
msgid "%s — %.2f%% construction progress on %s"
msgstr "%s — نسبة إنجاز الإنشاءات %.2f%% في %s"

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/payment_certificate.py:0
msgid ""
"A certificate for a negative amount is a credit note, and belongs in "
"Accounting."
msgstr "الشهادة بمبلغ سالب هي إشعار دائن، ومكانها المحاسبة."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/owner_progress_billing.py:0
msgid "A customer invoice already exists."
msgstr "توجد فاتورة عميل بالفعل."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/advance.py:0
msgid "A recovery of nothing is not a recovery."
msgstr "الاسترداد بمبلغ صفري ليس استردادًا."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/retention.py:0
msgid ""
"A retention movement of nothing is not a movement. Use the type to say "
"whether it is held or released."
msgstr ""
"حركة محتجزات بمبلغ صفري ليست حركة. استخدم النوع لتحديد ما إذا كانت محتجزة أو"
" مفرجًا عنها."

#. module: atmta_construction_certification
#. odoo-python
#: code:addons/atmta_construction_certification/models/payment_certificate.py:0
msgid "A vendor bill already exists for this certificate."
msgstr "توجد فاتورة مورد لهذه الشهادة بالفعل."

