<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!--
            Wave 19 — company rules for the certification models. The
            project-team rules stayed in `real_estate_construction`: their
            domains read `project_id.construction_member_ids`, which that
            module declares. Group references are rebound to canonical roles
            via the Wave 12 bridge.
        -->
        <record id="rule_realestate_construction_advance_company" model="ir.rule">
                <field name="name">realestate.construction.advance: company</field>
                <field name="model_id" ref="model_realestate_construction_advance"/>
                <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
                <field name="global" eval="True"/>
            </record>
        <record id="rule_realestate_construction_advance_recovery_company" model="ir.rule">
                <field name="name">realestate.construction.advance.recovery: company</field>
