        <record id="rule_realestate_construction_advance_manager" model="ir.rule">
                <field name="name">realestate.construction.advance: manager sees every project</field>
                <field name="model_id" ref="model_realestate_construction_advance"/>
                <field name="domain_force">[(1, '=', 1)]</field>
                <field name="groups" eval="[(4, ref('atmta_roles.group_construction_manager'))]"/>
            </record>
