                <field name="global" eval="True"/>
            </record>
        <record id="rule_realestate_construction_claim_manager" model="ir.rule">
                <field name="name">realestate.construction.claim: manager sees every project</field>
                <field name="model_id" ref="model_realestate_construction_claim"/>
