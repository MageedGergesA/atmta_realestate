<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- Wave 17 — sequences for claims, determinations, delay events,
         extensions of time and notices. `noupdate`, which `_process_end`
         skips, so the hand-over names them explicitly. -->
    <record id="seq_construction_delay_event" model="ir.sequence">
        <field name="name">Delay Event</field>
        <field name="code">realestate.construction.delay.event</field>
        <field name="prefix">DEL/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_construction_notice" model="ir.sequence">
        <field name="name">Contractual Notice</field>
        <field name="code">realestate.construction.notice</field>
        <field name="prefix">NOT/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_construction_claim" model="ir.sequence">
        <field name="name">Construction Claim</field>
        <field name="code">realestate.construction.claim</field>
        <field name="prefix">CLM/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_construction_claim_determination" model="ir.sequence">
        <field name="name">Claim Determination</field>
        <field name="code">realestate.construction.claim.determination</field>
        <field name="prefix">DET/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_construction_eot" model="ir.sequence">
        <field name="name">Extension of Time</field>
        <field name="code">realestate.construction.eot</field>
        <field name="prefix">EOT/%(year)s/</field>
        <field name="padding">4</field>
    </record>
</odoo>
