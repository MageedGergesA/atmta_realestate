<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!--
            Wave 14 — the company rules for the document models.

            Only the company and global rules moved. The six project-team rules
            stayed in `real_estate_construction`: their domains read
            `project_id.construction_member_ids`, a field that module declares
            on the project. A rule may be declared above the model it guards;
            it may not be declared below a field it reads.
        -->
        <record id="rule_realestate_construction_document_company" model="ir.rule">
                <field name="name">realestate.construction.document: company</field>
                <field name="model_id" ref="model_realestate_construction_document"/>
                <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
                <field name="global" eval="True"/>
            </record>
        <record id="rule_realestate_construction_document_revision_company" model="ir.rule">
                <field name="name">realestate.construction.document.revision: company</field>
