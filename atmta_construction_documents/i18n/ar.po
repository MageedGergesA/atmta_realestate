#. module: atmta_construction_documents
#. odoo-python
#: code:addons/atmta_construction_documents/models/document_control.py:0
msgid ""
"%(doc)s Rev %(rev)s has no file. Issuing a revision that nobody can open is "
"not issuing anything."
msgstr ""
"المستند %(doc)s المراجعة %(rev)s ليس له ملف. إصدار مراجعة لا يستطيع أحد "
"فتحها ليس إصدارًا لأي شيء."

#. module: atmta_construction_documents
#. odoo-python
#: code:addons/atmta_construction_documents/models/document_control.py:0
msgid ""
"%(refs)s have been issued. Their file and revision identity are the evidence"
" of what was sent — record a new revision instead of editing this one."
msgstr ""
"تم إصدار %(refs)s. ملفاتها وهوية مراجعاتها هي الدليل على ما تم إرساله — سجل "
"مراجعة جديدة بدلًا من تعديل هذه."

#. module: atmta_construction_documents
#. odoo-python
#: code:addons/atmta_construction_documents/models/transmittal.py:0
msgid "%(refs)s have been sent and cannot be changed."
msgstr "تم إرسال %(refs)s ولا يمكن تغييرها."

#. module: atmta_construction_documents
#. odoo-python
#: code:addons/atmta_construction_documents/models/submittal.py:0
msgid ""
"%(responded)s of %(required)s reviewers have replied. Wait for the rest, or "
"finalise deliberately."
msgstr ""
"رد %(responded)s من أصل %(required)s من المراجعين. انتظر البقية، أو اعتمد "
"النتيجة النهائية عن قصد."

#. module: atmta_construction_documents
#. odoo-python
#: code:addons/atmta_construction_documents/models/information_change_event.py:0
msgid "%(rfi)s already has change event %(event)s."
msgstr "طلب المعلومات %(rfi)s لديه بالفعل حدث التغيير %(event)s."

#. module: atmta_construction_documents
#. odoo-python
#: code:addons/atmta_construction_documents/models/information_change_event.py:0
msgid "%s already has a change event."
msgstr "%s لديه حدث تغيير بالفعل."

#. module: atmta_construction_documents
#. odoo-python
#: code:addons/atmta_construction_documents/models/submittal.py:0
msgid "%s awaits a revised submission and cannot be closed."
msgstr "%s بانتظار تقديم نسخة معدلة ولا يمكن إغلاقه."

#. module: atmta_construction_documents
#. odoo-python
#: code:addons/atmta_construction_documents/models/transmittal.py:0
msgid "%s has already been sent."
msgstr "تم إرسال %s بالفعل."

#. module: atmta_construction_documents
#. odoo-python
#: code:addons/atmta_construction_documents/models/transmittal.py:0
msgid ""
"%s has been sent. A transmittal is evidence that information left the "
"building — issue another one rather than cancelling this."
msgstr ""
"تم إرسال %s. كتاب الإحالة دليل على أن المعلومات خرجت من الجهة — أصدر كتابًا "
"آخر بدلًا من إلغاء هذا."

#. module: atmta_construction_documents
#. odoo-python
#: code:addons/atmta_construction_documents/models/rfi.py:0
msgid ""
"%s has no official response. Closing it anyway needs a stated reason — an "
"unanswered question that quietly disappears is how disputes start."
msgstr ""
"لا يوجد رد رسمي على %s. إغلاقه رغم ذلك يتطلب ذكر سبب — فالسؤال الذي يختفي "
"دون إجابة هو بداية النزاعات."

#. module: atmta_construction_documents
#. odoo-python
#: code:addons/atmta_construction_documents/models/rfi.py:0
msgid "%s is not awaiting an answer."
msgstr "%s ليس بانتظار إجابة."

#. module: atmta_construction_documents
#. odoo-python
#: code:addons/atmta_construction_documents/models/submittal.py:0
msgid "%s is not in a state that can be submitted."
msgstr "%s ليس في حالة تسمح بإرساله."

#. module: atmta_construction_documents
#: model:ir.model.constraint,message:atmta_construction_documents.constraint_realestate_construction_document_revision_code_uniq_per_document
msgid "A document cannot have two revisions with the same code."
msgstr "لا يمكن أن يكون للمستند مراجعتان بنفس الرمز."

#. module: atmta_construction_documents
#: model:ir.model.constraint,message:atmta_construction_documents.constraint_realestate_construction_document_number_uniq_per_project
msgid "A document number must be unique within its project."
msgstr "يجب أن يكون رقم المستند فريدًا داخل مشروعه."

#. module: atmta_construction_documents
#: model_terms:ir.ui.view,arch_db:atmta_construction_documents.view_rfi_form
msgid ""
"A potential cost impact is an indication. It changes no budget,\n"
"                        commitment or actual — use <strong>Create Change Event</strong>\n"
"                        to start the commercial process."
msgstr ""
"الأثر المحتمل على التكلفة مجرد مؤشر. لا يغير أي ميزانية أو التزام أو تكلفة "
"فعلية — استخدم <strong>إنشاء حدث تغيير</strong> لبدء الإجراءات التجارية."

#. module: atmta_construction_documents
#. odoo-python
#: code:addons/atmta_construction_documents/models/transmittal.py:0
msgid "A sent transmittal's contents cannot be removed."
msgstr "لا يمكن إزالة محتويات كتاب إحالة تم إرساله."

#. module: atmta_construction_documents
#. odoo-python
#: code:addons/atmta_construction_documents/models/submittal.py:0
msgid "A submittal closes once it has been responded to."
msgstr "يغلق المستند المقدم للاعتماد بمجرد الرد عليه."

#. module: atmta_construction_documents
#. odoo-python
#: code:addons/atmta_construction_documents/models/submittal.py:0
msgid "A submittal that has been responded to is part of the record."
msgstr "المستند المقدم للاعتماد الذي تم الرد عليه أصبح جزءًا من السجل."

#. module: atmta_construction_documents
#. odoo-python
#: code:addons/atmta_construction_documents/models/transmittal.py:0
msgid "A transmittal needs a recipient."
msgstr "يتطلب كتاب الإحالة مستلمًا."

#. module: atmta_construction_documents
#. odoo-python
#: code:addons/atmta_construction_documents/models/transmittal.py:0
msgid "A transmittal with no documents transmits nothing."
msgstr "كتاب الإحالة الذي لا يحتوي على مستندات لا يحيل شيئًا."

