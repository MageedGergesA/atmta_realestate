<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- Wave 18 — sequences for milestones, BOQs, the labour log and daily
         reports. `noupdate`, which `_process_end` skips, so the hand-over
         names them explicitly. -->
    <record id="seq_milestone" model="ir.sequence">
        <field name="name">Construction Milestone</field>
        <field name="code">realestate.construction.milestone</field>
        <field name="prefix">MS-</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_boq" model="ir.sequence">
        <field name="name">Bill of Quantities</field>
        <field name="code">realestate.boq</field>
        <field name="prefix">BOQ-</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_labor_log" model="ir.sequence">
        <field name="name">Daily Labor Log</field>
        <field name="code">realestate.construction.labor.log</field>
        <field name="prefix">LAB-</field>
        <field name="padding">6</field>
    </record>

    <record id="seq_construction_daily_report" model="ir.sequence">
        <field name="name">Daily Site Report</field>
        <field name="code">realestate.construction.daily.report</field>
        <field name="prefix">DSR/%(year)s/</field>
        <field name="padding">4</field>
    </record>
</odoo>
