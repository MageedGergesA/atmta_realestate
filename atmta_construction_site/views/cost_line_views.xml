<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cost_line_list" model="ir.ui.view">
        <field name="name">realestate.construction.cost.line.list</field>
        <field name="model">realestate.construction.cost.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="project_id"/>
                <field name="phase_id" optional="show"/>
                <field name="milestone_id" optional="show"/>
                <field name="name"/>
                <field name="category"/>
                <field name="contractor_id" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="vendor_bill_id" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_cost_line_form" model="ir.ui.view">
        <field name="name">realestate.construction.cost.line.form</field>
        <field name="model">realestate.construction.cost.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="phase_id"/>
                            <field name="milestone_id" options="{'no_create': True}"/>
                            <field name="contractor_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="category"/>
                            <field name="amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="vendor_bill_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="name" placeholder="Description"/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cost_line" model="ir.actions.act_window">
        <field name="name">Cost Lines</field>
        <field name="res_model">realestate.construction.cost.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
