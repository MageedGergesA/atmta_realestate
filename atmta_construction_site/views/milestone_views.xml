<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_milestone_list" model="ir.ui.view">
        <field name="name">realestate.construction.milestone.list</field>
        <field name="model">realestate.construction.milestone</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_blocked_by_delay">
                <field name="sequence" widget="handle"/>
                <field name="project_id"/>
                <field name="phase_id" optional="show"/>
                <field name="name"/>
                <field name="category"/>
                <field name="contractor_id" optional="show"/>
                <field name="weight"/>
                <field name="expected_end_date"/>
                <field name="earliest_possible_start" optional="hide"/>
                <field name="delay_days" optional="show"/>
                <field name="is_blocked_by_delay" optional="hide"/>
                <field name="completion_percentage" widget="progressbar"/>
                <field name="task_count" optional="show" string="# Tasks"/>
                <field name="budget_amount" optional="show"/>
                <field name="actual_cost" optional="show"/>
                <field name="cost_variance" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'in_progress'"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'delayed'"
                       decoration-muted="state in ('not_started','cancelled')"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_milestone_kanban" model="ir.ui.view">
        <field name="name">realestate.construction.milestone.kanban</field>
        <field name="model">realestate.construction.milestone</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="name"/>
                <field name="project_id"/>
                <field name="completion_percentage"/>
                <field name="contractor_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card" class="oe_kanban_card p-2">
                        <div class="fw-bold"><field name="name"/></div>
                        <div class="small text-muted"><field name="project_id"/></div>
                        <field name="completion_percentage" widget="progressbar"/>
                        <div class="mt-1 small">
                            <field name="contractor_id"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_milestone_form" model="ir.ui.view">
        <field name="name">realestate.construction.milestone.form</field>
        <field name="model">realestate.construction.milestone</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start Work"
                            class="oe_highlight" invisible="state != 'not_started'"/>
                    <button name="action_complete" type="object" string="Mark Complete"
                            class="oe_highlight" invisible="state in ('completed','cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="not is_blocked_by_delay">
                        <i class="fa fa-exclamation-triangle"/>
                        <strong> Slipped by upstream:</strong>
                        Earliest possible start is <field name="earliest_possible_start" readonly="1" nolabel="1" class="d-inline"/>
                        — that's <field name="delay_days" readonly="1" nolabel="1" class="d-inline"/> day(s) after the expected start.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Milestone name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="phase_id" options="{'no_create': True}"/>
                            <field name="category"/>
                            <field name="contractor_id" options="{'no_create': True}"/>
                            <field name="weight"/>
                        </group>
                        <group>
                            <field name="expected_start_date"/>
                            <field name="expected_end_date"/>
                            <field name="actual_start_date"/>
                            <field name="actual_end_date"/>
                            <field name="completion_percentage" widget="progressbar"
                                   readonly="task_count > 0"
                                   help="Auto-computed from tasks when tasks exist; editable otherwise."/>
                            <field name="task_count" invisible="1"/>
                        </group>
                    </group>
                    <group string="Cost">
                        <group>
                            <field name="budget_amount"/>
                            <field name="actual_cost" readonly="1"/>
                            <field name="cost_variance" readonly="1"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tasks" name="tasks">
                            <field name="task_ids" context="{'default_milestone_id': id, 'default_contractor_id': contractor_id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="assignee_id" optional="show"/>
                                    <field name="contractor_id" optional="hide"/>
                                    <field name="weight"/>
                                    <field name="expected_end_date" optional="show"/>
                                    <field name="completion_pct" widget="progressbar" optional="show"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'in_progress'"
                                           decoration-success="state == 'done'"
                                           decoration-muted="state in ('pending','skipped')"/>
                                </list>
                            </field>
                        </page>
                        <page string="Dependencies" name="dependencies">
                            <group>
                                <field name="dependency_ids" widget="many2many_tags"
                                       options="{'no_create': True}"/>
                                <field name="dependent_ids" widget="many2many_tags" readonly="1"/>
                                <field name="earliest_possible_start" readonly="1"/>
                                <field name="delay_days" readonly="1"/>
                                <field name="is_blocked_by_delay" readonly="1"/>
                            </group>
                        </page>
                        <page string="Cost Lines">
                            <field name="cost_line_ids" context="{'default_project_id': project_id, 'default_phase_id': phase_id, 'default_milestone_id': id}">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="contractor_id"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_milestone" model="ir.actions.act_window">
        <field name="name">Milestones</field>
        <field name="res_model">realestate.construction.milestone</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>
