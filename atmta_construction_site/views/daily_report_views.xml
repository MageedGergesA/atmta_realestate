<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Wave 23 — the daily report's own list and form.

         They lived in `quality_views.xml` because quality and site reporting
         grew up together, but the model is this module's. Quality is below
         site and cannot declare a view on a model defined above it. -->

    <record id="view_daily_report_list" model="ir.ui.view">
        <field name="name">realestate.construction.daily.report.list</field>
        <field name="model">realestate.construction.daily.report</field>
        <field name="arch" type="xml">
            <list string="Daily Site Reports" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="report_date"/>
                <field name="shift"/>
                <field name="weather_condition"/>
                <field name="total_workers" sum="Workers"/>
                <field name="total_labor_hours" sum="Hours"/>
                <field name="total_delay_days" sum="Delay days"/>
                <field name="prepared_by_id" optional="hide"/>
                <field name="reviewed_by_id" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_daily_report_form" model="ir.ui.view">
        <field name="name">realestate.construction.daily.report.form</field>
        <field name="model">realestate.construction.daily.report</field>
        <field name="arch" type="xml">
            <form string="Daily Site Report">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_review" type="object" string="Review"
                            invisible="state != 'submitted'"/>
                    <button name="action_close" type="object" string="Close"
                            class="btn-primary" invisible="state not in ('submitted','reviewed')"/>
                    <button name="action_open_reason_wizard" type="object"
                            string="Amend" invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,reviewed,closed"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status" invisible="state != 'closed'">
                        This is a closed site record. It is the evidence a delay claim
                        would be argued from — amend it with a reason, never quietly.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="report_date" readonly="1"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="shift"/>
                            <field name="prepared_by_id"/>
                            <field name="reviewed_by_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Weather">
                            <field name="weather_condition"/>
                            <field name="temperature_min"/>
                            <field name="temperature_max"/>
                            <field name="weather_stopped_work"/>
                            <field name="weather_notes"/>
                            <field name="site_conditions"/>
                        </group>
                        <group string="Totals">
                            <field name="total_workers"/>
                            <field name="total_labor_hours"/>
                            <field name="total_delay_days"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Work Performed">
                            <field name="work_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="wbs_id"/>
                                    <field name="cost_code_id" optional="hide"/>
                                    <field name="location"/>
                                    <field name="contractor_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="boq_line_id" optional="hide"/>
                                    <field name="progress_note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Manpower">
                            <field name="labor_log_ids" readonly="1">
                                <list>
                                    <field name="trade"/>
                                    <field name="contractor_id"/>
                                    <field name="workers" sum="Workers"/>
                                    <field name="hours"/>
                                    <field name="total_hours" sum="Hours"/>
                                    <field name="wbs_id" optional="hide"/>
                                    <field name="shift" optional="hide"/>
                                </list>
                            </field>
                            <field name="labor_summary_snapshot" readonly="1"
                                   invisible="state != 'closed'"/>
                        </page>
                        <page string="Equipment">
                            <field name="equipment_line_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="equipment_type"/>
                                    <field name="contractor_id"/>
                                    <field name="owner"/>
                                    <field name="location"/>
                                    <field name="working_hours" sum="Working"/>
                                    <field name="idle_hours" sum="Idle"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                        <page string="Deliveries">
                            <field name="delivery_line_ids">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="product_id"/>
                                    <field name="partner_id"/>
                                    <field name="purchase_order_id"/>
                                    <field name="picking_id" optional="hide"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Delays">
                            <field name="delay_ids">
                                <list editable="bottom">
                                    <field name="category"/>
                                    <field name="description"/>
                                    <field name="start_datetime" optional="hide"/>
                                    <field name="end_datetime" optional="hide"/>
                                    <field name="estimated_days" sum="Days"/>
                                    <field name="affected_work"/>
                                    <field name="responsible_party"/>
                                    <field name="change_event_id" readonly="1"/>
                                </list>
                            </field>
                            <p class="text-muted">
                                A recorded delay is evidence, not entitlement. Extensions
                                of time and claims are decided separately.
                            </p>
                        </page>
                        <page string="Notes">
                            <field name="overall_notes"/>
                            <group>
                                <field name="visitors"/>
                                <field name="quality_notes"/>
                                <field name="safety_notes"/>
                                <field name="amendment_reason" readonly="1"
                                       invisible="not amendment_reason"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_daily_report" model="ir.actions.act_window">
        <field name="name">Daily Site Reports</field>
        <field name="res_model">realestate.construction.daily.report</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
