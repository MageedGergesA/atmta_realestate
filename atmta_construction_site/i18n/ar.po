#. module: atmta_construction_site
#. odoo-python
#: code:addons/atmta_construction_site/models/boq.py:0
msgid ""
"%(items)s belong to an approved BOQ. Raise a change order and apply a "
"variation — an approved quantity that can be retyped is not a contract."
msgstr ""
"%(items)s تابعة لجدول كميات معتمد. أصدر أمر تغيير وطبق تغييرًا — الكمية "
"المعتمدة التي يمكن إعادة كتابتها ليست عقدًا."

#. module: atmta_construction_site
#. odoo-python
#: code:addons/atmta_construction_site/models/boq.py:0
msgid ""
"%(order)s is %(state)s. An unapproved change order does not authorise a "
"quantity."
msgstr "%(order)s في حالة %(state)s. أمر التغيير غير المعتمد لا يجيز كمية."

#. module: atmta_construction_site
#. odoo-python
#: code:addons/atmta_construction_site/models/boq.py:0
msgid ""
"%(refs)s are approved. Create a revision rather than editing the quantities "
"work is certified against."
msgstr ""
"%(refs)s معتمدة. أنشئ مراجعة بدلًا من تعديل الكميات التي تعتمد الأعمال على "
"أساسها."

#. module: atmta_construction_site
#. odoo-python
#: code:addons/atmta_construction_site/models/daily_report.py:0
msgid ""
"%(refs)s are closed site records. Amend with a reason rather than editing "
"the day's evidence."
msgstr ""
"%(refs)s سجلات موقع مغلقة. عدلها مع ذكر السبب بدلًا من تعديل أدلة اليوم."

#. module: atmta_construction_site
#: model:ir.model.fields,help:atmta_construction_site.field_realestate_construction_task__completion_pct
msgid "100 if done/skipped, 50 if in progress, 0 otherwise."
msgstr "100 إذا كانت منجزة/متخطاة، 50 إذا كانت قيد التنفيذ، 0 خلاف ذلك."

