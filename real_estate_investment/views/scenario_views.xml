<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_scenario_list" model="ir.ui.view">
        <field name="name">realestate.investment.scenario.list</field>
        <field name="model">realestate.investment.scenario</field>
        <field name="arch" type="xml">
            <list>
                <field name="feasibility_id"/>
                <field name="name"/>
                <field name="scenario_type"/>
                <field name="inflow_factor"/>
                <field name="outflow_factor"/>
                <field name="discount_rate_override"/>
                <field name="npv"/>
                <field name="irr"/>
                <field name="is_positive" widget="boolean_toggle"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_scenario" model="ir.actions.act_window">
        <field name="name">Scenarios</field>
        <field name="res_model">realestate.investment.scenario</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
