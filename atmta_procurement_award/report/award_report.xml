<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
    M7 — the Award Recommendation / Award Decision.

    This one IS about awarding, which is the difference between it and the M6
    Evaluation Report. The word the document uses depends on where the award
    has got to: while it is in review it is a RECOMMENDATION, and once approved
    it is a DECISION. Printing "decision" over an unapproved award would be the
    document deciding something on the approver's behalf.

    Everything here is read from award and evaluation evidence that has already
    been frozen: the awarded quantities, the vendor's own bid rates, the
    evaluation rank, the vendor name as it stood when the candidate set was
    frozen, and the revalidation findings recorded at approval. It reads no
    live price and no live vendor name, so re-rendering it next year prints the
    same document.
-->

    <template id="report_award_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.company_id.partner_id.lang)"/>
            <t t-set="decided" t-value="doc.state in ('approved', 'issued')"/>
            <div class="page">

                <div class="text-center mb-3">
                    <h2 class="mt-0">
                        <t t-if="decided">Award Decision</t>
                        <t t-else="">Award Recommendation</t>
                    </h2>
                    <div class="alert alert-warning d-inline-block px-4 py-2" role="alert">
                        <t t-if="doc.state == 'issued'">
                            <strong>ISSUED.</strong> The purchase orders below
                            are confirmed and the budget is committed.
                        </t>
                        <t t-elif="doc.state == 'approved'">
                            <strong>APPROVED, NOT YET ISSUED.</strong>
                            Confirming the orders is what commits the budget.
                        </t>
                        <t t-elif="doc.state == 'cancelled'">
                            <strong>CANCELLED.</strong> This award authorises
                            nothing.
                        </t>
                        <t t-else="">
                            <strong>RECOMMENDATION ONLY — NOT YET APPROVED.</strong>
                            No purchase is authorised by this document.
                        </t>
                    </div>
                </div>

                <!-- ============================ HEADER =================== -->
                <h4>1. Award</h4>
                <table class="table table-sm table-borderless">
                    <tr>
                        <td style="width:25%"><strong>Reference</strong></td>
                        <td style="width:25%"><span t-field="doc.name"/></td>
                        <td style="width:25%"><strong>Type</strong></td>
                        <td style="width:25%"><span t-field="doc.award_type"/></td>
                    </tr>
                    <tr>
                        <td><strong>Sourcing Event</strong></td>
                        <td><span t-field="doc.sourcing_event_id.name"/></td>
                        <td><strong>Project</strong></td>
                        <td><span t-field="doc.project_id.name"/></td>
                    </tr>
                    <tr>
                        <td><strong>Evaluation</strong></td>
                        <td><span t-field="doc.round_id.name"/></td>
                        <td><strong>Company</strong></td>
                        <td><span t-field="doc.company_id.name"/></td>
                    </tr>
                    <tr>
                        <td><strong>Evaluation Basis</strong></td>
                        <td><span t-field="doc.plan_id.name"/>,
                            revision <span t-field="doc.plan_id.revision"/></td>
                        <td><strong>Total Awarded</strong></td>
                        <td><strong><span t-field="doc.amount_total"/></strong></td>
                    </tr>
                </table>

                <!-- ============================ WHAT IS AWARDED ========== -->
                <h4>2. Awarded</h4>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Vendor</th>
                            <th class="text-end">Evaluation Rank</th>
                            <th class="text-center">Followed the Ranking</th>
                            <th class="text-end">Amount</th>
                            <th>Purchase Order</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.line_ids.sorted('id')" t-as="line">
                            <td><span t-field="line.partner_name"/></td>
                            <td class="text-end"><span t-field="line.rank_awarded"/></td>
                            <td class="text-center">
                                <t t-if="line.is_top_ranked">Yes</t>
                                <t t-else="">No</t>
                            </td>
                            <td class="text-end"><span t-field="line.amount"/></td>
                            <td><span t-field="line.purchase_order_id.name"/></td>
                        </tr>
                    </tbody>
                </table>

                <t t-if="not all(line.is_top_ranked for line in doc.line_ids)">
                    <div class="alert alert-info" role="alert">
                        <strong>This award departs from the evaluation
                        ranking.</strong> That is permitted — a ranking is an
                        evaluation outcome, not an instruction — and the reason
                        is recorded below.
                    </div>
                    <p><strong>Justification.</strong>
                       <span t-field="doc.justification"/></p>
                </t>

                <!-- ============================ SCOPE ==================== -->
                <h4>3. Awarded Scope</h4>
                <p class="text-muted">
                    Quantities at the vendor's own bid rate. Every invited
                    vendor was issued a request for the whole tender; the
                    purchase orders are rewritten to these figures before they
                    are confirmed.
                </p>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Vendor</th><th>Tender Line</th>
                            <th class="text-end">Tendered</th>
                            <th class="text-end">Awarded</th>
                            <th class="text-end">Rate</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.line_ids.mapped('allocation_ids').sorted('id')" t-as="alloc">
                            <td><span t-field="alloc.partner_name"/></td>
                            <td><span t-field="alloc.sourcing_line_id.name"/></td>
                            <td class="text-end"><span t-field="alloc.tender_quantity"/></td>
                            <td class="text-end"><span t-field="alloc.quantity"/></td>
                            <td class="text-end"><span t-field="alloc.price_unit"/></td>
                            <td class="text-end"><span t-field="alloc.amount"/></td>
                        </tr>
                    </tbody>
                </table>

                <t t-if="doc.award_type == 'partial'">
                    <div class="alert alert-info" role="alert">
                        <strong>Partial award.</strong> The unawarded balance of
                        this tender remains approved demand and remains
                        reserved against the project budget. It has not been
                        cancelled and it still needs to be bought.
                    </div>
                </t>

                <!-- ============================ APPROVAL ================= -->
                <h4>4. Authorisation</h4>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr><th>Step</th><th>By</th><th>When</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Raised</td>
                            <td><span t-field="doc.submitted_by_id.name"/></td>
                            <td><span t-field="doc.submitted_on"/></td>
                        </tr>
                        <tr>
                            <td>Approved</td>
                            <td><span t-field="doc.approved_by_id.name"/></td>
                            <td><span t-field="doc.approved_on"/></td>
                        </tr>
                        <tr t-if="doc.state == 'issued'">
                            <td>Issued</td>
                            <td><span t-field="doc.issued_by_id.name"/></td>
                            <td><span t-field="doc.issued_on"/></td>
                        </tr>
                        <tr t-if="doc.state == 'cancelled'">
                            <td>Cancelled</td>
                            <td><span t-field="doc.cancelled_by_id.name"/></td>
                            <td><span t-field="doc.cancelled_on"/></td>
                        </tr>
                    </tbody>
                </table>
                <p t-if="doc.cancellation_reason">
                    <strong>Cancellation reason.</strong>
                    <span t-field="doc.cancellation_reason"/>
                </p>
                <p class="text-muted">
                    Raised and approved by two different people. The person who
                    proposes an award does not authorise it.
                </p>

                <!-- ============================ REVALIDATION ============= -->
                <h4>5. Revalidated at Approval</h4>
                <p class="text-muted">
                    An evaluation is a photograph. These are the things that
                    were re-checked at the moment the decision was actually
                    taken: vendor eligibility, bid validity, that the
                    evaluation basis was still the frozen one, and that the
                    reserved capacity was still being held.
                </p>
                <div t-if="doc.revalidation_note">
                    <span t-field="doc.revalidation_note"/>
                </div>
                <div t-else="">
                    <em>Not yet revalidated — this award has not been approved.</em>
                </div>

                <div class="alert alert-warning mt-4" role="alert">
                    <t t-if="doc.state == 'issued'">
                        <strong>The commitment shown against this project is
                        computed by Construction from the confirmed purchase
                        orders.</strong> This document does not hold a
                        commitment figure of its own, and nothing here can move
                        one.
                    </t>
                    <t t-else="">
                        <strong>NO PURCHASE IS AUTHORISED BY THIS DOCUMENT
                        UNTIL THE ORDERS ABOVE ARE CONFIRMED.</strong>
                        Approval authorises; confirming commits.
                    </t>
                </div>

            </div>
        </t>
    </template>

    <template id="report_award">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="atmta_procurement_award.report_award_document"/>
            </t>
        </t>
    </template>

    <record id="action_report_award" model="ir.actions.report">
        <field name="name">Award Recommendation / Decision</field>
        <field name="model">realestate.procurement.award</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">atmta_procurement_award.report_award</field>
        <field name="report_file">atmta_procurement_award.report_award</field>
        <field name="binding_model_id" ref="atmta_procurement_award.model_realestate_procurement_award"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Award - %s' % (object.name)</field>
        <field name="groups_id" eval="[(6, 0, [
            ref('atmta_roles.group_procurement_buyer'),
            ref('atmta_roles.group_procurement_manager')])]"/>
    </record>

</odoo>
