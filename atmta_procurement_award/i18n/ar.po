#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"%(count)s unawarded quotation(s) cancelled: %(names)s. The submitted bids "
"themselves are M5 evidence and are unchanged."
msgstr ""
"تم إلغاء %(count)s من عروض الأسعار غير المرساة: %(names)s. العطاءات المقدمة "
"نفسها تمثل أدلة M5 ولم تتغير."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid "%(name)s is %(state)s. Only an approved award may be issued."
msgstr "%(name)s في حالة %(state)s. لا يمكن إصدار إلا ترسية معتمدة."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"%(name)s is recorded as a single award but names %(count)s vendors. Set the "
"award type to split."
msgstr ""
"%(name)s مسجلة كترسية منفردة لكنها تسمي %(count)s موردين. اضبط نوع الترسية "
"على مجزأة."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"%(name)s leaves part of the tender unawarded but is recorded as a %(type)s award.\n"
"\n"
"Set the type to partial. The difference matters: a partial award leaves demand still reserved and still needing to be bought, and the file should say that was the decision rather than an omission."
msgstr ""
"%(name)s تترك جزءًا من المناقصة دون ترسية لكنها مسجلة كترسية من نوع %(type)s.\n"
"\n"
"اضبط النوع على جزئية. الفرق مهم: الترسية الجزئية تبقي الطلب محجوزًا وما زال يحتاج إلى الشراء، ويجب أن يوضح الملف أن ذلك كان قرارًا وليس سهوًا."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"%(name)s was approved on %(when)s. Its substance cannot be edited — "
"%(fields)s would change what was authorised after it was authorised."
msgstr ""
"تم اعتماد %(name)s في %(when)s. لا يمكن تعديل مضمونها — تعديل %(fields)s "
"سيغير ما تم اعتماده بعد اعتماده."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"%(orders)s did not confirm, so nothing in this award has been issued. A "
"part-issued award would leave the tender in a state nobody decided on."
msgstr ""
"لم يتم تأكيد %(orders)s، لذا لم يصدر أي شيء من هذه الترسية. الترسية المصدرة "
"جزئيًا ستترك المناقصة في حالة لم يقررها أحد."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"%(plan)s is no longer frozen, so the ranking this award follows was produced"
" against a basis that has since moved."
msgstr ""
"%(plan)s لم تعد مجمدة، لذا فإن الترتيب الذي تتبعه هذه الترسية أعد على أساس "
"تغير منذ ذلك الحين."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"%(round)s already has a live award (%(other)s, %(state)s). Revise that one "
"or cancel it — two live awards on one evaluation would each authorise their "
"own orders."
msgstr ""
"توجد بالفعل ترسية قائمة على %(round)s (%(other)s، %(state)s). راجع تلك "
"الترسية أو ألغها — وجود ترسيتين قائمتين على تقييم واحد يعني أن كلًا منهما "
"ستعتمد أوامرها الخاصة."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"%(round)s is %(state)s. An award is founded on a completed evaluation — "
"awarding against one still in progress would decide the tender before it had"
" been judged."
msgstr ""
"%(round)s في حالة %(state)s. تبنى الترسية على تقييم مكتمل — والترسية بناءً "
"على تقييم ما زال قيد التنفيذ تحسم المناقصة قبل أن يتم تقييمها."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"%(user)s is not entitled to %(what)s. An award commits a project's budget; "
"write access to the record is not the same permission."
msgstr ""
"%(user)s غير مخول بـ %(what)s. الترسية تلزم ميزانية المشروع؛ وصلاحية التعديل"
" على السجل ليست الصلاحية نفسها."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"%(vendor)s is awarded %(awarded)s of %(line)s, but only %(tendered)s was "
"tendered. Nobody approved the difference."
msgstr ""
"تمت ترسية %(awarded)s من %(line)s على %(vendor)s، بينما طرح في المناقصة "
"%(tendered)s فقط. لم يعتمد أحد هذا الفرق."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"%(vendor)s is awarded nothing, so %(order)s would confirm empty. Remove the "
"award line instead."
msgstr ""
"لم تتم ترسية أي شيء على %(vendor)s، لذا سيتم تأكيد %(order)s فارغًا. احذف "
"بند الترسية بدلًا من ذلك."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"%(vendor)s is not currently eligible to receive an award:\n"
"\n"
"%(reasons)s\n"
"\n"
"The evaluation may have been sound; the vendor's standing has changed since."
msgstr ""
"%(vendor)s غير مؤهل حاليًا لتلقي الترسية:\n"
"\n"
"%(reasons)s\n"
"\n"
"ربما كان التقييم سليمًا؛ لكن وضع المورد تغير منذ ذلك الحين."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"%(vendor)s's offer expired on %(date)s and was awarded anyway; confirm the "
"vendor still stands behind it."
msgstr ""
"انتهت صلاحية عرض %(vendor)s في %(date)s وتمت ترسيته رغم ذلك؛ تأكد من أن "
"المورد ما زال ملتزمًا به."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"%(vendor)s's order has no live reservation behind it; confirming it will "
"commit against capacity that is no longer held."
msgstr ""
"أمر %(vendor)s لا يستند إلى حجز ميزانية قائم؛ تأكيده سيلزم مبالغ من سعة لم "
"تعد محجوزة."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid "%(vendor)s: %(warning)s"
msgstr "%(vendor)s: %(warning)s"

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"%(vendors)s are named on this award but awarded nothing.\n"
"\n"
"Caught here rather than at issue: an award line with no quantity would go through approval looking like a decision and then refuse at the moment somebody expected orders to be placed. Remove the line, or give it a quantity."
msgstr ""
"%(vendors)s مذكورون في هذه الترسية لكن لم تتم ترسية أي شيء عليهم.\n"
"\n"
"تم اكتشاف ذلك هنا بدلًا من مرحلة الإصدار: بند ترسية بلا كمية سيمر عبر الاعتماد وكأنه قرار ثم يرفض في اللحظة التي يتوقع فيها أحد إصدار الأوامر. احذف البند أو حدد له كمية."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"%(vendors)s did not rank first, and awarding them needs a recorded reason.\n"
"\n"
"Awarding away from the ranking is permitted — the ranking is an evaluation outcome, not an instruction — but an award file that cannot say why is indistinguishable from one that had no reason."
msgstr ""
"%(vendors)s لم يحصلوا على المرتبة الأولى، والترسية عليهم تتطلب تسجيل سبب.\n"
"\n"
"الترسية خلافًا للترتيب مسموح بها — فالترتيب نتيجة تقييم وليس تعليمات — لكن ملف الترسية الذي لا يوضح السبب لا يمكن تمييزه عن ملف لم يكن له سبب."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid "%s awards nothing."
msgstr "%s لا ترسي أي شيء."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid "%s awards the whole tender but is recorded as partial."
msgstr "%s ترسي المناقصة بالكامل لكنها مسجلة كترسية جزئية."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid "%s evaluates a different tender."
msgstr "%s تقيم مناقصة مختلفة."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"%s has been issued and its purchase orders are live. Cancel the orders "
"instead — that is what reverses the commitment, and M3 already does it."
msgstr ""
"تم إصدار %s وأوامر الشراء الخاصة بها قائمة. ألغ الأوامر بدلًا من ذلك — فهذا "
"ما يعكس الالتزام، وM3 يقوم بذلك بالفعل."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid "%s has not been submitted for approval."
msgstr "لم يتم إرسال %s للاعتماد."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"%s is an approved award and purchase orders were authorised against it."
msgstr "%s ترسية معتمدة وتم اعتماد أوامر شراء بناءً عليها."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid "%s is cancelled."
msgstr "%s ملغاة."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"%s is issued and its orders are confirmed. Cancel the orders to reverse the "
"commitment, then raise a new award — a revision cannot un-commit money."
msgstr ""
"تم إصدار %s وتأكيد أوامرها. ألغ الأوامر لعكس الالتزام، ثم أنشئ ترسية جديدة —"
" فالمراجعة لا يمكنها إلغاء التزام مالي."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid "%s is not a draft."
msgstr "%s ليست مسودة."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid "%s is recorded as a split award but names one vendor."
msgstr "%s مسجلة كترسية مجزأة لكنها تسمي موردًا واحدًا."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid "%s names no purchase order to issue."
msgstr "%s لا تحدد أي أمر شراء لإصداره."

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"%s raised this award. Approving your own is not a review, and this is the "
"one decision in the chain that commits money."
msgstr ""
"%s هو من أنشأ هذه الترسية. اعتمادك لما أنشأته بنفسك ليس مراجعة، وهذا هو "
"القرار الوحيد في السلسلة الذي يلزم مبالغ مالية."

#. module: atmta_procurement_award
#: model:ir.actions.report,print_report_name:atmta_procurement_award.action_report_award
msgid "'Award - %s' % (object.name)"
msgstr "'الترسية - %s' % (object.name)"

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid ""
",\n"
"                            revision"
msgstr ""
",\n"
"                            المراجعة"

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid "1. Award"
msgstr "1. الترسية"

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid "2. Awarded"
msgstr "2. المرسى عليهم"

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid "3. Awarded Scope"
msgstr "3. النطاق المرسى"

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid "4. Authorisation"
msgstr "4. التفويض"

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid "5. Revalidated at Approval"
msgstr "5. إعادة التحقق عند الاعتماد"

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid "<em>Not yet revalidated — this award has not been approved.</em>"
msgstr "<em>لم يتم التحقق بعد — هذه الترسية لم تعتمد.</em>"

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid ""
"<strong>APPROVED, NOT YET ISSUED.</strong>\n"
"                            Confirming the orders is what commits the budget."
msgstr ""
"<strong>معتمدة، لم تصدر بعد.</strong>\n"
"                            تأكيد الأوامر هو ما يلزم الميزانية."

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid ""
"<strong>CANCELLED.</strong> This award authorises\n"
"                            nothing."
msgstr ""
"<strong>ملغاة.</strong> هذه الترسية لا تعتمد\n"
"                            أي شيء."

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid "<strong>Cancellation reason.</strong>"
msgstr "<strong>سبب الإلغاء.</strong>"

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid "<strong>Company</strong>"
msgstr "<strong>الشركة</strong>"

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid "<strong>Evaluation Basis</strong>"
msgstr "<strong>أساس التقييم</strong>"

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid "<strong>Evaluation</strong>"
msgstr "<strong>التقييم</strong>"

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid ""
"<strong>ISSUED.</strong> The purchase orders below\n"
"                            are confirmed and the budget is committed."
msgstr ""
"<strong>صادرة.</strong> أوامر الشراء أدناه\n"
"                            مؤكدة والميزانية ملتزم بها."

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid "<strong>Justification.</strong>"
msgstr "<strong>المبررات.</strong>"

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid ""
"<strong>NO PURCHASE IS AUTHORISED BY THIS DOCUMENT\n"
"                        UNTIL THE ORDERS ABOVE ARE CONFIRMED.</strong>\n"
"                        Approval authorises; confirming commits."
msgstr ""
"<strong>لا يعتمد هذا المستند أي عملية شراء\n"
"                        حتى يتم تأكيد الأوامر أعلاه.</strong>\n"
"                        الاعتماد يفوض؛ والتأكيد يلزم."

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid ""
"<strong>Partial award.</strong> The unawarded balance of\n"
"                        this tender remains approved demand and remains\n"
"                        reserved against the project budget. It has not been\n"
"                        cancelled and it still needs to be bought."
msgstr ""
"<strong>ترسية جزئية.</strong> الرصيد غير المرسى من\n"
"                        هذه المناقصة يظل طلبًا معتمدًا ويظل\n"
"                        محجوزًا مقابل ميزانية المشروع. لم يتم\n"
"                        إلغاؤه وما زال يحتاج إلى الشراء."

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid "<strong>Project</strong>"
msgstr "<strong>المشروع</strong>"

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid ""
"<strong>RECOMMENDATION ONLY — NOT YET APPROVED.</strong>\n"
"                            No purchase is authorised by this document."
msgstr ""
"<strong>توصية فقط — لم تعتمد بعد.</strong>\n"
"                            لا يعتمد هذا المستند أي عملية شراء."

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid "<strong>Reference</strong>"
msgstr "<strong>المرجع</strong>"

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid "<strong>Sourcing Event</strong>"
msgstr "<strong>المناقصة</strong>"

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid ""
"<strong>The commitment shown against this project is\n"
"                        computed by Construction from the confirmed purchase\n"
"                        orders.</strong> This document does not hold a\n"
"                        commitment figure of its own, and nothing here can move\n"
"                        one."
msgstr ""
"<strong>الالتزام الظاهر مقابل هذا المشروع\n"
"                        يحسبه نظام الإنشاءات من أوامر الشراء\n"
"                        المؤكدة.</strong> لا يحتوي هذا المستند على\n"
"                        رقم التزام خاص به، ولا يمكن لأي شيء هنا تغييره."

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid ""
"<strong>This award departs from the evaluation\n"
"                        ranking.</strong> That is permitted — a ranking is an\n"
"                        evaluation outcome, not an instruction — and the reason\n"
"                        is recorded below."
msgstr ""
"<strong>هذه الترسية تخالف ترتيب\n"
"                        التقييم.</strong> وهذا مسموح به — فالترتيب نتيجة\n"
"                        تقييم وليس تعليمات — والسبب\n"
"                        مسجل أدناه."

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid "<strong>Total Awarded</strong>"
msgstr "<strong>إجمالي المبلغ المرسى</strong>"

#. module: atmta_procurement_award
#: model_terms:ir.ui.view,arch_db:atmta_procurement_award.report_award_document
msgid "<strong>Type</strong>"
msgstr "<strong>النوع</strong>"

#. module: atmta_procurement_award
#. odoo-python
#: code:addons/atmta_procurement_award/models/procurement_award.py:0
msgid ""
"A revised award needs a reason. Changing an authorisation without one is "
