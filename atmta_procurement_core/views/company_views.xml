<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- The policies this module declares, on the form of the record that
         holds them. Four of them had no screen at all: receipt inspection,
         late bids, self-approved late exceptions and addendum
         acknowledgement were settable only from SQL or an upgrade script,
         which means in practice they were never changed from the shipped
         default. The control and vendor policies keep their own groups on
         this form, in the modules that enforce them. -->

    <record id="view_company_form_procurement_sourcing" model="ir.ui.view">
        <field name="name">res.company.form.procurement.sourcing</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Procurement — Sourcing &amp; Receiving"
                       name="procurement_sourcing_receiving">
                    <group>
                        <field name="procurement_late_bid_policy"/>
                        <field name="procurement_allow_self_late_exception"/>
                    </group>
                    <group>
                        <field name="procurement_addendum_ack_policy"/>
                        <field name="procurement_receipt_inspection"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
