<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
        <t t-inherit="web.SwitchCompanyMenu" t-inherit-mode="extension">
<xpath expr="//div" position="before">
    <div class="o_switch_company_menu d-flex" style="
        padding: 15px 18px;
        border-radius: 24px;
        background: linear-gradient(90deg, #fff8e1 0%, #fff3cd 100%);
        border: 2px solid #ffca28;
        box-shadow: 0 6px 12px rgba(0,0,0,0.1);
        align-items: center;
        gap: 6px;
        animation: pulse-bg 2s ease-in-out infinite;
        font-family: 'Inter', sans-serif;
        transform: scale(1.03);
        margin: 0px 12px;
        margin-top:-5px;"
    >

        <i class="fa fa-exclamation-circle warning-icon" style="
            color: #f57c00;
            font-size: 18px;
        "/>

        <span t-esc="companyService.activeCompanyIds.length" class="company-count" style="
            color: #e65100;
            font-size: 14px;
            font-weight: 600;
            min-width: 20px;
            text-align: center;
        "/>

        <span class="company-label" style="
            color: #6d4c41;
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;">
            <t t-if="companyService.activeCompanyIds.length > 1">
                <span class="company-text">Companies</span>
            </t>
            <t t-else="">
                <span class="company-text">Company</span>
            </t>
<!--            <span class="selected-text"> selected</span>-->
        </span>
    </div>

    <style>
        @keyframes pulse-bg {
            0%   { box-shadow: 0 0 0 0 rgba(255,202,40, 0.6); }
            50%  { box-shadow: 0 0 0 12px rgba(255,202,40, 0.1); }
            100% { box-shadow: 0 0 0 0 rgba(255,202,40, 0.1); }
        }

        @keyframes pulse-icon {
            0% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.2); opacity: 0.8; }
            100% { transform: scale(1); opacity: 1; }
        }

        .warning-icon {
            animation: pulse-icon 2s infinite ease-in-out;
        }

        @media (max-width: 767.98px) {
            .o_switch_company_menu {
                padding: 8px 10px !important;
                transform: scale(1) !important;
            }
            .warning-icon {
                font-size: 16px !important;
            }
            .company-count {
                font-size: 12px !important;
            }
            .company-label {
                font-size: 12px !important;
            }
            .selected-text {
                display: none !important;
            }
        }
    </style>
</xpath>

    </t>
</templates>
