<odoo>
    <data>
        <record model="ir.ui.view" id="account_invoice_form_custom_inherit">
            <field name="name">Account Invoice</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='line_ids']/list/field[@name='account_id']" position="before">
                    <field name="sequence" widget="handle"/>
                </xpath>

                <xpath expr="//field[@name='line_ids']/list/field[@name='name']" position="after">
                    <field name="cheque_number"/>
                    <field name="description"/>
                    <field name="account_type" column_invisible="True"/>
                </xpath>
                <xpath expr="//field[@name='line_ids']/list/field[@name='partner_id']" position="attributes">
                    <attribute name="required">account_type in ('asset_receivable','liability_payable')</attribute>
                    <attribute name="domain">
                        ['|','|',
                        ('property_account_receivable_id', '=', account_id),
                        ('property_account_payable_id', '=', account_id),
                        '&amp;',
                        ('property_account_receivable_id.account_type', '!=', account_type),
                        ('property_account_payable_id.account_type', '!=', account_type)
                        ]
                    </attribute>
                </xpath>
            </field>
        </record>
        <record id="view_account_move_line_tree_custom_inherit" model="ir.ui.view">
            <field name="name">account.move.line.tree</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_tree"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="cheque_number"/>
                    <field name="description"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
