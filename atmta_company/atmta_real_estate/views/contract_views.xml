<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_realestate_contract_form" model="ir.ui.view">
        <field name="name">realestate.contract.form</field>
        <field name="model">realestate.contract</field>
        <field name="arch" type="xml">
            <form string="Real Estate Contract">
                <header>
                    <button name="action_generate_payment_schedule"
                            type="object"
                            string="Generate Payment Schedule"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_payments"
                                icon="fa-pencil-square-o"
                                type="object"
                                class="oe_stat_button"
                                invisible="payment_count == 0"
                        >
                        <field string="Payments" name="payment_count" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="notes"/>
                    </group>
                    <notebook>
                        <page string="Contract Lines">
                            <field name="line_ids" widget="sol_o2m" mode="list,kanban">
                                <form string="Contract Line">
                                    <sheet>
                                        <group col="2">
                                            <field name="contract_id"/>
                                            <field name="property_id"/>
                                            <field name="payment_plan_ids" widget="many2many_tags"/>
                                            <field name="price"/>
                                        </group>
                                        <group>
                                            <field name="notes"/>
                                        </group>
                                    </sheet>
                                </form>

                                <list string="Contract Lines" editable="bottom">
                                    <field name="property_id"/>
                                    <field name="payment_plan_ids" widget="many2many_tags" options="{'no_create': True}"
                                           optional="show"/>
                                    <field name="increment_rule_ids" widget="many2many_tags" options="{'no_create': True}"
                                           optional="show"/>
                                    <field name="discount_rule_ids" widget="many2many_tags" options="{'no_create': True}"
                                           optional="show"/>
                                    <field name="price"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_realestate_contract_list" model="ir.ui.view">
        <field name="name">realestate.contract.list</field>
        <field name="model">realestate.contract</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_realestate_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">realestate.contract</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
