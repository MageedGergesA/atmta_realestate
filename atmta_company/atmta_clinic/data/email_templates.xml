<odoo>
  <data>
    <record id="email_template_invoice" model="mail.template">
      <field name="name">Invoice Email</field>
      <field name="model_id" ref="model_clinic_billing"/>
      <field name="subject">Your Invoice from the Clinic</field>
      <field name="email_from">${(user.email or 'info@yourclinic.com')|safe}</field>
      <field name="email_to">${object.patient_id.email|safe}</field>
      <field name="body_html"><![CDATA[
        <p>Dear ${object.patient_id.name},</p>
        <p>Please find your invoice attached.</p>
        <p>Thank you!</p>
      ]]></field>
      <field name="report_template" ref="atmta_clinic.report_invoice_document"/>
      <field name="report_name">Invoice_${object.id}</field>
    </record>
  </data>
</odoo> 