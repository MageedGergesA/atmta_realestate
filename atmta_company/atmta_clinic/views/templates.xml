        <!-- Website: Clinic Homepage -->
        <template id="website_homepage" name="Clinic Homepage">
            <t t-call="website.layout">
                <div class="container mt-5">
                    <div class="jumbotron">
                        <h1 class="display-4">Welcome to Our Clinic</h1>
                        <p class="lead">Comprehensive care for you and your family.</p>
                        <hr class="my-4"/>
                        <p>Book appointments, view your records, and more.</p>
                        <a class="btn btn-primary btn-lg" href="/appointment/request">Request Appointment</a>
                    </div>
                </div>
            </t>
        </template>

        <!-- Website: Appointment Request Form -->
        <template id="website_appointment_request" name="Appointment Request">
            <t t-call="website.layout">
                <div class="container mt-5">
                    <h2>Request an Appointment</h2>
                    <form action="/appointment/request/submit" method="post" class="mt-4">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label for="name">Name</label>
                                <input type="text" class="form-control" id="name" name="name" required="required"/>
                            </div>
                            <div class="form-group col-md-6">
                                <label for="email">Email</label>
                                <input type="email" class="form-control" id="email" name="email" required="required"/>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label for="phone">Phone</label>
                                <input type="text" class="form-control" id="phone" name="phone"/>
                            </div>
                            <div class="form-group col-md-6">
                                <label for="date">Preferred Date</label>
                                <input type="date" class="form-control" id="date" name="date" required="required"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="notes">Notes</label>
                            <textarea class="form-control" id="notes" name="notes" rows="3"></textarea>
                        </div>
