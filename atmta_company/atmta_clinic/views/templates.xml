        <!-- Patient Portal: My Appointments -->
        <template id="portal_my_appointments" name="My Appointments">
            <t t-call="portal.portal_layout">
                <div class="o_portal_wrap">
                    <h2>My Appointments</h2>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Provider</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="appointments" t-as="appt">
                                <tr>
                                    <td>
                                        <t t-esc="appt.date_start"/>
                                    </td>
                                    <td>
                                        <t t-esc="appt.provider_id.name"/>
                                    </td>
                                    <td>
                                        <t t-esc="appt.status"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </template>

        <!-- Patient Portal: My Bills -->
        <template id="portal_my_bills" name="My Bills">
            <t t-call="portal.portal_layout">
                <div class="o_portal_wrap">
                    <h2>My Bills</h2>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="bills" t-as="bill">
                                <tr>
                                    <td>
                                        <t t-esc="bill.due_date"/>
                                    </td>
                                    <td>
                                        <t t-esc="bill.amount"/>
                                    </td>
                                    <td>
                                        <t t-esc="bill.status"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </template>

        <!-- Patient Portal: My Lab Results -->
        <template id="portal_my_lab_results" name="My Lab Results">
            <t t-call="portal.portal_layout">
                <div class="o_portal_wrap">
                    <h2>My Lab Results</h2>
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Test</th>
                                <th>Date</th>
                                <th>Result</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="lab_results" t-as="result">
                                <tr>
                                    <td>
                                        <t t-esc="result.request_id.test_type"/>
                                    </td>
                                    <td>
                                        <t t-esc="result.approval_date"/>
                                    </td>
                                    <td>
                                        <t t-esc="result.result"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </template>

