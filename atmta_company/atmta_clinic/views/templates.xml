        <!-- Clinic Visit Summary Report Template -->
        <template id="report_visit_summary_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="visit">
                    <div class="page">
                        <h2>Visit Summary</h2>
                        <p>
                            <strong>Patient:</strong>
                            <t t-esc="visit.patient_id.name"/>
                        </p>
                        <p>
                            <strong>Doctor:</strong>
                            <t t-esc="visit.doctor_id.user_id.name"/>
                        </p>
                        <p>
                            <strong>Date:</strong>
                            <t t-esc="visit.date"/>
                        </p>
                        <p>
                            <strong>Visit Reason:</strong>
                            <t t-esc="visit.visit_reason"/>
                        </p>
                        <h3>SOAP Notes</h3>
                        <p>
                            <strong>Subjective:</strong>
                            <t t-esc="visit.subjective"/>
                        </p>
                        <p>
                            <strong>Objective:</strong>
                            <t t-esc="visit.objective"/>
                        </p>
                        <p>
                            <strong>Assessment:</strong>
                            <t t-esc="visit.assessment"/>
                        </p>
                        <p>
                            <strong>Plan:</strong>
                            <t t-esc="visit.plan"/>
                        </p>
                        <h3>Vitals</h3>
                        <ul>
                            <t t-foreach="visit.vital_signs_ids" t-as="vital">
                                <li>
                                    <t t-esc="vital.create_date"/>:
                                    Temp:
                                    <t t-esc="vital.temperature"/>
                                    C,
                                    BP:<t t-esc="vital.blood_pressure"/>,
                                    HR:<t t-esc="vital.heart_rate"/>,
                                    RR:<t t-esc="vital.respiratory_rate"/>,
                                    SpO2:<t t-esc="vital.spo2"/>,
                                    Wt:
                                    <t t-esc="vital.weight"/>
                                    kg,
                                    Ht:
                                    <t t-esc="vital.height"/>
                                    cm
                                </li>
                            </t>
                        </ul>
                        <h3>Medical Records</h3>
                        <ul>
                            <t t-foreach="visit.medical_record_ids" t-as="rec">
                                <li>
                                    <strong>Diagnosis:</strong>
                                    <t t-esc="rec.diagnosis"/>
                                    <br/>
                                    <strong>Notes:</strong>
                                    <t t-esc="rec.notes"/>
                                </li>
                            </t>
                        </ul>
                        <h3>Attachments</h3>
                        <ul>
                            <t t-foreach="visit.attachment_ids" t-as="att">
                                <li>
                                    <t t-esc="att.name"/>
                                </li>
                            </t>
                        </ul>
                    </div>
                </t>
            </t>
        </template>

