<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!--
            Wave 12 — the company rules for the two cost-structure models.

            Only these two moved. The WBS project-team rule stayed in
            `real_estate_construction`, because its domain reads
            `project_id.construction_member_ids`, a field that module declares
            on the project. A rule may be declared above the model it guards;
            it may not be declared below the field it reads.
        -->

        <record id="rule_realestate_construction_wbs_company" model="ir.rule">
            <field name="name">realestate.construction.wbs: company</field>
            <field name="model_id" ref="model_realestate_construction_wbs"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_realestate_construction_cost_code_company" model="ir.rule">
            <field name="name">realestate.construction.cost.code: company</field>
            <field name="model_id" ref="model_realestate_construction_cost_code"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
