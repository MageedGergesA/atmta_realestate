<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="rule_receipt_inspection_company" model="ir.rule">
                <field name="name">Receipt inspection: company</field>
                <field name="model_id" ref="model_realestate_procurement_receipt_inspection"/>
                <field name="domain_force">[('company_id', 'in', company_ids)]</field>
                <field name="global" eval="True"/>
            </record>

        <record id="rule_receipt_inspection_line_company" model="ir.rule">
                <field name="name">Receipt inspection line: company</field>
                <field name="model_id" ref="model_realestate_procurement_receipt_inspection_line"/>
                <field name="domain_force">[('company_id', 'in', company_ids)]</field>
                <field name="global" eval="True"/>
            </record>

    </data>
</odoo>
