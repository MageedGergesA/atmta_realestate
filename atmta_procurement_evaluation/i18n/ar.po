#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_round.py:0
msgid ""
"%(count)s evaluation sheet(s) are still in draft. Finalising now would "
"consolidate scores nobody has submitted."
msgstr ""
"لا تزال %(count)s ورقة تقييم في حالة مسودة. الاعتماد النهائي الآن سيجمع "
"درجات لم يقدمها أحد."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_candidate.py:0
msgid ""
"%(evaluator)s submitted this evaluation on %(when)s. It is their opinion on "
"the record — reopen it with a reason instead of rewriting it."
msgstr ""
"قدّم %(evaluator)s هذا التقييم في %(when)s. إنه رأيه المسجل — أعد فتحه مع "
"ذكر السبب بدلًا من إعادة كتابته."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_candidate.py:0
msgid "%(evaluator)s's sheet for %(vendor)s reopened by %(user)s: %(reason)s"
msgstr ""
"أعاد %(user)s فتح ورقة تقييم %(evaluator)s للمورد %(vendor)s: %(reason)s"

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_plan.py:0
msgid ""
"%(name)s belongs to a frozen evaluation basis. Changing it now would change "
"how offers already being scored are judged."
msgstr ""
"%(name)s ينتمي إلى أساس تقييم مجمّد. تغييره الآن سيغير طريقة الحكم على "
"العروض التي يجري تقييمها بالفعل."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_round.py:0
msgid ""
"%(name)s is already at %(state)s. Evaluation does not step backwards — "
"reopening the technical stage after prices are visible is exactly what "
"staging prevents. Use a controlled reopen with a reason, or a new round."
msgstr ""
"%(name)s في مرحلة %(state)s بالفعل. التقييم لا يعود إلى الخلف — فإعادة فتح "
"المرحلة الفنية بعد ظهور الأسعار هو بالضبط ما يمنعه التقييم المرحلي. استخدم "
"إعادة فتح مضبوطة مع ذكر السبب، أو جولة جديدة."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_candidate.py:0
msgid "%(name)s is scored out of %(max)s."
msgstr "الدرجة القصوى لـ %(name)s هي %(max)s."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_plan.py:0
msgid ""
"%(name)s was frozen on %(when)s. Its basis cannot be edited — %(fields)s "
"would change how offers already under evaluation are judged. Raise a "
"revision instead."
msgstr ""
"تم تجميد %(name)s في %(when)s. لا يمكن تعديل أساسه — فتعديل %(fields)s سيغير"
" طريقة الحكم على العروض الجاري تقييمها. أنشئ مراجعة بدلًا من ذلك."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_round.py:0
msgid ""
"%(plan)s is not frozen. Scoring against a basis that can still change is not"
" evaluation."
msgstr ""
"%(plan)s غير مجمدة. منح الدرجات وفق أساس لا يزال قابلًا للتغيير ليس تقييمًا."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/wizard/evaluation_audit_wizard.py:0
msgid ""
"%(rounds)s evaluation round(s) audited. %(critical)s critical, %(high)s high, %(medium)s medium, %(low)s low.\n"
"\n"
"Nothing has been changed. Every finding below is a question for a person to answer — correcting one automatically would remove the evidence that it happened."
msgstr ""
"تم تدقيق %(rounds)s جولة تقييم. %(critical)s حرجة، %(high)s عالية، %(medium)s متوسطة، %(low)s منخفضة.\n"
"\n"
"لم يتم تغيير أي شيء. كل ملاحظة أدناه سؤال يجب أن يجيب عنه شخص — فتصحيحها تلقائيًا سيزيل الدليل على وقوعها."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_candidate.py:0
msgid ""
"%(user)s has an unresolved conflict-of-interest declaration on this round, "
"so their scores cannot be recorded."
msgstr ""
"لدى %(user)s إقرار تعارض مصالح لم يُحسم في هذه الجولة، لذلك لا يمكن تسجيل "
"درجاته."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_round.py:0
msgid ""
"%(user)s is not entitled to %(what)s on %(name)s. Running an evaluation is "
"the Evaluation Manager's role; write access to the record is not the same "
"permission."
msgstr ""
"لا يحق لـ %(user)s تنفيذ %(what)s على %(name)s. إدارة التقييم من صلاحيات "
"مدير التقييم؛ وصلاحية الكتابة على السجل ليست الصلاحية نفسها."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_plan.py:0
msgid ""
"%(user)s is not entitled to %(what)s. The methodology decides how every "
"offer is judged; write access to the draft is not the same permission."
msgstr ""
"لا يحق لـ %(user)s تنفيذ %(what)s. المنهجية تحدد طريقة الحكم على كل عرض؛ "
"وصلاحية الكتابة على المسودة ليست الصلاحية نفسها."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/commercial_analysis.py:0
msgid "%s belongs to a finalised evaluation."
msgstr "%s يتبع تقييمًا تم اعتماده نهائيًا."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_candidate.py:0
msgid ""
"%s belongs to a finalised evaluation. Reopen the round with a reason if it "
"genuinely has to change."
msgstr ""
"%s يتبع تقييمًا تم اعتماده نهائيًا. أعد فتح الجولة مع ذكر السبب إذا كان "
"التغيير ضروريًا فعلًا."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_plan.py:0
msgid "%s belongs to a frozen evaluation basis."
msgstr "%s يتبع أساس تقييم مجمدًا."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_round.py:0
msgid "%s declared this conflict. Clearing your own is not a review."
msgstr "%s هو من أقر بهذا التعارض. حسم تعارضك بنفسك ليس مراجعة."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_round.py:0
msgid ""
"%s did not pass technical evaluation and cannot be invited to re-offer."
msgstr "%s لم يجتز التقييم الفني ولا يمكن دعوته لتقديم عرض جديد."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_round.py:0
msgid "%s does not allow a best and final offer."
msgstr "%s لا تسمح بتقديم أفضل عرض نهائي."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/commercial_analysis.py:0
msgid "%s entered this adjustment. Approving your own is not a review."
msgstr "%s هو من أدخل هذا التعديل. اعتماد تعديلك بنفسك ليس مراجعة."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/wizard/evaluation_audit_wizard.py:0
msgid ""
"%s evaluation round(s) audited. No findings.\n"
"\n"
"Seventeen checks ran and none of them matched."
msgstr ""
"تم تدقيق %s جولة تقييم. لا توجد ملاحظات.\n"
"\n"
"تم تنفيذ سبعة عشر فحصًا ولم يتطابق أي منها."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_round.py:0
msgid "%s has no administratively eligible bid to evaluate."
msgstr "لا يوجد لدى %s عطاء مؤهل إداريًا للتقييم."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_plan.py:0
msgid ""
"%s has no criteria. An evaluation with no declared basis is an opinion."
msgstr "لا توجد معايير في %s. التقييم بلا أساس معلن مجرد رأي."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_round.py:0
msgid "%s has not been through commercial evaluation."
msgstr "%s لم يخضع للتقييم المالي."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_plan.py:0
msgid "%s is a frozen evaluation basis and offers were judged against it."
msgstr "%s أساس تقييم مجمد وقد تم الحكم على العروض وفقه."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_plan.py:0
msgid ""
"%s is a mandatory criterion, so it cannot carry a weight. Passing it is not "
"worth points; failing it ends the bid."
msgstr ""
"%s معيار إلزامي، لذلك لا يمكن أن يحمل وزنًا. اجتيازه لا يمنح درجات؛ وعدم "
"اجتيازه ينهي العطاء."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_plan.py:0
msgid ""
"%s is already being evaluated against. Cancel or complete the round before "
"revising the basis — rewriting the rules mid-evaluation is what the freeze "
"exists to prevent."
msgstr ""
"يجري التقييم وفق %s بالفعل. ألغِ الجولة أو أكملها قبل مراجعة الأساس — فإعادة"
" كتابة القواعد أثناء التقييم هي ما وُجد التجميد لمنعه."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_plan.py:0
msgid "%s is already frozen."
msgstr "%s مجمد بالفعل."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_round.py:0
msgid "%s is cancelled."
msgstr "%s ملغاة."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/commercial_analysis.py:0
#: code:addons/atmta_procurement_evaluation/models/evaluation_deviation.py:0
msgid "%s is finalised."
msgstr "%s معتمد نهائيًا."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_round.py:0
msgid ""
"%s is finalised. A completed evaluation is evidence that the offers were "
"judged; cancel it and the file no longer records what was decided. Raise a "
"new round instead."
msgstr ""
"%s معتمد نهائيًا. التقييم المكتمل دليل على أن العروض قد تم الحكم عليها؛ "
"وإلغاؤه يعني أن الملف لن يسجل ما تقرر. أنشئ جولة جديدة بدلًا من ذلك."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/commercial_analysis.py:0
msgid ""
"%s is finalised. Flagging an offer for review after the evaluation closed "
"re-characterises it after the fact."
msgstr ""
"%s معتمد نهائيًا. وضع علامة مراجعة على عرض بعد إغلاق التقييم يعيد توصيفه "
"بأثر رجعي."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/commercial_analysis.py:0
msgid "%s is finalised. Its commercial basis cannot be recalculated."
msgstr "%s معتمد نهائيًا. لا يمكن إعادة احتساب أساسه المالي."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/commercial_analysis.py:0
msgid ""
"%s is finalised; its adjustments were approved, or not, before the ranking "
"was struck."
msgstr ""
"%s معتمد نهائيًا؛ وقد تم البت في اعتماد تعديلاته أو رفضها قبل تحديد الترتيب."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_round.py:0
msgid ""
"%s is not finalised. An evaluation report issued mid-evaluation would state "
"a result that has not been reached."
msgstr ""
"%s غير معتمد نهائيًا. إصدار تقرير تقييم أثناء التقييم سيعلن نتيجة لم يتم "
"التوصل إليها بعد."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_candidate.py:0
msgid "%s is not on the evaluation committee for this round."
msgstr "%s ليس عضوًا في لجنة التقييم لهذه الجولة."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_round.py:0
msgid ""
"%s is still open for bidding. Evaluating before the deadline would judge the"
" vendors who happened to be early."
msgstr ""
"%s لا تزال مفتوحة لتقديم العطاءات. التقييم قبل الموعد النهائي يعني الحكم على"
" الموردين الذين صادف أنهم قدموا مبكرًا."

#. module: atmta_procurement_evaluation
#. odoo-python
#: code:addons/atmta_procurement_evaluation/models/evaluation_round.py:0
msgid "%s offer(s) have not been normalised."
msgstr "لم يتم توحيد أساس %s عرض/عروض."

