",\n"
"                            المراجعة"

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid "1. Evaluation"
msgstr "1. التقييم"

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid "2. Evaluation Committee"
msgstr "2. لجنة التقييم"

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid "3. Candidate Basis"
msgstr "3. أساس المرشحين"

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid "4. Technical Evaluation"
msgstr "4. التقييم الفني"

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid "5. Commercial Evaluation"
msgstr "5. التقييم المالي"

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid "6. Final Evaluation"
msgstr "6. التقييم النهائي"

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid "7. Deviations"
msgstr "7. الانحرافات"

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid "8. Audit Trail"
msgstr "8. سجل التدقيق"

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid ""
"<em>No committee member was recorded\n"
"                                against this round.</em>"
msgstr "<em>لم يتم تسجيل أي عضو لجنة لهذه الجولة.</em>"

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid "<strong>Basis frozen</strong>"
msgstr "<strong>تجميد الأساس</strong>"

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid ""
"<strong>Commercial adjustments, itemised.</strong>\n"
"                           The raw bid above is what the vendor submitted and is\n"
"                           unchanged by any of these."
msgstr ""
"<strong>التعديلات المالية مفصلة بندًا بندًا.</strong> العطاء الأصلي أعلاه هو"
" ما قدمه المورد ولا يتغير بأي منها."

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid "<strong>Commercial opened</strong>"
msgstr "<strong>فتح التقييم المالي</strong>"

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid ""
"<strong>Committee result.</strong>\n"
"                   Consolidated as"
msgstr "<strong>نتيجة اللجنة.</strong> موحدة بطريقة"

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid "<strong>Company</strong>"
msgstr "<strong>الشركة</strong>"

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid ""
"<strong>Criteria.</strong>\n"
"                    Threshold"
msgstr "<strong>المعايير.</strong> الحد الأدنى"

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid ""
"<strong>EVALUATION RESULT ONLY. NO AWARD IS CREATED BY\n"
"                    THIS REPORT.</strong>\n"
"                    Deciding whether to act on this evaluation is a separate,\n"
"                    separately authorised act. Nothing in this document\n"
"                    commits budget, creates a purchase order or selects a\n"
"                    supplier."
msgstr ""
"<strong>نتيجة تقييم فقط. لا ينشئ هذا التقرير أي ترسية.</strong> قرار التصرف "
"بناءً على هذا التقييم إجراء منفصل يتطلب تفويضًا مستقلًا. لا يوجد في هذا "
"المستند ما يلتزم بميزانية أو ينشئ أمر شراء أو يختار موردًا."

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid ""
"<strong>EVALUATION RESULT ONLY.</strong>\n"
"                        No award is created by this report and no purchase is\n"
"                        authorised by it."
msgstr ""
"<strong>نتيجة تقييم فقط.</strong> لا ينشئ هذا التقرير أي ترسية ولا يفوض بأي "
"عملية شراء."

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid "<strong>Evaluation Currency</strong>"
msgstr "<strong>عملة التقييم</strong>"

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid "<strong>Evaluation Plan</strong>"
msgstr "<strong>خطة التقييم</strong>"

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid "<strong>Evaluation Round</strong>"
msgstr "<strong>جولة التقييم</strong>"

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid "<strong>Evaluation finalised</strong>"
msgstr "<strong>اعتماد التقييم نهائيًا</strong>"

#. module: atmta_procurement_evaluation
#: model_terms:ir.ui.view,arch_db:atmta_procurement_evaluation.report_evaluation_document
msgid "<strong>Finalised</strong>"
msgstr "<strong>معتمد نهائيًا</strong>"

#. module: atmta_procurement_evaluation
