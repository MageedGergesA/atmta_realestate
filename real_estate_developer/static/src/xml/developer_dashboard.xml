<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Development and Sales Overview. Same layout, components and reading
         order as Rental and Brokerage: KPIs, then why, then what is wrong,
         then what I do about it, then the detail. -->
    <t t-name="real_estate_developer.DeveloperDashboard">
        <div class="o_ad_dashboard o_re_dashboard o_action">
            <div class="o_ad_scroll">

                <header class="o_ad_header">
                    <div>
                        <h1 class="o_ad_title">Development &amp; Sales</h1>
                        <p class="o_ad_subtitle" t-if="isReady">
                            <span t-esc="data.company_name"/>
                            <span class="o_ad_sep" aria-hidden="true">·</span>
                            <span class="o_ad_asof">
                                <i class="fa fa-calendar-o" aria-hidden="true"/>
                                <span>As of <t t-esc="data.as_of"/></span>
                            </span>
                            <t t-if="lastUpdatedLabel">
                                <span class="o_ad_sep" aria-hidden="true">·</span>
                                <span t-esc="lastUpdatedLabel"/>
                            </t>
                        </p>
                    </div>
                    <div class="o_ad_header_actions">
                        <t t-foreach="data.quick_actions or []" t-as="quick" t-key="quick.key">
                            <button class="btn btn-sm"
                                    t-att-class="quick_first ? 'btn-primary' : 'btn-secondary'"
                                    t-on-click="() => this.runQuickAction(quick.key)">
                                <i t-attf-class="fa {{ quick.icon }} me-1" aria-hidden="true"/>
                                <span t-esc="quick.label"/>
                            </button>
                        </t>
                        <button class="btn btn-sm btn-secondary" t-on-click="onRefresh"
                                t-att-disabled="state.refreshing" aria-label="Refresh the dashboard">
                            <i class="fa fa-refresh" t-att-class="{ 'fa-spin': state.refreshing }"
                               aria-hidden="true"/>
                            <span class="d-none d-md-inline ms-1">Refresh</span>
                        </button>
                    </div>
                </header>

                <AtmtaFilterBar t-if="isReady and (data.filters or []).length"
                                filters="data.filters" values="state.filters"
                                onChange="(key, value) => this.setFilter(key, value)"
                                onReset="() => this.resetFilters()"/>

                <AtmtaSkeleton t-if="isLoading" kpis="6" panels="3"/>

                <div t-elif="isError" class="o_ad_state" role="alert">
                    <i class="fa fa-exclamation-circle o_ad_state_icon" aria-hidden="true"/>
                    <h2 class="o_ad_state_title">The dashboard could not be loaded</h2>
                    <p class="o_ad_state_text" t-esc="state.errorMessage"/>
                    <button class="btn btn-primary" t-on-click="onRefresh">Retry</button>
                </div>

                <t t-else="">
                    <div class="o_ad_kpi_grid o_ad_section">
                        <AtmtaKpiCard t-foreach="data.kpis or []" t-as="tile" t-key="tile.key"
                                      tile="tile" currencyId="currencyId"
                                      onDrill="(key) => this.drill(key)"/>
                    </div>

                    <!-- Are we selling, and are we collecting. Two questions,
                         two series, deliberately side by side. -->
                    <div class="o_ad_grid o_ad_section">
                        <AtmtaCard className="'o_ad_col_3'" title="'Inventory'"
                                   icon="'fa-th'"
                                   subtitle="'Every unit in exactly one commercial state'">
                            <AtmtaDonut segments="inventory.segments"
                                        total="inventory.total"
                                        totalLabel="inventory.total_label"
                                        onSegment="(key) => this.drill(key)"/>
                        </AtmtaCard>

                        <AtmtaDashboardChart t-if="velocityChart" chart="velocityChart"
                                             currencyId="currencyId"/>
                        <AtmtaCard t-else="" className="'o_ad_col_5'"
                                   title="'Sales Velocity'" icon="'fa-line-chart'">
                            <AtmtaRowList rows="[]"
                                          emptyText="'No contract has been signed in the last six months.'"/>
                        </AtmtaCard>

                        <AtmtaDashboardChart t-if="collectionChart" chart="collectionChart"
                                             currencyId="currencyId"/>
                        <AtmtaCard t-else="" className="'o_ad_col_4'"
                                   title="'Scheduled vs Collected'" icon="'fa-credit-card'">
                            <AtmtaRowList rows="[]"
                                          emptyText="'No instalment has fallen due yet.'"/>
                        </AtmtaCard>
                    </div>

                    <div class="o_ad_grid o_ad_section">
                        <AtmtaCard className="'o_ad_col_6'" title="'Attention Required'"
                                   icon="'fa-exclamation-triangle'">
                            <AtmtaRowList rows="data.alerts or []"
                                          onRow="(key) => this.drill(key)"
                                          emptyText="'Nothing needs your attention.'"/>
                        </AtmtaCard>
                        <AtmtaCard className="'o_ad_col_6'" title="'My Work'"
                                   icon="'fa-check-square-o'">
                            <AtmtaRowList rows="data.work_queue or []"
                                          onRow="(key) => this.drill(key)"
                                          emptyText="'Your queue is clear.'"/>
                        </AtmtaCard>
                    </div>

                    <!-- ==== Where the projects are, and the pipeline ==== -->
                    <div class="o_ad_grid o_ad_section">
                        <AtmtaCard className="'o_ad_col_6'" title="'Project Locations'"
                                   icon="'fa-map-marker'"
                                   subtitle="'Plot boundaries where they are drawn, pins where they are not'">
                            <AtmtaMapCard points="mapData.points" legend="mapData.legend"
                                          onPoint="(point) => this.openMapProject(point)"
                                          emptyText="'No project has coordinates set.'"/>
                        </AtmtaCard>

                        <AtmtaCard className="'o_ad_col_2'" title="'Pipeline'"
                                   icon="'fa-filter'"
                                   subtitle="'Counts, not money'">
                            <AtmtaDonut segments="pipeline.segments"
                                        total="pipeline.total"
                                        totalLabel="pipeline.total_label"
                                        onSegment="(key) => this.drill(key)"/>
                        </AtmtaCard>

                        <AtmtaDashboardChart t-if="ageingChart" chart="ageingChart"
                                             currencyId="currencyId"/>
                        <AtmtaCard t-else="" className="'o_ad_col_4'"
                                   title="'Receivables Ageing'" icon="'fa-hourglass-half'">
                            <AtmtaRowList rows="[]"
                                          emptyText="'Nothing is overdue. Every invoiced instalment is settled.'"/>
                        </AtmtaCard>
                    </div>

                    <div class="o_ad_grid o_ad_section">
                        <AtmtaCard className="'o_ad_col_6'" title="'Price and Absorption by Unit Type'"
                                   icon="'fa-tags'"
                                   subtitle="'Forty apartments and eight shops are not the same business; the rate per sqm is where that shows'">
                            <AtmtaDataTable columns="priceColumns"
                                            rows="data.price_bands or []"
                                            currencyId="currencyId"
                                            emptyText="'No unit carries both an area and a price.'"/>
                        </AtmtaCard>
                        <AtmtaCard className="'o_ad_col_6'" title="'Upcoming Handovers'"
                                   icon="'fa-key'"
                                   subtitle="'Handing over a unit whose instalments are unpaid loses the only leverage there is'">
                            <AtmtaDataTable columns="handoverColumns"
                                            rows="data.handovers or []"
                                            currencyId="currencyId"
                                            emptyText="'No handover is due in the next twelve months.'"/>
                        </AtmtaCard>
                    </div>

                    <div class="o_ad_grid o_ad_section">
                        <AtmtaCard className="'o_ad_col_7'" title="'Project Performance'"
                                   icon="'fa-building'"
                                   subtitle="'Sell-through measures committed units against RELEASED stock, not total build'">
                            <AtmtaDataTable columns="projectColumns"
                                            rows="data.projects_table or []"
                                            currencyId="currencyId"
                                            onRow="(row) => this.openProject(row)"
                                            emptyText="'No project has released inventory yet.'"/>
                        </AtmtaCard>

                        <AtmtaCard className="'o_ad_col_5'" title="'Payment Plan Performance'"
                                   icon="'fa-calendar'"
                                   subtitle="'A plan that sells well and collects badly is the most expensive thing a developer can have'">
                            <AtmtaDataTable columns="planColumns"
                                            rows="data.plans_table or []"
                                            currencyId="currencyId"
                                            emptyText="'No payment plan carries a live contract yet.'"/>
                        </AtmtaCard>
                    </div>

                    <div class="o_ad_grid o_ad_section">
                        <AtmtaCard className="'o_ad_col_12'" title="'Buyer Concentration'"
                                   icon="'fa-users'"
                                   subtitle="'Where the exposure sits if one buyer stops paying'">
                            <AtmtaDataTable columns="buyerColumns"
                                            rows="data.top_buyers or []"
                                            currencyId="currencyId"
                                            emptyText="'No live contract yet.'"/>
                        </AtmtaCard>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
