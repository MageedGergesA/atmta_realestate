<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <!-- The project code sequence moved to `atmta_project_core`, which owns
         `realestate.project.create` and therefore has to be able to number a
         project without this application installed. -->

    <record id="seq_realestate_reservation" model="ir.sequence">
        <field name="name">Unit Reservation</field>
        <field name="code">realestate.unit.reservation</field>
        <field name="prefix">RES-</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_realestate_sale_contract" model="ir.sequence">
        <field name="name">Sale Contract</field>
        <field name="code">realestate.sale.contract</field>
        <field name="prefix">SC-</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_realestate_release_batch" model="ir.sequence">
        <field name="name">Unit Release Batch</field>
        <field name="code">realestate.unit.release.batch</field>
        <field name="prefix">REL-</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_commercial_approval_request" model="ir.sequence">
        <field name="name">Commercial Approval Request</field>
        <field name="code">realestate.commercial.approval.request</field>
        <field name="prefix">APR-</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_contract_amendment" model="ir.sequence">
        <field name="name">Sale Contract Amendment</field>
        <field name="code">realestate.sale.contract.amendment</field>
        <field name="prefix">AMD-</field>
        <field name="padding">5</field>
    </record>

</odoo>
