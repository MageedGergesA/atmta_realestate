    <!--
        Agent scoping (Phase 46, first step).

        A sales agent sees the deals they own; a manager sees everything in the
        company. This is a non-global rule on the agent group only, so it
        RESTRICTS agents without granting managers anything extra — non-global
        rules of different groups are OR-ed, and the manager group has its own
        permissive rule below.

        Project-level and team-level scoping need a project↔user assignment
        model that does not exist yet; that is Phase 46 proper.
    -->
    <record id="rule_reservation_agent_own" model="ir.rule">
        <field name="name">Reservation: agent sees own deals</field>
        <field name="model_id" ref="model_realestate_unit_reservation"/>
        <field name="domain_force">['|', ('agent_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_dev_agent'))]"/>
        <field name="global" eval="False"/>
    </record>

    <record id="rule_reservation_manager_all" model="ir.rule">
        <field name="name">Reservation: manager sees all</field>
        <field name="model_id" ref="model_realestate_unit_reservation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_dev_manager'))]"/>
        <field name="global" eval="False"/>
    </record>

    <record id="rule_sale_contract_agent_own" model="ir.rule">
