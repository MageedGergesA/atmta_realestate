    <!--
        Multi-company record rules.

        Before this file the module had ZERO ir.rule records, and no model in it
        carried a company_id, so there was nothing to isolate on: every user saw
        every company's projects, inventory, reservations and contracts.

        The pattern matches frozen Module 1: filter on company_id being in the
        user's allowed companies, and deliberately DO NOT admit
        company_id = False. A record with no company would otherwise be visible
        to everyone, which is exactly the leak this is here to close. Every
        model below has a required or related-stored company_id, so there are no
        company-less records to strand.
    -->

    <!--
        Project and Phase isolation moved to `atmta_project_core`
        (`security/project_core_rules.xml`), together with the `company_id`
        they filter on. A module that defines a model owns the boundary around
        it; this application keeps the rules for the Development models below,
        which are genuinely its own.
    -->

    <record id="rule_release_batch_company" model="ir.rule">
        <field name="name">Release Batch: multi-company</field>
        <field name="model_id" ref="model_realestate_unit_release_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

