<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <record id="module_category_real_estate_dev" model="ir.module.category">
        <field name="name">Real Estate Developer</field>
        <field name="sequence">22</field>
    </record>

    <record id="group_dev_readonly" model="res.groups">
        <field name="name">Read-only</field>
        <field name="category_id" ref="module_category_real_estate_dev"/>
    </record>

    <record id="group_dev_agent" model="res.groups">
        <field name="name">Sales Agent</field>
        <field name="category_id" ref="module_category_real_estate_dev"/>
        <field name="implied_ids" eval="[(4, ref('group_dev_readonly'))]"/>
    </record>

    <record id="group_dev_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_real_estate_dev"/>
        <field name="implied_ids" eval="[(4, ref('group_dev_agent'))]"/>
    </record>

</odoo>
