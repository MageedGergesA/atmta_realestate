<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <record id="module_category_real_estate_dev" model="ir.module.category">
        <field name="name">Real Estate Developer</field>
        <field name="sequence">22</field>
    </record>

    <record id="group_dev_readonly" model="res.groups">
        <field name="name">Read-only</field>
        <field name="category_id" ref="module_category_real_estate_dev"/>
    </record>

    <record id="group_dev_agent" model="res.groups">
        <field name="name">Sales Agent</field>
        <field name="category_id" ref="module_category_real_estate_dev"/>
        <field name="implied_ids" eval="[(4, ref('group_dev_readonly'))]"/>
    </record>

    <!--
        Sales Manager sits between the agent and the commercial manager: they
        run a team's deals and approve within their authority, but pricing and
        payment plans are not theirs to change.
    -->
    <record id="group_dev_sales_manager" model="res.groups">
        <field name="name">Sales Manager</field>
        <field name="category_id" ref="module_category_real_estate_dev"/>
        <field name="implied_ids" eval="[(4, ref('group_dev_agent'))]"/>
    </record>

    <!--
        Commercial Manager owns the masters: price books, payment plans,
        promotions and the discount authority matrix. Deliberately separate
        from deal-making authority — the person setting the discount ceiling
        should not be the person selling against it.
    -->
    <record id="group_dev_commercial_manager" model="res.groups">
        <field name="name">Commercial Manager</field>
        <field name="category_id" ref="module_category_real_estate_dev"/>
        <field name="implied_ids" eval="[(4, ref('group_dev_sales_manager'))]"/>
    </record>

    <record id="group_dev_manager" model="res.groups">
        <field name="name">Developer Manager</field>
        <field name="category_id" ref="module_category_real_estate_dev"/>
        <field name="implied_ids" eval="[(4, ref('group_dev_commercial_manager'))]"/>
    </record>

</odoo>
