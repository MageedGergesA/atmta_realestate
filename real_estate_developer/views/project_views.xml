<?xml version="1.0" encoding="UTF-8"?>
<!--
  What the developer application adds to the project screens.

  The base views moved to `atmta_project_core`, the module that owns
  `realestate.project`, so Construction, Procurement, Maquette and Plan no
  longer inherit from the developer application just to add a tab.

  What stays here needs this module. The unit counts, `stock_location_id` and
  the two navigators are defined in `models/project_developer.py`; the Plot
  Boundary page uses `boundary_picker`, a widget from this module's asset
  bundle, which is why the page cannot live in core even though
  `boundary_point_ids` is a core field.

  The Projects action stays here too: `atmta_executive_app` and
  `atmta_development_app` reference `real_estate_developer.action_realestate_project`
  by name.

  `real_estate_plan.view_project_form_boundary_overlay` injects the 2D master
  plan inside the Plot Boundary page, so it keeps inheriting this view rather
  than the core one.
-->
<odoo>

    <record id="view_project_kanban_developer" model="ir.ui.view">
        <field name="name">realestate.project.kanban.developer</field>
        <field name="model">realestate.project</field>
        <field name="inherit_id" ref="atmta_project_core.view_project_kanban"/>
        <field name="arch" type="xml">
            <!-- The kanban declares its fields directly under <kanban>; the
                 same name also appears inside the card template, so this is
                 scoped to the declaration rather than left to document order. -->
            <xpath expr="//kanban/field[@name='project_type']" position="after">
                <field name="unit_count"/>
                <field name="sold_unit_count"/>
                <field name="available_unit_count"/>
            </xpath>
            <xpath expr="//div[@name='kanban_counts']" position="inside">
                <span><i class="fa fa-home me-1"/><field name="unit_count"/> units</span>
                <span class="ms-2 text-success">· <field name="sold_unit_count"/> sold</span>
                <span class="ms-2 text-info">· <field name="available_unit_count"/> avail</span>
            </xpath>
        </field>
    </record>

    <record id="view_project_list_developer" model="ir.ui.view">
        <field name="name">realestate.project.list.developer</field>
        <field name="model">realestate.project</field>
        <field name="inherit_id" ref="atmta_project_core.view_project_list"/>
        <field name="arch" type="xml">
            <field name="city" position="after">
                <field name="unit_count"/>
                <field name="sold_unit_count"/>
                <field name="available_unit_count"/>
            </field>
        </field>
    </record>

    <record id="view_project_form_developer" model="ir.ui.view">
        <field name="name">realestate.project.form.developer</field>
        <field name="model">realestate.project</field>
        <field name="inherit_id" ref="atmta_project_core.view_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_units" type="object" class="oe_stat_button" icon="fa-home">
                    <field name="unit_count" widget="statinfo" string="Units"/>
                </button>
                <button name="action_view_stock" type="object" class="oe_stat_button"
                        icon="fa-cubes" string="Stock" invisible="not stock_location_id"/>
                <field name="stock_location_id" invisible="1"/>
            </xpath>

            <!-- The Plot Boundary page goes before Phases, where it was. -->
            <xpath expr="//page[@name='phases']" position="before">
                <page string="Plot Boundary" name="plot_boundary">
                    <field name="boundary_point_ids" widget="boundary_picker" nolabel="1"/>
                </page>
            </xpath>

            <xpath expr="//page[@name='phases']//field[@name='expected_delivery_date']" position="after">
                <field name="unit_count"/>
                <field name="sold_unit_count"/>
            </xpath>

            <xpath expr="//page[@name='phases']" position="after">
                <page string="Inventory Summary" name="inventory_summary">
                    <group>
                        <group>
                            <field name="unit_count" readonly="1"/>
                            <field name="available_unit_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="reserved_unit_count" readonly="1"/>
                            <field name="sold_unit_count" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_realestate_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">realestate.project</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
