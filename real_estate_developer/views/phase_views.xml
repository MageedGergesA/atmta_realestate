<?xml version="1.0" encoding="UTF-8"?>
<!--
  What the developer application adds to the phase screens.

  The base views moved to `atmta_project_core`. What stays here needs this
  module: `unit_count` and `sold_unit_count` are defined in
  `models/project_developer.py`, and the Units page lists `base_price`, which
  `models/property_developer.py` puts on the property.

  The Phases action stays here: `atmta_development_app` references
  `real_estate_developer.action_realestate_phase` by name.
-->
<odoo>

    <record id="view_phase_list_developer" model="ir.ui.view">
        <field name="name">realestate.phase.list.developer</field>
        <field name="model">realestate.phase</field>
        <field name="inherit_id" ref="atmta_project_core.view_phase_list"/>
        <field name="arch" type="xml">
            <field name="expected_delivery_date" position="after">
                <field name="unit_count"/>
                <field name="sold_unit_count"/>
            </field>
        </field>
    </record>

    <record id="view_phase_form_developer" model="ir.ui.view">
        <field name="name">realestate.phase.form.developer</field>
        <field name="model">realestate.phase</field>
        <field name="inherit_id" ref="atmta_project_core.view_phase_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_units" type="object" class="oe_stat_button" icon="fa-home">
                    <field name="unit_count" widget="statinfo" string="Units"/>
                </button>
            </xpath>

            <!-- Units first, as it was, with Description after it. -->
            <xpath expr="//notebook" position="inside">
                <page string="Units" name="units">
                    <field name="property_ids" context="{'default_phase_id': id, 'default_project_id': project_id}" readonly="1">
                        <list>
                            <field name="property_code"/>
                            <field name="name"/>
                            <field name="hierarchy_level"/>
                            <field name="base_price"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_realestate_phase" model="ir.actions.act_window">
        <field name="name">Phases</field>
        <field name="res_model">realestate.phase</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
