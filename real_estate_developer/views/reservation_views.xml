<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_reservation_list" model="ir.ui.view">
        <field name="name">realestate.unit.reservation.list</field>
        <field name="model">realestate.unit.reservation</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'hold'"
                  decoration-success="state in ('booked','confirmed')"
                  decoration-muted="state in ('expired','cancelled')">
                <field name="name"/>
                <field name="property_id"/>
                <field name="partner_id"/>
                <field name="agent_id"/>
                <field name="hold_started_at"/>
                <field name="hold_expiry_at"/>
                <field name="booking_fee"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_reservation_form" model="ir.ui.view">
        <field name="name">realestate.unit.reservation.form</field>
        <field name="model">realestate.unit.reservation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm_booking" type="object" string="Confirm Booking"
                            class="oe_highlight" invisible="state != 'hold'"/>
                    <button name="action_extend_hold" type="object" string="Extend Hold +24h"
                            invisible="state != 'hold'"/>
                    <button name="action_create_sale_contract" type="object" string="Create Sale Contract"
                            class="oe_highlight" invisible="state != 'booked'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('confirmed','cancelled','expired')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="hold,booked,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_id" options="{'no_create': True}"/>
                            <field name="project_id" readonly="1"/>
                            <field name="phase_id" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="agent_id"/>
                        </group>
                        <group>
                            <field name="hold_started_at"/>
                            <field name="hold_duration_hours"/>
                            <field name="hold_expiry_at" readonly="1"/>
                            <field name="booking_fee"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <group string="Sale Terms">
                        <group>
                            <field name="proposed_price"/>
                            <field name="property_base_price" widget="monetary"/>
                            <field name="proposed_vs_base" widget="percentage"
                                   decoration-success="proposed_vs_base &gt;= 0"
                                   decoration-warning="proposed_vs_base &gt;= -0.05 and proposed_vs_base &lt; 0"
                                   decoration-danger="proposed_vs_base &lt; -0.05"/>
                        </group>
                        <group>
                            <field name="payment_term_id" options="{'no_create': True}"/>
                            <field name="sale_contract_id" readonly="1" invisible="not sale_contract_id"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_unit_reservation" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">realestate.unit.reservation</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
