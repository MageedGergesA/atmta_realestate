<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_payment_term_form_realestate" model="ir.ui.view">
        <field name="name">account.payment.term.form.realestate</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <!-- Full-width builder, placed above the Due Terms / Preview row. -->
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group string="Real Estate Schedule Builder">
                    <field name="re_is_realestate" invisible="1"/>
                    <field name="re_segment_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="pct_mode"/>
                            <field name="value_pct" string="% each"
                                   readonly="pct_mode == 'remainder'"/>
                            <field name="occurrences"/>
                            <field name="interval"/>
                            <field name="anchor"/>
                            <field name="offset_value"/>
                            <field name="offset_unit"/>
                        </list>
                    </field>
                    <div colspan="2" class="d-flex align-items-center gap-3 mt-2">
                        <button name="action_re_generate_lines" type="object"
                                string="Generate Schedule" class="btn-primary"
                                confirm="This rebuilds the term's lines from the segments above. Continue?"/>
                        <span class="text-muted">
                            Fixed % in segments:
                            <field name="re_total_pct" class="oe_inline" nolabel="1" readonly="1"/>%
                            — add a “Remainder” segment to cover the rest up to 100%.
                        </span>
                    </div>
                </group>

                <!-- Discount -->
                <group string="Discount">
                    <group>
                        <field name="re_discount_enabled"/>
                        <field name="re_discount_type"
                               invisible="not re_discount_enabled"/>
                        <field name="re_discount_value"
                               invisible="not re_discount_enabled"/>
                        <field name="re_discount_label"
                               invisible="not re_discount_enabled"/>
                    </group>
                    <group>
                        <div class="text-muted small" invisible="not re_discount_enabled">
                            Subtracted from the sale order before invoicing —
                            a single negative line is added with this label.
                            Percent is computed against the unit's sale price.
                        </div>
                    </group>
                </group>

                <!-- Maintenance -->
                <group string="Maintenance">
                    <group>
                        <field name="re_maintenance_enabled"/>
                        <field name="re_maintenance_product_id"
                               invisible="not re_maintenance_enabled"
                               options="{'no_create_edit': True}"/>
                        <field name="re_maintenance_period"
                               invisible="not re_maintenance_enabled"/>
                        <field name="re_maintenance_periods"
                               invisible="not re_maintenance_enabled or re_maintenance_period == 'one_time'"/>
                    </group>
                    <group>
                        <field name="re_maintenance_amount_type"
                               invisible="not re_maintenance_enabled"/>
                        <field name="re_maintenance_amount"
                               invisible="not re_maintenance_enabled or re_maintenance_amount_type != 'fixed'"/>
                        <field name="re_maintenance_pct"
                               invisible="not re_maintenance_enabled or re_maintenance_amount_type != 'percent'"/>
                        <div class="text-muted small" invisible="not re_maintenance_enabled">
                            One sale-order line is appended per period
                            (e.g. 3 annual periods → 3 lines). They share the
                            payment-term schedule with the unit price.
                        </div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
