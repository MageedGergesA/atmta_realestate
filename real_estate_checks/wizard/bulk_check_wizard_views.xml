<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_bulk_check_wizard_form" model="ir.ui.view">
        <field name="name">realestate.check.bulk.wizard.form</field>
        <field name="model">realestate.check.bulk.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk-Create Checks from Installments">
                <sheet>
                    <group>
                        <group string="Contract">
                            <field name="sale_contract_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Chequebook">
                            <field name="bank_id"/>
                            <field name="branch"/>
                            <field name="account_number"/>
                            <field name="partner_bank_id"/>
                            <field name="first_check_number"
                                   placeholder="e.g. 000012345"/>
                            <field name="issue_date"/>
                            <field name="journal_id"/>
                            <field name="location_id"/>
                            <field name="skip_existing"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status">
                        The number format is preserved exactly as typed — leading zeros
                        included. <code>000012345</code> generates
                        <code>000012346</code>, <code>000012347</code>, …
                    </div>
                    <notebook>
                        <page string="Instalments">
                            <field name="installment_ids">
                                <list>
                                    <field name="sequence" optional="hide"/>
                                    <field name="date_due"/>
                                    <field name="kind"/>
                                    <field name="current_amount"/>
                                    <field name="paid_amount" optional="show"/>
                                    <field name="secured_by_checks_amount"
                                           string="Already Secured"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Preview" invisible="not preview_line_ids">
                            <field name="preview_line_ids" readonly="1">
                                <list>
                                    <field name="check_number"/>
                                    <field name="installment_id"/>
                                    <field name="due_date"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="note" optional="show"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_preview" type="object" string="Preview"/>
                    <button name="action_generate" type="object" string="Generate Checks"
                            class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
