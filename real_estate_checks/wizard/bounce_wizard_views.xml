<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_bounce_wizard_form" model="ir.ui.view">
        <field name="name">realestate.check.bounce.wizard.form</field>
        <field name="model">realestate.check.bounce.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Check Bounce">
                <sheet>
                    <group>
                        <group string="Instrument">
                            <field name="check_id" readonly="1"/>
                            <field name="presentation_id" readonly="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Bank Return">
                            <field name="reason"/>
                            <field name="bounce_date"/>
                            <field name="bank_reference"/>
                            <field name="returned_document"
                                   filename="returned_document_name"/>
                            <field name="returned_document_name" invisible="1"/>
                        </group>
                        <group string="Cost to Us">
                            <field name="bank_charge_amount"/>
                        </group>
                        <group string="Charge to Customer">
                            <field name="penalty_amount"/>
                        </group>
                    </group>
                    <!--
                        What the ledger will do, stated before it does it.
                        0.1 offered an "Issue Penalty Invoice Now" tickbox here
                        and said nothing about the accounting at all.
                    -->
                    <separator string="Accounting effect"/>
                    <field name="needs_manual_accounting" invisible="1"/>
                    <div class="alert alert-danger" role="alert"
                         invisible="not needs_manual_accounting">
                        <field name="accounting_preview" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-secondary" role="status"
                         invisible="needs_manual_accounting">
                        <field name="accounting_preview" readonly="1" nolabel="1"/>
                    </div>
                    <field name="notes" placeholder="Reason detail..."/>
                </sheet>
                <footer>
                    <button name="action_register_bounce" type="object" string="Register Bounce"
                            class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_custody_wizard_form" model="ir.ui.view">
        <field name="name">realestate.check.custody.wizard.form</field>
        <field name="model">realestate.check.custody.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer Custody">
                <sheet>
                    <group>
                        <group>
                            <field name="check_count"/>
                            <field name="total_amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="to_custodian_id"/>
                            <field name="to_location_id"/>
                            <field name="reason"/>
                            <field name="date"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Why the paper moved..."/>
                    <field name="check_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="check_number"/>
                            <field name="partner_id"/>
                            <field name="amount"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="custodian_id"/>
                            <field name="location_id"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_transfer" type="object" string="Transfer"
                            class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_open_custody_wizard" model="ir.actions.act_window">
        <field name="name">Transfer Custody</field>
        <field name="res_model">realestate.check.custody.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_realestate_check"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('real_estate_checks.group_checks_treasurer'))]"/>
    </record>

    <record id="view_replace_wizard_form" model="ir.ui.view">
        <field name="name">realestate.check.replace.wizard.form</field>
        <field name="model">realestate.check.replace.wizard</field>
        <field name="arch" type="xml">
            <form string="Replace Cheque">
                <sheet>
                    <group>
                        <group string="Being Replaced">
                            <field name="original_check_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="original_amount" readonly="1"/>
                            <field name="original_state" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="bounce_id" invisible="1"/>
                        </group>
                        <group string="Replacement">
                            <field name="new_partner_id"/>
                            <field name="check_number"/>
                            <field name="bank_id"/>
                            <field name="branch"/>
                            <field name="account_number"/>
                            <field name="amount"/>
                            <field name="issue_date"/>
                            <field name="due_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="carry_allocations"/>
                        <field name="return_original"/>
                    </group>
                    <div class="alert alert-info" role="status"
                         invisible="not carry_allocations">
                        Allocations are <b>moved</b>, not copied: the original's are
                        cancelled as the replacement's are raised, so the obligation
                        stays covered exactly once.
                    </div>
                    <field name="notes"/>
                </sheet>
                <footer>
                    <button name="action_replace" type="object" string="Create Replacement"
                            class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_allocate_wizard_form" model="ir.ui.view">
        <field name="name">realestate.check.allocate.wizard.form</field>
        <field name="model">realestate.check.allocate.wizard</field>
        <field name="arch" type="xml">
            <form string="Allocate Cheque">
                <sheet>
                    <group>
                        <group>
                            <field name="check_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="check_amount" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="already_allocated" readonly="1"/>
                            <field name="available_amount" readonly="1"/>
                            <field name="to_allocate" readonly="1"/>
                            <field name="remaining" readonly="1"
                                   decoration-danger="remaining &lt; 0"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status">
                        Allocating says what this cheque is <b>meant</b> to pay. No money
                        moves and no obligation is settled — that happens when the cheque
                        clears and Odoo reconciles it.
                    </div>
                    <field name="line_ids">
                        <list editable="bottom" create="false">
                            <field name="selected" widget="boolean_toggle"/>
                            <field name="description" readonly="1"/>
                            <field name="due_date" readonly="1"/>
                            <field name="outstanding_amount" readonly="1"
                                   string="Unsecured"/>
                            <field name="allocate_amount" sum="To Allocate"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="sale_installment_id" column_invisible="1"/>
                            <field name="rental_payment_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_allocate" type="object" string="Allocate"
                            class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
