#. module: real_estate_checks
#. odoo-python
#: code:addons/real_estate_checks/models/check_exposure.py:0
msgid ""
"\n"
"… and %s more."
msgstr ""
"\n"
"… و%s أخرى."

#. module: real_estate_checks
#. odoo-python
#: code:addons/real_estate_checks/models/check_dashboard.py:0
msgid "%(bounced)s of %(presented)s presented"
msgstr "%(bounced)s من %(presented)s مقدمة"

#. module: real_estate_checks
#. odoo-python
#: code:addons/real_estate_checks/models/deposit.py:0
msgid "%(check)s already has an open presentation at a bank."
msgstr "الشيك %(check)s لديه بالفعل تقديم مفتوح لدى بنك."

#. module: real_estate_checks
#. odoo-python
#: code:addons/real_estate_checks/models/deposit.py:0
msgid "%(check)s belongs to %(other)s, not %(own)s."
msgstr "الشيك %(check)s يتبع %(other)s وليس %(own)s."

#. module: real_estate_checks
#. odoo-python
#: code:addons/real_estate_checks/models/deposit.py:0
msgid ""
"%(check)s has %(amount)s unallocated, and this company requires full "
"allocation before deposit."
msgstr ""
"الشيك %(check)s به مبلغ %(amount)s غير موزع، وهذه الشركة تشترط التوزيع "
"الكامل قبل الإيداع."

#. module: real_estate_checks
#. odoo-python
#: code:addons/real_estate_checks/models/deposit.py:0
msgid "%(check)s is '%(state)s'; only a registered cheque can be presented."
msgstr "الشيك %(check)s في حالة '%(state)s'؛ لا يمكن تقديم إلا الشيك المسجل."

#. module: real_estate_checks
#. odoo-python
#: code:addons/real_estate_checks/models/deposit.py:0
msgid ""
"%(check)s is in %(their)s; this slip is in %(ours)s. Mixed-currency batches "
"are not grouped — make one slip per currency."
msgstr ""
"الشيك %(check)s بعملة %(their)s؛ وهذا الإيصال بعملة %(ours)s. لا تُجمع "
"الدفعات متعددة العملات — أنشئ إيصالًا واحدًا لكل عملة."

#. module: real_estate_checks
#. odoo-python
#: code:addons/real_estate_checks/models/deposit.py:0
msgid ""
"%(check)s matured on %(due)s and is past this company's cheque validity "
"period. Presenting a stale instrument is a decision for Treasury, not an "
"automatic one."
msgstr ""
"استحق الشيك %(check)s في %(due)s وتجاوز مدة صلاحية الشيكات لدى هذه الشركة. "
"تقديم أداة منتهية الصلاحية قرار يعود للخزينة، وليس إجراءً تلقائيًا."

#. module: real_estate_checks
#. odoo-python
#: code:addons/real_estate_checks/models/deposit.py:0
msgid ""
"%(check)s matures on %(due)s — %(early)s days early, and this company allows"
" at most %(window)s."
msgstr ""
"يستحق الشيك %(check)s في %(due)s — أي قبل موعده بـ %(early)s يومًا، وهذه "
"الشركة تسمح بحد أقصى %(window)s."

#. module: real_estate_checks
#. odoo-python
#: code:addons/real_estate_checks/models/deposit.py:0
msgid ""
"%(check)s matures on %(due)s. This company does not allow presenting a post-"
"dated cheque early."
msgstr ""
"يستحق الشيك %(check)s في %(due)s. هذه الشركة لا تسمح بتقديم الشيك المؤجل قبل"
" موعده."

#. module: real_estate_checks
#. odoo-python
#: code:addons/real_estate_checks/models/check_exposure.py:0
msgid "%(count)s bounced cheque(s) totalling %(total)s have no resolution."
msgstr "%(count)s شيك (شيكات) مرتجعة بإجمالي %(total)s ليس لها معالجة."

#. module: real_estate_checks
#. odoo-python
#: code:addons/real_estate_checks/wizard/custody_wizard.py:0
msgid ""
"%(count)s cheque(s) are at the bank and are not in your custody to move: "
"%(refs)s"
msgstr "%(count)s شيك (شيكات) لدى البنك وليست في عهدتك لنقلها: %(refs)s"

#. module: real_estate_checks
#. odoo-python
#: code:addons/real_estate_checks/wizard/bulk_check_wizard.py:0
msgid ""
"%(count)s cheque(s) registered, %(total)s face value, numbers "
"%(first)s–%(last)s. Cheques received — not money received."
msgstr ""
"تم تسجيل %(count)s شيك (شيكات)، بقيمة اسمية %(total)s، الأرقام "
"%(first)s–%(last)s. استلام شيكات — وليس استلام أموال."

#. module: real_estate_checks
#. odoo-python
#: code:addons/real_estate_checks/models/check_exposure.py:0
msgid ""
"%(count)s cheque(s) totalling %(total)s are at the bank and their outcome is"
" unknown."
msgstr ""
"%(count)s شيك (شيكات) بإجمالي %(total)s لدى البنك ونتيجتها غير معروفة."

#. module: real_estate_checks
#. odoo-python
#: code:addons/real_estate_checks/models/check_exposure.py:0
msgid ""
"%(count)s cheque(s) totalling %(total)s are physically held and must be "
"returned to the customer or cancelled."
msgstr ""
"%(count)s شيك (شيكات) بإجمالي %(total)s محتجزة فعليًا ويجب إعادتها إلى "
"العميل أو إلغاؤها."

#. module: real_estate_checks
#. odoo-python
#: code:addons/real_estate_checks/models/check_exposure.py:0
msgid ""
"%(count)s post-dated cheque(s) totalling %(total)s are still held against this contract and are now unallocated by the settlement. Return or cancel them before closing:\n"
"%(list)s"
msgstr ""
"%(count)s شيك (شيكات) مؤجلة بإجمالي %(total)s لا تزال محتجزة مقابل هذا العقد وأصبحت غير موزعة بسبب التسوية. أعدها أو ألغها قبل الإغلاق:\n"
"%(list)s"

#. module: real_estate_checks
#. odoo-python
#: code:addons/real_estate_checks/models/check_exposure.py:0
msgid ""
"%(count)s uncashed cheque(s) totalling %(total)s are still drawn by %(old)s and remain linked to this contract. Their drawer has deliberately NOT been rewritten — historical instrument ownership is a fact.\n"
"\n"
"Treasury must return them to %(old)s and collect replacement cheques from %(new)s:\n"
"%(list)s"
msgstr ""
"%(count)s شيك (شيكات) غير محصلة بإجمالي %(total)s لا تزال مسحوبة من %(old)s ومرتبطة بهذا العقد. لم يُعدَّل ساحبها عمدًا — فملكية الأداة التاريخية حقيقة ثابتة.\n"
"\n"
"يجب على الخزينة إعادتها إلى %(old)s وتحصيل شيكات بديلة من %(new)s:\n"
"%(list)s"

#. module: real_estate_checks
#. odoo-python
#: code:addons/real_estate_checks/models/check_exposure.py:0
msgid ""
"%(operation)s cannot complete while physical cheque exposure is unresolved:\n"
"\n"
"%(list)s\n"
"\n"
"Cleared cheques are historical payment and stay as they are. Everything else has to be settled in Treasury first — use 'Return to Customer' or 'Cancel' on each instrument."
msgstr ""
"لا يمكن إتمام %(operation)s ما دامت مخاطر الشيكات الفعلية غير محسومة:\n"
"\n"
"%(list)s\n"
"\n"
"الشيكات المحصلة دفعات تاريخية وتبقى كما هي. كل ما عدا ذلك يجب تسويته في الخزينة أولًا — استخدم 'إعادة إلى العميل' أو 'إلغاء' على كل أداة."

#. module: real_estate_checks
#. odoo-python
#: code:addons/real_estate_checks/models/check_exposure.py:0
msgid ""
"%(operation)s cannot proceed on contract %(contract)s: %(count)s cheque(s) totalling %(total)s are at the bank or unresolved after a bounce.\n"
"\n"
"%(list)s%(more)s\n"
"\n"
"Resolve them in Treasury first — wait for clearance, record the bounce, or authorise a replacement. Restructuring underneath a presented cheque would corrupt a financial instrument."
msgstr ""
"لا يمكن متابعة %(operation)s على العقد %(contract)s: %(count)s شيك (شيكات) بإجمالي %(total)s لدى البنك أو غير محسومة بعد الارتجاع.\n"
"\n"
"%(list)s%(more)s\n"
"\n"
"عالجها في الخزينة أولًا — انتظر التحصيل، أو سجّل الارتجاع، أو اعتمد شيكًا بديلًا. إعادة الهيكلة مع وجود شيك مقدم للبنك ستُفسد أداة مالية."

#. module: real_estate_checks
#: model:ir.actions.report,print_report_name:real_estate_checks.action_report_deposit_slip
msgid "'Deposit Slip - %s' % (object.name)"
msgstr "'إيصال إيداع - %s' % (object.name)"

#. module: real_estate_checks
#: model:ir.actions.report,print_report_name:real_estate_checks.action_report_pdc_acknowledgement
msgid "'PDC Acknowledgement - %s' % (object.name)"
