#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/material_request_sourcing.py:0
msgid ""
"%(count)s request(s) for quotation prepared: %(vendors)s. Nothing is "
"committed until an order is confirmed."
msgstr ""
"تم تجهيز %(count)s طلب عرض سعر: %(vendors)s. لا يلتزم بشيء حتى يتم تأكيد "
"أمر."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_event.py:0
msgid ""
"%(line)s has %(remaining)s left to source and this event asks for %(asked)s."
" Sourcing the same demand twice would put one requirement in two tenders."
msgstr ""
"المتبقي للطرح في %(line)s هو %(remaining)s وهذه المناقصة تطلب %(asked)s. طرح"
" الطلب نفسه مرتين سيضع احتياجًا واحدًا في مناقصتين."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_clarification.py:0
msgid ""
"%(name)s changes %(subject)s. Vendors priced the current version, so this "
"goes out as an addendum — issue one from the tender and the clarification "
"will be attached to it. Answering in text would move the basis without "
"telling anybody it moved."
msgstr ""
"%(name)s يغير %(subject)s. سعر الموردون النسخة الحالية، لذا يصدر هذا كملحق —"
" أصدر ملحقًا من المناقصة وسيرفق الاستيضاح به. الإجابة نصيًا ستغير الأساس دون"
" إبلاغ أحد بتغيره."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/bid_response.py:0
msgid ""
"%(name)s is what %(vendor)s submitted at %(when)s. It cannot be edited — "
"record a revision instead, so that both what was offered and what replaced "
"it survive."
msgstr ""
"%(name)s هو ما قدمه %(vendor)s في %(when)s. لا يمكن تعديله — سجل مراجعة "
"بدلًا من ذلك، ليبقى ما تم تقديمه وما حل محله معًا."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/bid_response.py:0
msgid ""
"%(user)s recorded this submission. Approving your own late exception is off "
"by default — the point of the exception is that somebody else agreed."
msgstr ""
"سجل %(user)s هذا التقديم. اعتماد استثناء التأخير الخاص بك معطل افتراضيًا — "
"فالغاية من الاستثناء أن يوافق عليه شخص آخر."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_invitation.py:0
msgid ""
"%(vendor)s cannot be invited to %(event)s.\n"
"\n"
"%(why)s\n"
"\n"
"Vendor qualification policy is %(policy)s. Lift the restriction or qualify the vendor — an invitation is a governance act, not a convenience."
msgstr ""
"لا يمكن دعوة %(vendor)s إلى %(event)s.\n"
"\n"
"%(why)s\n"
"\n"
"سياسة تأهيل الموردين هي %(policy)s. ارفع القيد أو أهل المورد — فالدعوة إجراء حوكمة وليست تسهيلًا."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_event.py:0
msgid "%s belongs to another company."
msgstr "%s يتبع شركة أخرى."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_event.py:0
msgid ""
"%s consumes no authorised demand. A tender with no approved requisition "
"behind it has no authority."
msgstr ""
"%s لا يستهلك أي طلب معتمد. المناقصة التي لا يسندها طلب شراء معتمد لا صلاحية "
"لها."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/bid_response.py:0
msgid ""
"%s declined this tender. Recording a bid for them would contradict their own"
" answer."
msgstr "رفض %s هذه المناقصة. تسجيل عطاء له سيناقض إجابته."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/bid_response.py:0
msgid "%s has no RFQ to take a submission from."
msgstr "لا يوجد لدى %s طلب عرض سعر لاستلام تقديم منه."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_invitation.py:0
msgid "%s has no scope, so there is nothing to ask a vendor to quote."
msgstr "لا يوجد نطاق في %s، فلا يوجد ما يطلب من المورد تسعيره."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_event.py:0
msgid ""
"%s has no scope. Publishing an empty tender asks vendors to quote nothing."
msgstr "لا يوجد نطاق في %s. نشر مناقصة فارغة يطلب من الموردين تسعير لا شيء."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_event.py:0
msgid "%s has nothing left to source."
msgstr "لم يتبق شيء للطرح في %s."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_event.py:0
msgid ""
"%s is %s. Inviting a vendor now would be inviting them to something that is "
"over."
msgstr "%s حالتها %s. دعوة مورد الآن تعني دعوته إلى شيء انتهى."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_event.py:0
msgid "%s is already invited to %s."
msgstr "%s مدعو بالفعل إلى %s."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_event.py:0
msgid "%s is already published or closed."
msgstr "%s منشورة أو مغلقة بالفعل."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_event.py:0
msgid "%s is cancelled."
msgstr "%s ملغاة."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_event.py:0
msgid "%s is demand for %s, and this event sources %s."
msgstr "%s طلب خاص بـ %s، وهذه المناقصة تطرح %s."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_event.py:0
msgid "%s is not approved demand, so it cannot authorise a tender."
msgstr "%s ليس طلبًا معتمدًا، لذا لا يمكنه تفويض مناقصة."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_invitation.py:0
msgid "%s is not published yet."
msgstr "%s غير منشورة بعد."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/bid_response.py:0
msgid "%s is not published, so nothing can be submitted against it."
msgstr "%s غير منشورة، لذا لا يمكن تقديم أي شيء عليها."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_event.py:0
msgid ""
"%s is published. Its basis changes by addendum, so that vendors are told "
"what changed and when."
msgstr "%s منشورة. يتغير أساسها بملحق، ليبلغ الموردون بما تغير ومتى."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/bid_response.py:0
msgid ""
"%s is submitted evidence. Withdraw it — deleting it would make the tender "
"file unexplainable."
msgstr "%s دليل مقدم. اسحبه — فحذفه سيجعل ملف المناقصة غير قابل للتفسير."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/bid_response.py:0
msgid "%s was not late."
msgstr "%s لم يكن متأخرًا."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_invitation.py:0
msgid "- Not eligible (%s)."
msgstr "- غير مؤهل (%s)."

#. module: atmta_procurement_sourcing
#: model:ir.model.constraint,message:atmta_procurement_sourcing.constraint_realestate_procurement_bid_response_revision_uniq
msgid "A bid revision number is used once per invitation."
msgstr "رقم مراجعة العطاء يستخدم مرة واحدة لكل دعوة."

#. module: atmta_procurement_sourcing
#: model:ir.model.fields,help:atmta_procurement_sourcing.field_realestate_procurement_sourcing_event__award_readiness
msgid ""
"A description of where this tender stands on awarding, written by the M7 "
"upgrade. It confers nothing: a tender with a finished evaluation is labelled"
" as awaiting a decision, never given one."
msgstr ""
"وصف لموقف هذه المناقصة من الترسية، كتبته ترقية M7. لا يمنح شيئًا: المناقصة "
"ذات التقييم المكتمل توصف بأنها بانتظار قرار، ولا يتخذ لها قرار."

#. module: atmta_procurement_sourcing
#: model:ir.model.fields,help:atmta_procurement_sourcing.field_realestate_procurement_sourcing_event__evaluation_readiness
msgid ""
"A description of where this tender stands, written by the M6 upgrade. It is "
"not an evaluation and confers no result: a closed tender is labelled as "
"awaiting one, never given one."
msgstr ""
"وصف لموقف هذه المناقصة، كتبته ترقية M6. ليس تقييمًا ولا يمنح نتيجة: المناقصة"
" المغلقة توصف بأنها بانتظار التقييم، ولا تمنح نتيجة."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_audit.py:0
msgid "A late bid carries no record of the policy applied to it."
msgstr "العطاء المتأخر لا يحمل سجلًا بالسياسة المطبقة عليه."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_audit.py:0
msgid "A published tender still has a draft version attached."
msgstr "مناقصة منشورة لا تزال مرتبطة بنسخة مسودة."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_audit.py:0
msgid "A received bid answers a superseded tender version."
msgstr "عطاء مستلم يجيب على نسخة مناقصة تم استبدالها."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_audit.py:0
msgid "A response is held against an addendum nobody acknowledged."
msgstr "رد محتجز على ملحق لم يقر أحد باستلامه."

#. module: atmta_procurement_sourcing
#: model_terms:ir.actions.act_window,help:atmta_procurement_sourcing.action_sourcing_event
msgid ""
"A sourcing event invites vendors, issues a tender and records what\n"
"               they submitted. It moves no money: authorisation stays where M3 put\n"
"               it until an award is made."
msgstr ""
"المناقصة تدعو الموردين وتصدر وثائق الطرح وتسجل ما قدموه. ولا تحرك أي أموال: "
"تبقى الصلاحية حيث وضعتها M3 حتى تتم الترسية."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_audit.py:0
msgid "A sourcing event names a project from another company."
msgstr "مناقصة تشير إلى مشروع تابع لشركة أخرى."

#. module: atmta_procurement_sourcing
#: model:ir.model.constraint,message:atmta_procurement_sourcing.constraint_realestate_procurement_sourcing_event_name_uniq
msgid "A sourcing reference must be unique per company."
msgstr "يجب أن يكون مرجع المناقصة فريدًا لكل شركة."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_audit.py:0
msgid "A tender RFQ is confirmed, which M5 has no award to justify."
msgstr "طلب عرض سعر لمناقصة مؤكد، ولا توجد لدى M5 ترسية تبرره."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_audit.py:0
msgid ""
"A tender allocation has lost its requisition lineage, so M7 cannot recover "
"its cost coding."
msgstr ""
"فقد تخصيص مناقصة ارتباطه بطلب الشراء، لذا لا تستطيع M7 استرجاع ترميز التكلفة"
" الخاص به."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_audit.py:0
msgid "A tender has two versions with the same revision number."
msgstr "توجد لمناقصة نسختان برقم المراجعة نفسه."

#. module: atmta_procurement_sourcing
#: model:ir.model.constraint,message:atmta_procurement_sourcing.constraint_realestate_procurement_sourcing_version_revision_uniq
msgid "A tender revision number is issued once per sourcing event."
msgstr "رقم مراجعة المناقصة يصدر مرة واحدة لكل مناقصة."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_audit.py:0
msgid "A tender sources more than the requisition authorised."
msgstr "مناقصة تطرح أكثر مما اعتمده طلب الشراء."

#. module: atmta_procurement_sourcing
#: model:ir.model.constraint,message:atmta_procurement_sourcing.constraint_realestate_procurement_sourcing_acknowledgement_version_uniq
msgid "A vendor acknowledges a tender version once."
msgstr "يقر المورد باستلام نسخة المناقصة مرة واحدة."

#. module: atmta_procurement_sourcing
#: model:ir.model.constraint,message:atmta_procurement_sourcing.constraint_realestate_procurement_sourcing_invitation_vendor_uniq
msgid "A vendor is invited to a sourcing event once."
msgstr "يدعى المورد إلى المناقصة مرة واحدة."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_clarification.py:0
msgid "A vendor question needs the vendor who asked it."
msgstr "سؤال المورد يحتاج إلى تحديد المورد الذي طرحه."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_clarification.py:0
msgid "A vendor-only answer needs to name the vendor it is for."
msgstr "الإجابة الخاصة بمورد واحد تحتاج إلى تحديد المورد المقصود."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_audit.py:0
msgid "A withdrawn bid is still the vendor's current response."
msgstr "العطاء المسحوب لا يزال هو الرد الحالي للمورد."

#. module: atmta_procurement_sourcing
#: model:ir.model.fields,field_description:atmta_procurement_sourcing.field_realestate_procurement_bid_response__above_authorisation
msgid "Above Authorisation"
msgstr "يتجاوز الاعتماد"

#. module: atmta_procurement_sourcing
#: model:ir.model.fields.selection,name:atmta_procurement_sourcing.selection__realestate_procurement_bid_response__policy_applied__allow_with_warning
msgid "Accept and Flag"
msgstr "قبول مع وضع علامة"

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/bid_response.py:0
msgid "Accepting a late bid is a Procurement Manager's decision."
msgstr "قبول العطاء المتأخر قرار يعود إلى مدير المشتريات."

#. module: atmta_procurement_sourcing
#: model:ir.model.fields.selection,name:atmta_procurement_sourcing.selection__realestate_procurement_sourcing_invitation__state__acknowledged
msgid "Acknowledged"
msgstr "تم الإقرار بالاستلام"

#. module: atmta_procurement_sourcing
#: model:ir.model.fields,field_description:atmta_procurement_sourcing.field_realestate_procurement_sourcing_acknowledgement__acknowledged_on
#: model:ir.model.fields,field_description:atmta_procurement_sourcing.field_realestate_procurement_sourcing_invitation__acknowledged_on
msgid "Acknowledged On"
msgstr "تاريخ الإقرار بالاستلام"

#. module: atmta_procurement_sourcing
#: model:ir.model.fields,field_description:atmta_procurement_sourcing.field_realestate_procurement_sourcing_invitation__acknowledged_version_id
msgid "Acknowledged Version"
msgstr "النسخة المقر باستلامها"

#. module: atmta_procurement_sourcing
#: model:ir.model.fields,field_description:atmta_procurement_sourcing.field_realestate_procurement_sourcing_invitation__acknowledgement_ids
msgid "Acknowledgement"
msgstr "الإقرار بالاستلام"

#. module: atmta_procurement_sourcing
#: model:ir.model.fields,field_description:atmta_procurement_sourcing.field_realestate_procurement_sourcing_invitation__acknowledgement_outstanding
msgid "Acknowledgement Outstanding"
msgstr "الإقرار بالاستلام معلق"

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_invitation.py:0
msgid "Acknowledgement of %(version)s recorded by %(user)s (%(method)s)."
msgstr "سجل %(user)s الإقرار باستلام %(version)s (%(method)s)."

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/bid_response.py:0
msgid ""
"Acknowledgement of %s has not been recorded, and company policy requires it "
"before a response is valid."
msgstr ""
"لم يسجل الإقرار باستلام %s، وسياسة الشركة تشترطه قبل أن يكون الرد صالحًا."

#. module: atmta_procurement_sourcing
#: model:ir.model.fields,field_description:atmta_procurement_sourcing.field_realestate_procurement_bid_response__message_needaction
#: model:ir.model.fields,field_description:atmta_procurement_sourcing.field_realestate_procurement_sourcing_clarification__message_needaction
#: model:ir.model.fields,field_description:atmta_procurement_sourcing.field_realestate_procurement_sourcing_event__message_needaction
#: model:ir.model.fields,field_description:atmta_procurement_sourcing.field_realestate_procurement_sourcing_invitation__message_needaction
msgid "Action Needed"
msgstr "إجراء مطلوب"

#. module: atmta_procurement_sourcing
#: model:ir.model.fields,field_description:atmta_procurement_sourcing.field_realestate_procurement_sourcing_event__activity_ids
msgid "Activities"
msgstr "الأنشطة"

#. module: atmta_procurement_sourcing
#: model:ir.model.fields,field_description:atmta_procurement_sourcing.field_realestate_procurement_sourcing_event__activity_exception_decoration
msgid "Activity Exception Decoration"
msgstr "زخرفة استثناء النشاط"

#. module: atmta_procurement_sourcing
#: model:ir.model.fields,field_description:atmta_procurement_sourcing.field_realestate_procurement_sourcing_event__activity_state
msgid "Activity State"
msgstr "حالة النشاط"

#. module: atmta_procurement_sourcing
#: model:ir.model.fields,field_description:atmta_procurement_sourcing.field_realestate_procurement_sourcing_event__activity_type_icon
msgid "Activity Type Icon"
msgstr "أيقونة نوع النشاط"

#. module: atmta_procurement_sourcing
#: model:ir.model.fields,field_description:atmta_procurement_sourcing.field_realestate_procurement_sourcing_event__actual_closed_datetime
msgid "Actual Closed Datetime"
msgstr "تاريخ ووقت الإغلاق الفعلي"

#. module: atmta_procurement_sourcing
#: model:ir.model.fields,field_description:atmta_procurement_sourcing.field_realestate_procurement_sourcing_event__addendum_ack_policy
msgid "Addendum Acknowledgement"
msgstr "الإقرار بالملحق"

#. module: atmta_procurement_sourcing
#. odoo-python
#: code:addons/atmta_procurement_sourcing/models/sourcing_event.py:0
msgid "Addendum issued as %(version)s: %(reason)s"
msgstr "تم إصدار ملحق باسم %(version)s: %(reason)s"

#. module: atmta_procurement_sourcing
#: model:ir.model.fields,field_description:atmta_procurement_sourcing.field_realestate_procurement_bid_response__administrative_status
msgid "Administrative Status"
msgstr "الحالة الإدارية"

#. module: atmta_procurement_sourcing
#: model:ir.model.fields,help:atmta_procurement_sourcing.field_realestate_procurement_sourcing_event__require_validity_date
msgid "Administrative requirement only."
msgstr "متطلب إداري فقط."

#. module: atmta_procurement_sourcing
#: model:ir.model.fields,help:atmta_procurement_sourcing.field_realestate_procurement_sourcing_event__require_bid_document
msgid ""
"Administrative requirement only. What is *in* the document is M6's business,"
" not this module's."
